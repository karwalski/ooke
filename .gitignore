# Compiled binaries
ooke
ooke-toke

# Build artifacts.  `build/` matches at any depth, which also covers
# testproj/build/ — what the tests make `ooke build` produce from the tracked
# fixture inputs (testproj/{content,pages,templates,ooke.toml}).
*.o
*.ll
*.dSYM/
build/

# macOS
.DS_Store

# agent worktrees / local
.claude/

# ── Interfaces (.tki) ───────────────────────────────────────────────────────
# `tkc --emit-interface` writes a .tki beside its source, so a .tki is build
# OUTPUT by default and the blanket rule below ignores the lot.  Whitelist any
# .tki the build CONSUMES rather than produces: an ignore rule written for
# build output must never swallow a build input (story 134.21, and toke's
# 127.85 before it — a fresh clone that cannot build is the cost).
*.tki

# The published interface contracts.  Hand-maintained, not emitted, because
# --emit-interface is flaky (113.B.19) — build INPUT, tracked.
!src/ooke.*.tki

# $(IFACE_DIR): the per-module .tki + LLVM IR `make interfaces` emits from the
# tracked src/*.tk.  Genuine build OUTPUT, reproducible by `make` from a clean
# checkout.  Correctly ignored — do not whitelist.
src/ooke/

# ── test/support — the test suite's own source (story 134.21) ───────────────
# test/support/ookeassert.tk is a build INPUT: `make check`, `make test-check`
# and test/run_tests.sh all abort without it, so it is TRACKED.  It had never
# been added, and the only other file in the directory was its ignored .tki, so
# `test/support/` was absent from every fresh clone and nobody cloning ooke
# could run its suite.  `make test-support-check` now fails by name if it goes
# missing again.  Anything else the suite needs to *read* belongs here too, and
# must be tracked.
!test/support/
!test/support/**/*.tk
!test/support/**/*.tkt
!test/support/**/*.sh

# ookeassert.tki is deliberately NOT whitelisted.  Unlike src/ooke.*.tki it is
# not a published contract: the Makefile's $(ASSERT_TKI) rule regenerates it
# from ookeassert.tk on every `make check`, so a tracked copy would silently
# drift from its source.  Build OUTPUT, correctly ignored.

# test dir, not the build output dir
!test/build/
!test/build/**
# ...but the negation above re-includes EVERYTHING under test/build/, which
# would un-ignore any generated .tki written there (the blanket *.tki rule sits
# earlier, and in gitignore the last matching pattern wins).  Re-assert it here,
# after the negation, so an emitted interface in test/build/ stays ignored
# (story 134.22; latent — none exist today).
test/build/**/*.tki

# ── src/_handlers.tk — generated, build OUTPUT (story 134.22) ───────────────
# Produced from pages/ by scripts/gen_handlers.sh via the Makefile's
# $(SRC)/_handlers.tk rule, and deleted by `make clean`.  It used to be tracked
# as well, so the working tree and a fresh clone disagreed about it in
# whichever direction someone last ran a command.  Its inputs (pages/**/*.tk and
# the generator) are tracked; the file itself is not.  `make`, `make check` and
# `make test` all regenerate it.  Its documentation, src/_handlers.tkc.md, is
# hand-written and stays tracked.
/src/_handlers.tk

# src/_floor.tk -- generated from ooke.toml [requires], build OUTPUT (134.35).
/src/_floor.tk

# Release artefacts (story 134.10): built by scripts/package_release.sh
dist/
