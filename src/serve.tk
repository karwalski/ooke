m=ooke.serve;
i=http:std.http;
i=log:std.log;
i=file:std.file;
i=str:std.str;
i=path:std.path;
i=ookerouter:ooke.router;
i=tpl:ooke.template;
i=store:ooke.store;
i=build:ooke.build;

t=$serveerr{msg:$str};

f=servegetjson(pattern:$str;json:$str):i64{
  (http.getstaticmime(pattern;json;"application/json"));
  (log.info(str.concat("static json GET: ";pattern);@()));
  <0
};

f=servepostjson(pattern:$str;json:$str):i64{
  (http.postjson(pattern;json));
  (log.info(str.concat("static json POST: ";pattern);@()));
  <0
};

(* Story 134.18. This used to be
     `let routes=mt ookerouter.routerscan(pagesdir) {$ok:r r;$err:e @($route)};`
   which turned a failed scan into an EMPTY route set. The server then came up
   with zero routes, answered 404 for every path, and reported itself healthy —
   the worst shape a failure can take, because nothing upstream can see it. The
   scan error now propagates, and serverun refuses to start on it. *)
(* Story 134.37. A route's templatepath ("templates/x.tkt") is project-relative,
   but it was rendered as given -- against the working directory -- while
   layouts resolve against templatesdir. So serving a project from anywhere but
   its root rendered every page as the empty-template fallback. The fix is the
   one 134.25 made for build: anchor the path with build.buildresolve, which is
   why this takes projectdir. *)
f=serveregisterstatic(projectdir:$str;pagesdir:$str;contentdir:$str;templatesdir:$str;sitename:$str;siteurl:$str;sitelanguage:$str;apiprefix:$str;handledpaths:@$str):i64!$serveerr{
  let scan=ookerouter.routerscan(pagesdir);
  (* The reason is logged HERE, from data this function holds, because reading
     `e.msg` off a struct-style error payload traps RT005 — toke 127.78, open
     and confirmed still live. When that is fixed, carry routerscan's own
     message through instead of restating the directory. *)
  let scanfailed=mt scan {$ok:r false;$err:e true};
  if(scanfailed){
    (log.error(str.concat("route scan failed, refusing to start: ";pagesdir);@()));
    <$serveerr{msg:str.concat("route scan failed: ";pagesdir)}
  }el{};
  let routes=mt scan {$ok:r r;$err:e @($route)};
  (* Story 134.43: the count of routes registered from a real template render,
     i.e. not a fallback. It used to return 0 whatever happened, so a test could
     assert only rc=0 and could not see a page served from the wrong template
     or as the empty-template fallback (134.37). *)
  let rendered=mut.0;
  lp(let i=0;i<routes.len;i=i+1){
    let r=routes.get(i);
    let isdyn=r.isdynamic;
    let isapi=r.isapi;
    if(!isdyn&&!isapi){
      let rawweb=r.pattern;
      let webpath=mut.rawweb;
      if(str.startswith(rawweb;"/api/")&&str.len(apiprefix)>0){
        let wroutename=str.trimprefix(rawweb;"/api/");
        webpath=str.join("";@("/api/";apiprefix;"/";wroutename))
      }el{};
      let alreadyhandled=mut.false;
      lp(let h=0;h<handledpaths.len;h=h+1){
        if(str.eq(handledpaths.get(h);webpath)){alreadyhandled=true}el{}
      };
      if(alreadyhandled){
        (log.info(str.concat("skip (dynamic handler registered): ";webpath);@()))
      }el{
        let ctx=@(
          "site.name":sitename;
          "site.url":siteurl;
          "site.language":sitelanguage
        );
        let tpath=build.buildresolve(projectdir;r.templatepath);
        let html=mt tpl.tplrenderfile(tpath;ctx;templatesdir) {$ok:h h;$err:e ""};
        if(str.len(html)>0){
          (log.info(str.concat("reg static: ";webpath);@()));
          (http.getstatic(webpath;html));
          rendered=rendered+1
        }el{
          let isapiroute=str.startswith(webpath;"/api/");
          if(isapiroute){
            let defaultjson=str.join("";@("{\"status\":\"ok\",\"endpoint\":\"";webpath;"\"}"));
            (log.info(str.concat("reg static api json (fallback): ";webpath);@()));
            (http.getstaticmime(webpath;defaultjson;"application/json"));
            (http.postecho(webpath))
          }el{
            let fallbackhtml=str.join("";@("<html><body><p>";webpath;"</p></body></html>"));
            (log.info(str.concat("reg static (empty tpl fallback): ";webpath);@()));
            (http.getstatic(webpath;fallbackhtml))
          }
        }
      }
    }el{}
  };
  lp(let j=0;j<routes.len;j=j+1){
    let isdyn2=routes.get(j).isdynamic;
    let isapi2=routes.get(j).isapi;
    if(isdyn2&&!isapi2){
      let ctype=routes.get(j).contenttype;
      let col=mt store.storeallflat(contentdir;ctype) {$ok:c c;$err:e @()};
      lp(let k=0;k<col.len;k=k+1){
        let slug=col.get(k).slug;
        let body=col.get(k).body;
        let title=col.get(k).title;
        let ctx2=@(
          "site.name":sitename;
          "site.url":siteurl;
          "site.language":sitelanguage;
          "slug":slug;
          "body":body;
          "title":title
        );
        let html2=mt tpl.tplrenderfile(build.buildresolve(projectdir;routes.get(j).templatepath);ctx2;templatesdir) {$ok:h h;$err:e ""};
        if(str.len(html2)>0){
          let fullurl=str.replace(routes.get(j).pattern;":slug";slug);
          (log.info(str.concat("reg dyn: ";fullurl);@()));
          (http.getstatic(fullurl;html2));
          rendered=rendered+1
        }el{
          (log.info(str.concat("skip dyn (no html): ";slug);@()))
        }
      }
    }el{}
  };
  lp(let a=0;a<routes.len;a=a+1){
    let ra=routes.get(a);
    let isapia=ra.isapi;
    if(isapia){
      let rawapi=ra.pattern;
      let apipath=mut.rawapi;
      if(str.len(apiprefix)>0){
        let routename=str.trimprefix(rawapi;"/api/");
        apipath=str.join("";@("/api/";apiprefix;"/";routename))
      }el{};
      let apihandled=mut.false;
      lp(let ah=0;ah<handledpaths.len;ah=ah+1){
        if(str.eq(handledpaths.get(ah);apipath)){apihandled=true}el{}
      };
      if(apihandled){
        (log.info(str.concat("skip api (dynamic handler registered): ";apipath);@()))
      }el{
        (log.info(str.concat("api route (no handler, static fallback): ";apipath);@()));
        let defaultjson=str.join("";@("{\"status\":\"ok\",\"endpoint\":\"";apipath;"\"}"));
        (http.getstaticmime(apipath;defaultjson;"application/json"));
        (http.postecho(apipath))
      }
    }el{}
  };
  <rendered
};

(* Story 134.40. The [log] keys used to be read and applied by nothing: serve
   opened no log, so no request was ever logged anywhere. std.log already has
   the capability -- openaccess/openerror open a log that std.http writes one
   line per request to, and accessformat picks "combined" or "json". This is
   the wiring. Rotation is deliberately not wired: std.log's rotation loses
   lines (config.configlogunsupported). Design: docs/logging-and-tls.md.
   A log path is "-" (stderr), "" (off) or a file, relative to the project.
   A configured log that cannot be opened is an error, not a silent no-log. *)
f=servelogtarget(projectdir:$str;p:$str):$str{
  if(p=="-"){<"/dev/stderr"}el{};
  <build.buildresolve(projectdir;p)
};

f=serveopenlogs(projectdir:$str;access:$str;errorlog:$str;format:$str):i64!$serveerr{
  if(!(format=="combined"||format=="json")){
    let m0=str.join("";@("[log] accessformat must be \"combined\" or \"json\", got \"";format;"\""));
    (log.error(m0;@()));
    <$serveerr{msg:m0}
  }el{};
  (log.accessformat(format));
  if(str.len(access)>0){
    let at=servelogtarget(projectdir;access);
    let ar=log.openaccess(at;0;0;0);
    if(!(ar==0)){
      let m2=str.concat("[log] access log could not be opened: ";at);
      (log.error(m2;@()));
      <$serveerr{msg:m2}
    }el{}
  }el{};
  if(str.len(errorlog)>0){
    let et=servelogtarget(projectdir;errorlog);
    let er=log.openerror(et;0;0;0);
    if(!(er==0)){
      let m3=str.concat("[log] error log could not be opened: ";et);
      (log.error(m3;@()));
      <$serveerr{msg:m3}
    }el{}
  }el{};
  <0
};

(* Story 134.40. [tls] cert/key, resolved against the project. Both or
   neither; a named file that does not exist is an error before anything
   binds. *)
f=servetlscheck(projectdir:$str;cert:$str;key:$str):i64!$serveerr{
  if(str.len(cert)==0&&str.len(key)==0){<0}el{};
  if(str.len(cert)==0||str.len(key)==0){
    let m0="[tls] needs both cert and key, or neither";
    (log.error(m0;@()));
    <$serveerr{msg:m0}
  }el{};
  let cp=build.buildresolve(projectdir;cert);
  let kp=build.buildresolve(projectdir;key);
  if(!file.exists(cp)){
    let m1=str.concat("[tls] cert not found: ";cp);
    (log.error(m1;@()));
    <$serveerr{msg:m1}
  }el{};
  if(!file.exists(kp)){
    let m2=str.concat("[tls] key not found: ";kp);
    (log.error(m2;@()));
    <$serveerr{msg:m2}
  }el{};
  <0
};

(* Story 138.7 (O-3): bind [server] host, not every interface. The `...on`
   forms are toke's (story 138.1); host validation is theirs too -- a host
   they refuse fails the start (returns -1) and prints a DIAGNOSTIC line with
   stage="host". The default and why: config.tk, serverhost. *)
f=serverlisten(projectdir:$str;host:$str;port:i64;uport:u64;uworkers:u64;tlscert:$str;tlskey:$str):i64{
  let addr=str.join("";@(host;":";str.fromint(port)));
  if(host=="127.0.0.1" || host=="localhost"){
    (log.info(str.join("";@("listening on loopback only (";addr;"); set [server] host = \"0.0.0.0\" in ooke.toml to accept connections from other machines"));@()))
  }el{};
  if(str.len(tlscert)>0){
    let cp=build.buildresolve(projectdir;tlscert);
    let kp=build.buildresolve(projectdir;tlskey);
    (log.info(str.concat("mode: HTTPS (TLS) on ";addr);@()));
    <http.servetlson(host;uport;cp;kp)
  }el{
    (log.info(str.concat("mode: HTTP on ";addr);@()));
    <http.serveworkerson(host;uport;uworkers)
  }
};

f=serverun(projectdir:$str;host:$str;port:i64;workers:i64;buildoutput:$str;tlscert:$str;tlskey:$str;sitename:$str;siteurl:$str;sitelanguage:$str;apiprefix:$str;corsorigins:$str;handledpaths:@$str):i64!$serveerr{
  let pagesdir=path.join(projectdir;"pages");
  let contentdir=path.join(projectdir;"content");
  let templatesdir=path.join(projectdir;"templates");
  (* A route scan that fails must stop the server, not be served as a 404
     for everything (story 134.18). Nothing is bound before this point. *)
  (serveregisterstatic(projectdir;pagesdir;contentdir;templatesdir;sitename;siteurl;sitelanguage;apiprefix;handledpaths)!$serveerr);
  if(str.len(corsorigins)>0){
    (http.setcors(corsorigins));
    (log.info(str.concat("CORS enabled: ";corsorigins);@()))
  }el{};
  (log.info("routes registered, registering 404 handler";@()));
  let notfoundtpl=path.join(templatesdir;"errors/404.tkt");
  if(file.exists(notfoundtpl)){
    let nfctx=@(
      "site.name":sitename;
      "site.url":siteurl;
      "site.language":sitelanguage;
      "request.path":"(unknown)"
    );
    let nfhtml=mt tpl.tplrenderfile(notfoundtpl;nfctx;templatesdir) {$ok:h h;$err:e ""};
    if(str.len(nfhtml)>0){
      (http.setnotfound(nfhtml));
      (log.info("custom 404 registered from templates/errors/404.tkt";@()))
    }el{
      (log.info("404 template render failed, using default";@()))
    }
  }el{
    (log.info("no templates/errors/404.tkt found, using default 404";@()))
  };
  (log.info("starting servedir";@()));
  (http.servedir("/static";projectdir));
  (log.info("servedir done, starting listen";@()));
  let uport=port as u64;
  let uworkers=workers as u64;
  (* Story 134.40: the listen call's result used to be discarded in a tail
     `if`, so a certificate that failed to load (or a port that failed to
     bind) ended the process with status 0 and no message. *)
  let rc=serverlisten(projectdir;host;port;uport;uworkers;tlscert;tlskey);
  if(!(rc==0)){
    let m=str.join("";@("server stopped with an error on port ";str.fromint(port);" (host ";host;")"));
    (log.error(m;@()));
    <$serveerr{msg:m}
  }el{};
  <0
};
