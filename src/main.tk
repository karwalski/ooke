m=ooke.main;
i=args:std.args;
i=str:std.str;
i=log:std.log;
i=process:std.process;
i=cli:ooke.cli;
i=repair:ooke.repair;
i=run:ooke.run;

f=main():i64{
  let count=args.count() as i64;
  if(count=1){
    (cli.cliprintusage());
    <0
  }el{
    let firstraw=mt args.get(1 as u64) {$ok:v v;$err:e ""};
    if(str.eq(firstraw;"--help")){
      (cli.cliprintusage());
      <0
    }el{
      if(str.eq(firstraw;"--version")){
        (cli.cliprintversion());
        <0
      }el{
        let cmd=firstraw;
        if(str.eq(cmd;"new")){
          if(count<3){
            (log.info("usage: ooke new <name>";@()));
            <1
          }el{
            let nameraw=mt args.get(2 as u64) {$ok:v v;$err:e ""};
            <cli.clinew(nameraw)
          }
        }el{
          if(str.eq(cmd;"serve")){
            <cli.runserve(".")
          }el{
            if(str.eq(cmd;"build")){
              let buildarg=mt args.get(2 as u64) {$ok:v v;$err:e ""};
              if(str.eq(buildarg;"--cli")){
                let clipath=mt args.get(3 as u64) {$ok:v v;$err:e "."};
                <run.build(clipath)
              }el{
                <cli.runbuild(".")
              }
            }el{
              if(str.eq(cmd;"run")){
                let runpath=mt args.get(2 as u64) {$ok:v v;$err:e "."};
                let passargs=mut.@($str);
                lp(let ri=3;ri<count;ri=ri+1){
                  let ra=mt args.get(ri as u64) {$ok:v v;$err:e ""};
                  passargs=passargs.append(ra)
                };
                <run.run(runpath;passargs)
              }el{
              if(str.eq(cmd;"compile")){
                let compilepath=mt args.get(2 as u64) {$ok:v v;$err:e "."};
                (log.info(str.concat("generating app build for ";compilepath);@()));
                let genh=mt process.spawn(@("sh";"scripts/gen_app_makefile.sh";compilepath)) {$ok:v v;$err:e 0};
                if(genh=0){
                  (log.info("failed to run gen_app_makefile.sh";@()));
                  <1
                }el{};
                let genexit=mt process.wait(genh) {$ok:v v;$err:e 1};
                if(!(genexit=0)){
                  (log.info("Makefile generation failed";@()));
                  <1
                }el{};
                (log.info("building with make -f Makefile.serve";@()));
                let makeh=mt process.spawn(@("make";"-f";"Makefile.serve";"-C";compilepath)) {$ok:v v;$err:e 0};
                if(makeh=0){
                  (log.info("failed to run make";@()));
                  <1
                }el{};
                let makeexit=mt process.wait(makeh) {$ok:v v;$err:e 1};
                let makeout=mt process.stdout(makeh) {$ok:v v;$err:e ""};
                let makeerr=mt process.stderr(makeh) {$ok:v v;$err:e ""};
                if(str.len(makeout)>0){(log.info(makeout;@()))}el{};
                if(str.len(makeerr)>0){(log.info(makeerr;@()))}el{};
                if(!(makeexit=0)){
                  (log.info("compilation failed";@()));
                  <1
                }el{};
                (log.info("compile complete";@()));
                <0
              }el{
              if(str.eq(cmd;"gen")){
                if(count<4){
                  (log.info("usage: ooke gen <type> <name>";@()));
                  (log.info("       ooke gen spec <container> <type>";@()));
                  <1
                }el{
                  let gentyperaw=mt args.get(2 as u64) {$ok:v v;$err:e ""};
                  if(str.eq(gentyperaw;"spec")){
                    if(count<5){
                      (log.info("usage: ooke gen spec <container> <type>";@()));
                      (log.info("  containers: stack, queue, set";@()));
                      <1
                    }el{
                      let containerraw=mt args.get(3 as u64) {$ok:v v;$err:e ""};
                      let typenameraw=mt args.get(4 as u64) {$ok:v v;$err:e ""};
                      <cli.cligenspec(containerraw;typenameraw)
                    }
                  }el{
                    let gennameraw=mt args.get(3 as u64) {$ok:v v;$err:e ""};
                    <cli.cligen(gentyperaw;gennameraw)
                  }
                }
              }el{
                if(str.eq(cmd;"repair")){
                  if(count<3){
                    (log.info("usage: ooke repair <file>";@()));
                    <1
                  }el{
                    let repairpath=mt args.get(2 as u64) {$ok:v v;$err:e ""};
                    <repair.repairfile(repairpath;10)
                  }
                }el{
                  (log.info(str.concat("unknown command: ";cmd);@()));
                  (cli.cliprintusage());
                  <1
                }
              }
            }
          }
          }
          }
        }
      }
    }
  }
};
