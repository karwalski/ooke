m=ooke.main;
i=args:std.args;
i=str:std.str;
i=log:std.log;
i=process:std.process;
i=env:std.env;
i=file:std.file;
i=path:std.path;
i=cli:ooke.cli;
i=repair:ooke.repair;
i=run:ooke.run;

(* Story 134.45. `ooke compile` ran scripts/gen_app_makefile.sh relative to
   the current directory, so it worked only when run from the ooke checkout.
   The script is part of the ooke installation, so find it from there:
   $OOKE_ROOT if set, else the directory of the ooke binary itself (argv[0],
   searched on $PATH when it holds no slash). A symlinked binary is not
   followed -- set OOKE_ROOT for that layout. Returns "" if none is found. *)
f=bindir(argv0:$str):$str{
  if(str.contains(argv0;"/")){<path.dir(argv0)}el{};
  let dirs=str.split(env.getor("PATH";"");":");
  lp(let i=0;i<dirs.len;i=i+1){
    let d=dirs.get(i);
    if(str.len(d)>0){
      if(file.exists(path.join(d;argv0))){<d}el{}
    }el{}
  };
  <""
};

f=genscript():$str{
  let rel="scripts/gen_app_makefile.sh";
  let root=env.getor("OOKE_ROOT";"");
  if(str.len(root)>0){<path.join(root;rel)}el{};
  let argv0=mt args.get(0 as u64) {$ok:v v;$err:e ""};
  let dir=bindir(argv0);
  if(str.len(dir)>0){
    let cand=path.join(dir;rel);
    if(file.exists(cand)){<cand}el{}
  }el{};
  <""
};

f=main():i64{
  let count=args.count() as i64;
  if(count==1){
    (cli.cliprintusage());
    <0
  }el{
    let firstraw=mt args.get(1 as u64) {$ok:v v;$err:e ""};
    if(str.eq(firstraw;"--help")){
      (cli.cliprintusage());
      <0
    }el{
      if(str.eq(firstraw;"--version")){
        (cli.cliprintversion());
        <0
      }el{
        let cmd=firstraw;
        (* Story 134.19. A help request is answered before any command runs.
           `ooke serve --help` used to reach runserve and bind a port. *)
        let secondraw=mt args.get(2 as u64) {$ok:v v;$err:e ""};
        if(cli.cliishelp(secondraw)){
          <cli.cliprintcmdusage(cmd)
        }el{};
        if(str.eq(cmd;"new")){
          if(count<3){
            (log.info("usage: ooke new <name>";@()));
            <1
          }el{
            let nameraw=mt args.get(2 as u64) {$ok:v v;$err:e ""};
            <cli.clinew(nameraw)
          }
        }el{
          if(str.eq(cmd;"serve")){
            (* 134.37: `ooke serve <path>` serves the project at <path>, as
               `ooke build <path>` builds it (134.25). It took no argument. *)
            let servearg=mt args.get(2 as u64) {$ok:v v;$err:e ""};
            if(str.len(servearg)>0){
              <cli.runserve(servearg)
            }el{
              <cli.runserve(".")
            }
          }el{
            if(str.eq(cmd;"build")){
              let buildarg=mt args.get(2 as u64) {$ok:v v;$err:e ""};
              if(str.eq(buildarg;"--cli")){
                let clipath=mt args.get(3 as u64) {$ok:v v;$err:e "."};
                <run.build(clipath)
              }el{
                (* 134.25: `ooke build <path>` builds the project at <path>.
                   The argument used to be read and then ignored, so it
                   silently built the current directory instead. *)
                if(str.len(buildarg)>0){
                  <cli.runbuild(buildarg)
                }el{
                  <cli.runbuild(".")
                }
              }
            }el{
              if(str.eq(cmd;"run")){
                let runpath=mt args.get(2 as u64) {$ok:v v;$err:e "."};
                let passargs=mut.@($str);
                lp(let ri=3;ri<count;ri=ri+1){
                  let ra=mt args.get(ri as u64) {$ok:v v;$err:e ""};
                  passargs=passargs.append(ra)
                };
                <run.run(runpath;passargs)
              }el{
              if(str.eq(cmd;"compile")){
                let compilepath=mt args.get(2 as u64) {$ok:v v;$err:e "."};
                (log.info(str.concat("generating app build for ";compilepath);@()));
                let gen=genscript();
                if(str.len(gen)==0){
                  (log.error("cannot find scripts/gen_app_makefile.sh beside the ooke binary; set OOKE_ROOT to the ooke checkout";@()));
                  <1
                }el{};
                let genh=mt process.spawn(@("sh";gen;compilepath)) {$ok:v v;$err:e 0};
                if(genh==0){
                  (log.info("failed to run gen_app_makefile.sh";@()));
                  <1
                }el{};
                (* Story 134.44. process.wait returns a plain i32, not a
                   result; matching it with $ok/$err arms compiled and always
                   took the $err arm, so this reported "Makefile generation
                   failed" for every project, and the same for make. *)
                let genexit=process.wait(genh);
                if(!(genexit==0)){
                  let generr=mt process.stderr(genh) {$ok:v v;$err:e ""};
                  if(str.len(generr)>0){(log.error(generr;@()))}el{};
                  (log.error(str.concat("Makefile generation failed: ";gen);@()));
                  <1
                }el{};
                (log.info("building with make -f Makefile.serve";@()));
                let makeh=mt process.spawn(@("make";"-f";"Makefile.serve";"-C";compilepath)) {$ok:v v;$err:e 0};
                if(makeh==0){
                  (log.info("failed to run make";@()));
                  <1
                }el{};
                let makeexit=process.wait(makeh);
                let makeout=mt process.stdout(makeh) {$ok:v v;$err:e ""};
                let makeerr=mt process.stderr(makeh) {$ok:v v;$err:e ""};
                if(str.len(makeout)>0){(log.info(makeout;@()))}el{};
                if(str.len(makeerr)>0){(log.info(makeerr;@()))}el{};
                if(!(makeexit==0)){
                  (log.error("compilation failed";@()));
                  <1
                }el{};
                (log.info("compile complete";@()));
                <0
              }el{
              if(str.eq(cmd;"gen")){
                if(count<4){
                  (log.info("usage: ooke gen <type> <name>";@()));
                  (log.info("       ooke gen spec <container> <type>";@()));
                  <1
                }el{
                  let gentyperaw=mt args.get(2 as u64) {$ok:v v;$err:e ""};
                  if(str.eq(gentyperaw;"spec")){
                    if(count<5){
                      (log.info("usage: ooke gen spec <container> <type>";@()));
                      (log.info("  containers: stack, queue, set";@()));
                      <1
                    }el{
                      let containerraw=mt args.get(3 as u64) {$ok:v v;$err:e ""};
                      let typenameraw=mt args.get(4 as u64) {$ok:v v;$err:e ""};
                      <cli.cligenspec(containerraw;typenameraw)
                    }
                  }el{
                    let gennameraw=mt args.get(3 as u64) {$ok:v v;$err:e ""};
                    <cli.cligen(gentyperaw;gennameraw)
                  }
                }
              }el{
                if(str.eq(cmd;"repair")){
                  if(count<3){
                    (log.info("usage: ooke repair <file>";@()));
                    <1
                  }el{
                    let repairpath=mt args.get(2 as u64) {$ok:v v;$err:e ""};
                    (* 121.66 (g): the diagnostic count is not an exit
                       status -- 256 of them exited 0. Not clean is 1. *)
                    let ndiag=repair.repairfile(repairpath;10);
                    if(ndiag>0){<1}el{};
                    <0
                  }
                }el{
                  (log.info(str.concat("unknown command: ";cmd);@()));
                  (cli.cliprintusage());
                  <1
                }
              }
            }
          }
          }
          }
        }
      }
    }
  }
};
