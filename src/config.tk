m=ooke.config;
i=toml:std.toml;
i=file:std.file;

t=$ookecfg{
  sitename:$str;
  siteurl:$str;
  sitelanguage:$str;
  buildoutput:$str;
  buildminify:bool;
  buildinlinecss:bool;
  serverport:i64;
  serverhost:$str;
  serverworkers:i64;
  servercorsorigins:$str;
  logaccess:$str;
  logerror:$str;
  logaccessformat:$str;
  tlscert:$str;
  tlskey:$str;
  apiprefix:$str
};
(* 16 fields (serverhost made it 16, story 138.7). Keep it at 16 or fewer: toke's code generator drops every struct
   field past the 16th (TKC_MAX_PARAMS in toke's src/llvm.c StructInfo) --
   `tkc --check` passes and the build fails with E4025 "no field". Measured with
   a 17-field struct during story 134.40. *)

t=$configerr{msg:$str};

(* Story 121.67 (4): a table that is absent is empty. Every section read here
   fell back to the ROOT table, so without [log] a top-level `maxlines = 5`
   was reported as a [log] rotation key, and without [site], [server], [build]
   or [tls] a top-level `name`, `port`, `output` or `cert` configured them. A
   key belongs to the table it is written in. *)
f=configsection(tab:$tomlval;name:$str):$tomlval{
  let empty=mt toml.load("") {$ok:v v;$err:e tab};
  <mt toml.section(tab;name) {$ok:v v;$err:e empty}
};

f=configload(path:$str):$ookecfg!$configerr{
  let src=file.read(path)!$configerr;
  let tab=toml.load(src)!$configerr;

  let site=configsection(tab;"site");
  let build=configsection(tab;"build");
  let server=configsection(tab;"server");
  let log=configsection(tab;"log");
  let paths=configsection(tab;"paths");
  let tls=configsection(tab;"tls");

  let sitename=mt toml.str(site;"name") {$ok:v v;$err:e "my-site"};
  let siteurl=mt toml.str(site;"url") {$ok:v v;$err:e ""};
  let sitelanguage=mt toml.str(site;"language") {$ok:v v;$err:e "en"};

  let buildoutput=mt toml.str(build;"output") {$ok:v v;$err:e "build/"};
  let buildminify=mt toml.bool(build;"minify") {$ok:v v;$err:e true};
  let buildinlinecss=mt toml.bool(build;"inlinecss") {$ok:v v;$err:e true};

  let serverport=mt toml.i64(server;"port") {$ok:v v;$err:e 3000};
  (* Story 138.7 (loke handoff O-3): the address `ooke serve` binds. Absent,
     it is 127.0.0.1 -- loopback only. That is ooke's decision, and it differs
     from toke's port-only serve functions, which keep every interface so that
     deployed toke servers do not drop off the network. `ooke serve` is first
     a development and local-first server (loke runs it on the user's own
     machine), and the two failures are not symmetric: a loopback server that
     should have been public is noticed on the first request from elsewhere,
     and its start line says how to open it; a public server that should have
     been private is noticed by nobody. A deployment sets `host = "0.0.0.0"`.
     toke validates the value when it binds: an IPv4 literal, "localhost",
     or "", "*" or "0.0.0.0" for all interfaces; anything else fails the
     start, naming the host. docs/logging-and-tls.md, "Bind address". *)
  let serverhost=mt toml.str(server;"host") {$ok:v v;$err:e "127.0.0.1"};
  let serverworkers=mt toml.i64(server;"workers") {$ok:v v;$err:e 0};
  let servercorsorigins=mt toml.str(server;"corsorigins") {$ok:v v;$err:e ""};

  (* Story 134.34. `[store].backend` used to be read here into `storebackend`,
     documented as "flat" or "sqlite", and then read by nothing: build.tk and
     serve.tk both hardcoded "flat". There is no SQLite content backend to
     select -- nothing opens a database, creates its tables or migrates flat
     files into it -- so the key is gone rather than wired. ooke's content
     store is the flat-file one. An old ooke.toml that still carries a
     `[store]` table loads unchanged; the table is ignored. *)

  (* Story 134.40. [log] is applied by `ooke serve` (serve.serveopenlogs);
     docs/logging-and-tls.md is the design. `access` and `error` each take a
     file path (relative to the project), "-" for stderr, or "" for off.
     `maxlines` and `maxagedays` are no longer read: std.log's rotation loses
     lines (see configlogunsupported below). *)
  let logaccess=mt toml.str(log;"access") {$ok:v v;$err:e "-"};
  let logerror=mt toml.str(log;"error") {$ok:v v;$err:e ""};
  let logaccessformat=mt toml.str(log;"accessformat") {$ok:v v;$err:e "combined"};

  (* Story 134.40. [tls] cert/key: both or neither (serve.servetlscheck); when
     set, `ooke serve` speaks HTTPS. Absent, both are "" and serve is HTTP. *)
  let tlscert=mt toml.str(tls;"cert") {$ok:v v;$err:e ""};
  let tlskey=mt toml.str(tls;"key") {$ok:v v;$err:e ""};

  let apiprefix=mt toml.str(paths;"apiprefix") {$ok:v v;$err:e ""};

  <$ookecfg{
    sitename:sitename;
    siteurl:siteurl;
    sitelanguage:sitelanguage;
    buildoutput:buildoutput;
    buildminify:buildminify;
    buildinlinecss:buildinlinecss;
    serverport:serverport;
    serverhost:serverhost;
    serverworkers:serverworkers;
    servercorsorigins:servercorsorigins;
    logaccess:logaccess;
    logerror:logerror;
    logaccessformat:logaccessformat;
    tlscert:tlscert;
    tlskey:tlskey;
    apiprefix:apiprefix
  }
};

(* Story 134.40. `[log] maxlines` and `[log] maxagedays` configured rotation
   that ooke never applied. std.log does rotate (log.openaccess takes both),
   but measured against this build it loses the log: with maxlines = 5 and 40
   requests, 4 pre-fork workers kept 4 of 40 lines, and one worker kept 15 of
   40 when two rotations fell in the same second (the rotated name has
   one-second resolution, so the second overwrites the first). So the keys are
   not wired; serve names any that are still set, and ignores them, the way
   an old [store] table is ignored (134.34). Returns the keys found, or "". *)
f=configlogunsupported(path:$str):$str!$configerr{
  let src=file.read(path)!$configerr;
  let tab=toml.load(src)!$configerr;
  let log=configsection(tab;"log");
  (* Story 121.66 (m): a key is "set" whatever its type. Only an integer was
     looked for, so `maxlines = "5"` -- rotation still asked for -- was
     ignored without the warning. std.toml has no key-presence test and no
     float accessor, so a float or array value is still not seen. *)
  let mli=mt toml.i64(log;"maxlines") {$ok:v true;$err:e false};
  let mls=mt toml.str(log;"maxlines") {$ok:v true;$err:e false};
  let mlb=mt toml.bool(log;"maxlines") {$ok:v true;$err:e false};
  let mai=mt toml.i64(log;"maxagedays") {$ok:v true;$err:e false};
  let mas=mt toml.str(log;"maxagedays") {$ok:v true;$err:e false};
  let mab=mt toml.bool(log;"maxagedays") {$ok:v true;$err:e false};
  let hasml=mli||mls||mlb;
  let hasma=mai||mas||mab;
  if(hasml&&hasma){<"maxlines, maxagedays"}el{};
  if(hasml){<"maxlines"}el{};
  if(hasma){<"maxagedays"}el{};
  <""
};

(* Story 121.25 (audit OOK-03). README and the example ooke.toml carried
   `[server] admin` -- "enable admin routes" -- and nothing read it: ooke has
   no admin interface, and no authentication, sessions, CSRF protection or
   rate limiting to put one behind. An operator who set it got nothing and
   was told nothing. It is now read, so that serve can refuse `admin = true`
   and name `admin = false` as ignored. Returns "" when the key is absent,
   "false" for false, and "true" for true or any other value (a string
   "false" is not false: the refusal is the safe reading of what was
   meant). *)
f=configadmin(path:$str):$str!$configerr{
  let src=file.read(path)!$configerr;
  let tab=toml.load(src)!$configerr;
  let server=configsection(tab;"server");
  let hasserver=mt toml.section(tab;"server") {$ok:v true;$err:e false};
  if(!hasserver){<""}el{};
  let b=mt toml.bool(server;"admin") {$ok:v (if(v){"true"}el{"false"});$err:e ""};
  if(!(b=="")){<b}el{};
  let isstr=mt toml.str(server;"admin") {$ok:v true;$err:e false};
  let isint=mt toml.i64(server;"admin") {$ok:v true;$err:e false};
  if(isstr||isint){<"true"}el{};
  <""
};
