m=ooke.cli;
i=str:std.str;
i=file:std.file;
i=log:std.log;
i=io:std.io;
i=path:std.path;
i=config:ooke.config;
i=serve:ooke.serve;
i=floor:ooke.floor;
i=build:ooke.build;
i=handlers:ooke.handlers;

f=cliprintusage():i64{
  (log.info("ooke - toke CMS and web framework";@()));
  (log.info("";@()));
  (log.info("Usage:";@()));
  (log.info("  ooke new <name>       scaffold a new project";@()));
  (log.info("  ooke serve [path]     start development server";@()));
  (log.info("  ooke build [path]     build static HTML (default: current directory)";@()));
  (log.info("  ooke gen <type> <name>  scaffold component";@()));
  (log.info("  ooke gen spec <container> <type>  generate type-specialised code";@()));
  (log.info("  ooke repair <file>    run diagnostic repair";@()));
  (log.info("  ooke compile [path]   compile per-app serve binary with handlers";@()));
  (log.info("  ooke run [path]       compile and run CLI package";@()));
  (log.info("  ooke build --cli [path]  compile CLI binary only";@()));
  (log.info("";@()));
  (log.info("Options:";@()));
  (log.info("  --help       show this help";@()));
  (log.info("  --version    print version";@()));
  <0
};

(* Story 134.19. `ooke serve --help` used to fall through to runserve and bind
   a port: asking a command for help started a server. cliishelp answers "is
   this argument a request for help", and cliprintcmdusage prints the help for
   one command, so main.tk can answer a help request before it dispatches. *)
f=cliishelp(arg:$str):bool{
  <str.eq(arg;"--help")||str.eq(arg;"-h")||str.eq(arg;"help")
};

f=cliprintcmdusage(cmd:$str):i64{
  if(str.eq(cmd;"serve")){
    (log.info("ooke serve — start the development server";@()));
    (log.info("";@()));
    (log.info("Usage: ooke serve [path]";@()));
    (log.info("";@()));
    (log.info("Serves the project at [path] (default: the current directory).";@()));
    (log.info("Templates resolve against the project, not where you run the";@()));
    (log.info("command. Port, workers, CORS origins and the API prefix all";@()));
    (log.info("come from the project's ooke.toml.";@()));
    <0
  }el{};
  if(str.eq(cmd;"build")){
    (log.info("ooke build — build the static site into [build].output";@()));
    (log.info("";@()));
    (log.info("Usage: ooke build [path]";@()));
    (log.info("       Builds the project at [path] (default: the current";@()));
    (log.info("       directory). Templates and [build].output resolve";@()));
    (log.info("       against the project, not where you run the command.";@()));
    (log.info("       ooke build --cli [path]   compile the CLI binary only";@()));
    <0
  }el{};
  if(str.eq(cmd;"new")){
    (log.info("ooke new — scaffold a new project";@()));
    (log.info("";@()));
    (log.info("Usage: ooke new <name>";@()));
    <0
  }el{};
  if(str.eq(cmd;"gen")){
    (log.info("ooke gen — scaffold a component";@()));
    (log.info("";@()));
    (log.info("Usage: ooke gen <type> <name>";@()));
    (log.info("       ooke gen spec <container> <type>";@()));
    (log.info("  types:      page, type";@()));
    (log.info("  containers: stack, queue, set";@()));
    <0
  }el{};
  if(str.eq(cmd;"repair")){
    (log.info("ooke repair — run diagnostic repair over a file";@()));
    (log.info("";@()));
    (log.info("Usage: ooke repair <file>";@()));
    <0
  }el{};
  if(str.eq(cmd;"run")){
    (log.info("ooke run — compile and run the CLI package";@()));
    (log.info("";@()));
    (log.info("Usage: ooke run [path] [args...]";@()));
    <0
  }el{};
  if(str.eq(cmd;"compile")){
    (log.info("ooke compile — compile a per-app serve binary with handlers";@()));
    (log.info("";@()));
    (log.info("Usage: ooke compile [path]";@()));
    <0
  }el{};
  <cliprintusage()
};

(* Story 134.43. public-api.md section 1.1: `--version` prints
   `ooke <VERSION>`. It went through log.info, i.e. a JSON record on stderr. *)
f=cliprintversion():i64{
  (io.println("ooke 3.0.0-rc.1"));
  <0
};

f=clinew(name:$str):i64{
  (mt file.mkdir(name) {$ok:v v;$err:e false});
  (mt file.mkdir(path.join(name;"pages")) {$ok:v v;$err:e false});
  (mt file.mkdir(path.join(name;"templates")) {$ok:v v;$err:e false});
  (mt file.mkdir(path.join(name;"content")) {$ok:v v;$err:e false});
  (mt file.mkdir(path.join(name;"static")) {$ok:v v;$err:e false});
  (* 134.35: the [requires] block is generated from ooke.toml (src/_floor.tk),
     not restated here. It had drifted to a floor ooke no longer builds on. *)
  let tomlcontent=str.join("";@("[site]\nname = \"";name;"\"\nurl = \"\"\nlanguage = \"en\"\n\n[build]\noutput = \"build/\"\nminify = true\ninlinecss = true\n\n[server]\nport = 3000\nworkers = 0\n\n[paths]\napiprefix = \"\"\n\n[log]\naccess = \"-\"\naccessformat = \"combined\"\n\n";floor.floortoml()));
  (mt file.write(path.join(name;"ooke.toml");tomlcontent) {$ok:v v;$err:e false});
  let indexcontent="m=pages.index;\n";
  (mt file.write(path.join(path.join(name;"pages");"index.tk");indexcontent) {$ok:v v;$err:e false});
  (* Story 134.24. The scaffold wrote ONE template, templates/base.tkt, and the
     route it also scaffolds — pages/index.tk, i.e. "/" — derives
     templates/index.tkt. `ooke new` therefore produced a project that could not
     be built, which is the first thing a downstream consumer does with it. That
     one file was not a layout either: it used {{title}} and {{content}}, which
     are not ooke template syntax at all ({= expr =}, {! directive !},
     {# comment #}), so both would have been served to the browser verbatim.

     There are now two, in ooke's own convention and matching testproj: base.tkt
     is the shell and yields, index.tkt declares the layout and fills the blocks.
     The Coin Gold identity is unchanged — only the seam between shell and page
     is new. Re-theme by editing either file. *)
  let basecontent="<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>{! yield(\"title\") !}</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700;800&display=swap\">\n<style>\n:root{--bg:#14110B;--surface:#1F1A11;--line:#2A2317;--text:#F5EFE2;--muted:#9A9082;--gold:#F0C04A;--on-gold:#14110B}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:var(--bg);color:var(--text);font-family:\"Space Grotesk\",system-ui,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}\n.wrap{max-width:640px;margin:0 auto;padding:80px 24px}\n.lockup{display:flex;align-items:center;gap:14px;margin-bottom:36px}\n.coin{width:40px;height:40px;border-radius:50%;background:radial-gradient(circle at 34% 32%,#F6D277 0%,#F0C04A 48%,#C68A1A 100%);box-shadow:0 0 18px rgba(240,192,74,.45)}\n.wordmark{font-family:\"JetBrains Mono\",monospace;font-weight:800;font-size:38px;letter-spacing:-2px}\nh1{font-size:30px;font-weight:700;letter-spacing:-1px;margin-bottom:12px}\np{color:var(--muted);margin-bottom:16px}\n.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:24px;margin:28px 0}\n.eyebrow{font-family:\"JetBrains Mono\",monospace;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:8px}\n.btn{display:inline-block;background:var(--gold);color:var(--on-gold);font-weight:600;text-decoration:none;padding:11px 20px;border-radius:8px;font-size:14px}\na.link{color:var(--gold);text-decoration:none}\npre{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:16px;overflow-x:auto;font-family:\"JetBrains Mono\",monospace;font-size:13px;color:#d8d0c0;margin:16px 0}\n.kw{color:var(--gold)}\nfooter{border-top:1px solid var(--line);margin-top:40px;padding-top:20px;color:var(--muted);font-size:13px}\nfooter a{color:var(--muted);text-decoration:none}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n{! yield(\"content\") !}\n<footer>Built with toke on ooke &middot; <a href=\"https://tokelang.dev\">tokelang.dev</a> &middot; Write less. Mean more.</footer>\n</div>\n</body>\n</html>\n";
  (mt file.write(path.join(path.join(name;"templates");"base.tkt");basecontent) {$ok:v v;$err:e false});
  let hometemplate="{! layout(\"base\") !}\n{! block(\"title\") !}{= site.name =}{! end !}\n{! block(\"content\") !}\n<div class=\"lockup\"><div class=\"coin\"></div><span class=\"wordmark\">ooke</span></div>\n<div class=\"eyebrow\">Admit one</div>\n<h1>ooke is running.</h1>\n<p>A single native binary serving this page &mdash; no runtime, no dependencies. Built with <a class=\"link\" href=\"https://tokelang.dev\">toke</a>, a language built for AI.</p>\n<div class=\"card\">\n<div class=\"eyebrow\">Get started</div>\n<p style=\"margin-bottom:12px\">This page is <code>templates/index.tkt</code>, rendered into <code>templates/base.tkt</code>. Edit either to make it yours, or add a page:</p>\n<pre><span class=\"kw\">m</span>=pages.about;</pre>\n<p style=\"margin-bottom:12px\">A page at <code>pages/about.tk</code> is served at <code>/about</code> and renders <code>templates/about.tkt</code>, so add that file too.</p>\n<a class=\"btn\" href=\"https://github.com/karwalski/ooke\">ooke on GitHub</a>\n</div>\n{! end !}\n";
  (mt file.write(path.join(path.join(name;"templates");"index.tkt");hometemplate) {$ok:v v;$err:e false});
  (log.info(str.concat("Created project: ";name);@()));
  <0
};

f=cligen(gentype:$str;genname:$str):i64{
  if(str.eq(gentype;"page")){
    let pagepath=path.join("pages";str.concat(genname;".tk"));
    let pagecontent=str.join("";@("m=pages.";genname;";\n"));
    let pw=mt file.write(pagepath;pagecontent) {$ok:v v;$err:e false};
    (log.info(str.concat("Created page: ";pagepath);@()));
    <0
  }el{
    if(str.eq(gentype;"type")){
      let dm=mt file.mkdir("models") {$ok:v v;$err:e false};
      let typepath=path.join("models";str.concat(genname;".toml"));
      let typecontent=str.join("";@("name = \"";genname;"\"\n\n[fields]\nlist = \"title, slug\"\n\n[fields.title]\ntype = \"str\"\nrequired = true\n\n[fields.slug]\ntype = \"str\"\nrequired = true\n"));
      let tw=mt file.write(typepath;typecontent) {$ok:v v;$err:e false};
      (log.info(str.concat("Created type: ";typepath);@()));
      <0
    }el{
      if(str.eq(gentype;"api")){
        let da=mt file.mkdir(path.join("pages";"api")) {$ok:v v;$err:e false};
        let apipath=path.join(path.join("pages";"api");str.concat(genname;".tk"));
        let apicontent=str.join("";@("m=pages.api.";genname;";\n"));
        let aw=mt file.write(apipath;apicontent) {$ok:v v;$err:e false};
        (log.info(str.concat("Created api: ";apipath);@()));
        (log.info("Wire handler: add src/api<name>.tk with apiget/apipost/apiinit, import in main.tk, add to Makefile";@()));
        <0
      }el{
        if(str.eq(gentype;"island")){
          let di=mt file.mkdir("islands") {$ok:v v;$err:e false};
          let islandpath=path.join("islands";str.concat(genname;".tk"));
          let islandcontent=str.join("";@("m=islands.";genname;";\n"));
          let iw=mt file.write(islandpath;islandcontent) {$ok:v v;$err:e false};
          (log.info(str.concat("Created island: ";islandpath);@()));
          <0
        }el{
          (log.info(str.concat("unknown gen type: ";gentype);@()));
          <1
        }
      }
    }
  }
};

f=retcolon(t:$str):$str{
  <str.concat("):";t)
};

f=specstack(t:$str;name:$str):$str{
  let hdr=str.join("";@("m=";name;";\ni=stk:std.stack;\n\n"));
  let tdef=str.join("";@("t=$";name;"=stk.$stack;\n\n"));
  let newbody=str.join("";@("{\n  <stk.stack.new() as $";name;";\n};\n\n"));
  let fnew=str.join("";@("f=new():$";name;newbody));
  let pushret=str.concat(retcolon(t);"{\n  <stk.stack.push(s as stk.$stack;val);\n};\n\n");
  let pushsig=str.join("";@(";val:";t;pushret));
  let fpush=str.join("";@("f=push(s:$";name;pushsig));
  let popret=str.concat(retcolon(t);"{\n  <stk.stack.pop(s as stk.$stack);\n};\n\n");
  let fpop=str.join("";@("f=pop(s:$";name;popret));
  let peekret=str.concat(retcolon(t);"{\n  <stk.stack.peek(s as stk.$stack);\n};\n\n");
  let fpeek=str.join("";@("f=peek(s:$";name;peekret));
  let flen=str.join("";@("f=len(s:$";name;retcolon("i64");"{\n  <stk.stack.len(s as stk.$stack);\n};\n\n"));
  let fempty=str.join("";@("f=empty(s:$";name;retcolon("i64");"{\n  <stk.stack.empty(s as stk.$stack);\n};\n"));
  <str.join("";@(hdr;tdef;fnew;fpush;fpop;fpeek;flen;fempty))
};

f=specqueue(t:$str;name:$str):$str{
  let hdr=str.join("";@("m=";name;";\ni=que:std.queue;\n\n"));
  let tdef=str.join("";@("t=$";name;"=que.$queue;\n\n"));
  let newbody=str.join("";@("{\n  <que.queue.new() as $";name;";\n};\n\n"));
  let fnew=str.join("";@("f=new():$";name;newbody));
  let pushret=str.concat(retcolon(t);"{\n  <que.queue.push(q as que.$queue;val);\n};\n\n");
  let pushsig=str.join("";@(";val:";t;pushret));
  let fpush=str.join("";@("f=push(q:$";name;pushsig));
  let popret=str.concat(retcolon(t);"{\n  <que.queue.pop(q as que.$queue);\n};\n\n");
  let fpop=str.join("";@("f=pop(q:$";name;popret));
  let peekret=str.concat(retcolon(t);"{\n  <que.queue.peek(q as que.$queue);\n};\n\n");
  let fpeek=str.join("";@("f=peek(q:$";name;peekret));
  let flen=str.join("";@("f=len(q:$";name;retcolon("i64");"{\n  <que.queue.len(q as que.$queue);\n};\n"));
  <str.join("";@(hdr;tdef;fnew;fpush;fpop;fpeek;flen))
};

f=specset(t:$str;name:$str):$str{
  let hdr=str.join("";@("m=";name;";\ni=st:std.set;\n\n"));
  let tdef=str.join("";@("t=$";name;"=st.$set;\n\n"));
  let newbody=str.join("";@("{\n  <st.set.new() as $";name;";\n};\n\n"));
  let fnew=str.join("";@("f=new():$";name;newbody));
  let addret=str.concat(retcolon(t);"{\n  <st.set.add(s as st.$set;val);\n};\n\n");
  let addsig=str.join("";@(";val:";t;addret));
  let fadd=str.join("";@("f=add(s:$";name;addsig));
  let hasret=str.concat(retcolon("i64");"{\n  <st.set.has(s as st.$set;val);\n};\n\n");
  let hassig=str.join("";@(";val:";t;hasret));
  let fhas=str.join("";@("f=has(s:$";name;hassig));
  let remret=str.concat(retcolon(t);"{\n  <st.set.remove(s as st.$set;val);\n};\n\n");
  let remsig=str.join("";@(";val:";t;remret));
  let fremove=str.join("";@("f=remove(s:$";name;remsig));
  let flen=str.join("";@("f=len(s:$";name;retcolon("i64");"{\n  <st.set.len(s as st.$set);\n};\n"));
  <str.join("";@(hdr;tdef;fnew;fadd;fhas;fremove;flen))
};

f=cligenspec(container:$str;typename:$str):i64{
  let name=str.concat(container;typename);
  let filename=str.concat(name;".tk");
  if(str.eq(container;"stack")){
    let content=specstack(typename;name);
    let w=mt file.write(filename;content) {$ok:v v;$err:e false};
    (log.info(str.concat("Created specialised: ";filename);@()));
    <0
  }el{
    if(str.eq(container;"queue")){
      let content=specqueue(typename;name);
      let w=mt file.write(filename;content) {$ok:v v;$err:e false};
      (log.info(str.concat("Created specialised: ";filename);@()));
      <0
    }el{
      if(str.eq(container;"set")){
        let content=specset(typename;name);
        let w=mt file.write(filename;content) {$ok:v v;$err:e false};
        (log.info(str.concat("Created specialised: ";filename);@()));
        <0
      }el{
        (log.info(str.join("";@("unknown container: ";container;", expected: stack, queue, set"));@()));
        <1
      }
    }
  }
};

f=cfgdefault():$ookecfg{
  <$ookecfg{
    sitename:"my-site";siteurl:"";sitelanguage:"en";
    buildoutput:"build/";buildminify:true;buildinlinecss:true;
    serverport:3000;serverworkers:0;servercorsorigins:"";
    logaccess:"-";logerror:"";logaccessformat:"combined";
    tlscert:"";tlskey:"";
    apiprefix:""
  }
};

(* The reason is logged by serve.tk at the point of failure; this cannot read
   `e.msg` off the payload because that traps RT005 (toke 127.78, open). *)
f=clireportserveerr():i64{
  (log.error("serve did not start — see the error above";@()));
  <1
};

(* Story 134.42. runserve and runbuild used to read the config as
   `{$err:e cfgdefault()}`, so an ooke.toml that failed to parse was served or
   built with default settings -- port 3000, output build/, minify on -- and
   no message. A MISSING ooke.toml still means "use the defaults"; a PRESENT
   one that cannot be loaded is now an error. The parser's own message cannot
   be printed: the toml error payload is unreadable from toke (E4034 on toke
   main, RT005 at the declared floor, and `!$configerr` propagation drops it),
   so this names the file and the cause class instead. *)
f=clicfgloads(cfgpath:$str):bool{
  if(file.exists(cfgpath)){
    let ok=mt config.configload(cfgpath) {$ok:v true;$err:e false};
    <ok
  }el{
    <true
  }
};

f=clireportcfgerr(cfgpath:$str):i64{
  (log.error(str.join("";@(cfgpath;" could not be read or is not valid TOML; refusing to fall back to default settings. Fix the file, or remove it to use the defaults."));@()));
  <1
};

f=runserve(projectdir:$str):i64{
  let cfgpath=path.join(projectdir;"ooke.toml");
  if(!clicfgloads(cfgpath)){
    <clireportcfgerr(cfgpath)
  }el{};
  let cfg=mt config.configload(cfgpath) {$ok:v v;$err:e cfgdefault()};
  let port=cfg.serverport;
  let workers=cfg.serverworkers;
  let output=cfg.buildoutput;
  let sitename=cfg.sitename;
  let siteurl=cfg.siteurl;
  let sitelanguage=cfg.sitelanguage;
  let apiprefix=cfg.apiprefix;
  let corsorigins=cfg.servercorsorigins;
  (* Story 134.40: [tls] and [log] are applied, before anything binds. Each
     helper logs its own reason; a bad key refuses to start. *)
  let tlsok=mt serve.servetlscheck(projectdir;cfg.tlscert;cfg.tlskey) {$ok:v true;$err:e false};
  if(!tlsok){<clireportserveerr()}el{};
  let unsupported=mt config.configlogunsupported(cfgpath) {$ok:v v;$err:e ""};
  if(str.len(unsupported)>0){
    (log.warn(str.join("";@("[log] ";unsupported;" ignored: ooke does not rotate logs (std.log rotation loses lines; see docs/logging-and-tls.md)"));@()))
  }el{};
  let logok=mt serve.serveopenlogs(projectdir;cfg.logaccess;cfg.logerror;cfg.logaccessformat) {$ok:v true;$err:e false};
  if(!logok){<clireportserveerr()}el{};
  let handledpaths=handlers.registerall();
  (log.info(str.join("";@("auto-registered ";handledpaths.len as str;" handler routes"));@()));
  (* serverun now fails rather than starting with no routes (story 134.18), so
     say why. Returning a bare 1 left the operator with a silent non-zero. *)
  let r=mt serve.serverun(projectdir;port;workers;output;cfg.tlscert;cfg.tlskey;sitename;siteurl;sitelanguage;apiprefix;corsorigins;handledpaths) {
    $ok:v 0;
    $err:e clireportserveerr()
  };
  <r
};

f=runbuild(projectdir:$str):i64{
  let cfgpath=path.join(projectdir;"ooke.toml");
  if(!clicfgloads(cfgpath)){
    <clireportcfgerr(cfgpath)
  }el{};
  let cfg=mt config.configload(cfgpath) {$ok:v v;$err:e cfgdefault()};
  let report=mt build.buildrun(projectdir;cfg) {$ok:v v;$err:e $buildreport{pagesbuilt:0-1;assetscopy:0;valerrors:0;valwarnings:0;pagesskipped:0}};
  (* Story 134.24, second defect. This discarded the $builderr it was handed and
     logged the word "build failed" — no route, no template, no reason — which
     is why 134.24 took a four-build bisect to find. The payload's own `e.msg`
     still cannot be read here (RT005, toke 127.78, open — the same constraint
     clireportserveerr states), so build.tk logs the reason where the error is
     raised and this names the project, says nothing was written, and points at
     it. When 127.78 is fixed, print the payload here instead. *)
  if(report.pagesbuilt<0){
    (log.error(str.join("";@("ooke build failed for ";projectdir;" — no site was written. The route that failed and the template it could not render are named in the error above."));@()));
    <1
  }el{};
  (log.info(str.concat("pages built: ";str.fromint(report.pagesbuilt));@()));
  (log.info(str.concat("assets copied: ";str.fromint(report.assetscopy));@()));
  if(report.valerrors>0){
    (log.info(str.concat("validation errors: ";str.fromint(report.valerrors));@()))
  }el{};
  if(report.valwarnings>0){
    (log.info(str.concat("validation warnings: ";str.fromint(report.valwarnings));@()))
  }el{};
  if(report.pagesskipped>0){
    (log.error(str.join("";@("pages skipped: ";report.pagesskipped as str;" — build failed"));@()));
    <1
  }el{};
  <0
};
