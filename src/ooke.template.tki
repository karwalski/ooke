{
  "schema_version": "1.0",
  "module": "ooke.template",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "tokenkind", "fields": [{"name": "raw", "type": "bool"}, {"name": "expr", "type": "bool"}, {"name": "directive", "type": "bool"}, {"name": "comment", "type": "bool"}]},
    {"kind": "type", "name": "token", "fields": [{"name": "kind", "type": "tokenkind"}, {"name": "content", "type": "str"}]},
    {"kind": "type", "name": "tplerr", "fields": [{"name": "msg", "type": "str"}]},
    {"kind": "type", "name": "block", "fields": [{"name": "name", "type": "str"}, {"name": "toks", "type": "[token]"}]},
    {"kind": "type", "name": "hc", "fields": [{"name": "st", "type": "i64"}, {"name": "closing", "type": "i64"}, {"name": "tagel", "type": "i64"}, {"name": "rawel", "type": "i64"}, {"name": "rname", "type": "str"}, {"name": "name", "type": "str"}, {"name": "nover", "type": "i64"}, {"name": "ak", "type": "i64"}, {"name": "quote", "type": "i64"}, {"name": "vlen", "type": "i64"}, {"name": "urlpart", "type": "i64"}, {"name": "js", "type": "i64"}, {"name": "css", "type": "i64"}, {"name": "esc", "type": "i64"}, {"name": "slash", "type": "i64"}, {"name": "star", "type": "i64"}, {"name": "dashes", "type": "i64"}, {"name": "mcount", "type": "i64"}, {"name": "endlen", "type": "i64"}]},
    {"kind": "type", "name": "rout", "fields": [{"name": "text", "type": "str"}, {"name": "hc", "type": "hc"}, {"name": "islands", "type": "bool"}]},
    {"kind": "type", "name": "tplcache", "fields": [{"name": "entries", "type": "[str:[token]]"}]},
    {"kind": "type", "name": "renderresult", "fields": [{"name": "output", "type": "str"}, {"name": "cache", "type": "tplcache"}]},
    {"kind": "func", "name": "tplescape", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "hcnew", "params": [], "return": "hc"},
    {"kind": "func", "name": "hcspace", "params": ["i64"], "return": "bool"},
    {"kind": "func", "name": "hcalpha", "params": ["i64"], "return": "bool"},
    {"kind": "func", "name": "hcalnum", "params": ["i64"], "return": "bool"},
    {"kind": "func", "name": "hcpack", "params": ["i64", "i64", "i64", "i64"], "return": "i64"},
    {"kind": "func", "name": "hcjs", "params": ["i64", "i64"], "return": "i64"},
    {"kind": "func", "name": "hccss", "params": ["i64", "i64"], "return": "i64"},
    {"kind": "func", "name": "hcelemkind", "params": ["str", "i64"], "return": "i64"},
    {"kind": "func", "name": "hcattrkind", "params": ["str", "i64"], "return": "i64"},
    {"kind": "func", "name": "hcfeed", "params": ["hc", "str"], "return": "hc"},
    {"kind": "func", "name": "hchexdigit", "params": ["i64"], "return": "str"},
    {"kind": "func", "name": "hchex2", "params": ["i64"], "return": "str"},
    {"kind": "func", "name": "esckeep", "params": ["i64", "i64"], "return": "bool"},
    {"kind": "func", "name": "escrepl", "params": ["i64", "i64"], "return": "str"},
    {"kind": "func", "name": "escbytes", "params": ["str", "i64"], "return": "str"},
    {"kind": "func", "name": "escjs", "params": ["i64", "str"], "return": "str"},
    {"kind": "func", "name": "esccss", "params": ["i64", "str"], "return": "str"},
    {"kind": "func", "name": "escurl", "params": ["i64", "i64", "str"], "return": "str"},
    {"kind": "func", "name": "escname", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "ctxescape", "params": ["hc", "str"], "return": "str"},
    {"kind": "func", "name": "tplfilterctx", "params": ["str", "str", "hc"], "return": "str"},
    {"kind": "func", "name": "tplexprctx", "params": ["str", "[str:str]", "hc"], "return": "str"},
    {"kind": "func", "name": "tplapplyfilter", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "tplresolveexpr", "params": ["str", "[str:str]"], "return": "str"},
    {"kind": "func", "name": "tpllex", "params": ["str"], "return": "[token]", "error": "tplerr"},
    {"kind": "func", "name": "tpldirectivename", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "tpldirectivearg", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "tpldirectiveknown", "params": ["str"], "return": "bool"},
    {"kind": "func", "name": "tplfindblock", "params": ["[block]", "str"], "return": "[token]"},
    {"kind": "func", "name": "tplislandparse", "params": ["str"], "return": "[str:str]"},
    {"kind": "func", "name": "tplnameok", "params": ["str"], "return": "bool"},
    {"kind": "func", "name": "tplnamepath", "params": ["str", "str", "str"], "return": "str", "error": "tplerr"},
    {"kind": "func", "name": "tplrenderctx", "params": ["[token]", "[str:str]", "str", "[block]", "hc", "i64"], "return": "rout", "error": "tplerr"},
    {"kind": "func", "name": "tplrender", "params": ["[token]", "[str:str]", "str", "[block]"], "return": "str", "error": "tplerr"},
    {"kind": "func", "name": "tplreadsource", "params": ["str"], "return": "str", "error": "tplerr"},
    {"kind": "func", "name": "tplrenderfile", "params": ["str", "[str:str]", "str"], "return": "str", "error": "tplerr"},
    {"kind": "func", "name": "tplcachenew", "params": [], "return": "tplcache"},
    {"kind": "func", "name": "tplcacheget", "params": ["tplcache", "str"], "return": "[token]", "error": "tplerr"},
    {"kind": "func", "name": "tplrenderfilecached", "params": ["str", "[str:str]", "str", "tplcache"], "return": "renderresult", "error": "tplerr"}
  ]
}
