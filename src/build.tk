m=ooke.build;
i=file:std.file;
i=log:std.log;
i=str:std.str;
i=path:std.path;
i=cfg:ooke.config;
i=router:ooke.router;
i=tpl:ooke.template;
i=store:ooke.store;
i=validate:ooke.validate;

t=$builderr{msg:$str};

t=$buildreport{pagesbuilt:i64;assetscopy:i64;valerrors:i64;valwarnings:i64;pagesskipped:i64};

(* Story 134.24. routerscan has always set $route.isapi — anything under
   pages/api/ is a request handler, not a page — and serve.tk has always read
   it (serve.tk:46). buildrun never did: it asked only `isdynamic`, so every API
   route fell into the static-page branch and was rendered as a template. There
   is no templates/api/<name>.tkt to render, so tplrenderfile returned "no
   template file" and the whole build aborted on it — on `ooke new`'s own output
   as much as on the site.

   The bisect blames e7a6f60 (134.2), which changed the page handlers' return
   from :void to :i64. That commit only EXPOSED this: the same error was raised
   before and quietly swallowed. The fix is therefore to READ the flag the
   scanner sets, not to restore the swallowing.

   The two questions buildrun asks of a route are named here so they can be
   asserted directly, rather than living as an inline condition inside a loop
   that only an end-to-end build can exercise. *)
f=buildisstaticpage(r:$route):bool{
  <!r.isdynamic&&!r.isapi
};

f=buildisdynamicpage(r:$route):bool{
  <r.isdynamic&&!r.isapi
};

f=buildoutputpath(pattern:$str;outputdir:$str):$str{
  if(pattern=="/"){
    <str.concat(outputdir;"index.html")
  }el{
    let stripped=str.trimprefix(pattern;"/");
    <path.join(outputdir;path.join(stripped;"index.html"))
  }
};

(* Story 134.20. `[build].minify` and `[build].inlinecss` were parsed into
   $ookecfg and then read by nothing: buildminify and buildinlinecss were
   defined, documented and unit-tested, but never called on the build path, so
   both settings did nothing. Every page the builder writes now goes through
   here, which is the single place the two flags are honoured. Order matters:
   inlining replaces the <link> with a <style> block, so it must run before
   minification collapses the whitespace around it. *)
f=buildfinish(html:$str;templatesdir:$str;doinlinecss:bool;dominify:bool):$str{
  let out=mut.html;
  if(doinlinecss){out=buildinlinecss(out;templatesdir)}el{};
  if(dominify){out=buildminify(out)}el{};
  <out
};

f=buildpage(templatepath:$str;pattern:$str;sitename:$str;siteurl:$str;sitelanguage:$str;buildoutput:$str;templatesdir:$str;doinlinecss:bool;dominify:bool):i64!$builderr{
  let ctx=@(
    "site.name":sitename;
    "site.url":siteurl;
    "site.language":sitelanguage
  );
  let rendered=tpl.tplrenderfile(templatepath;ctx;templatesdir)!$builderr;
  let html=buildfinish(rendered;templatesdir;doinlinecss;dominify);
  let outpath=buildoutputpath(pattern;buildoutput);
  let parentdir=path.dir(outpath);
  (file.mkdir(parentdir)!$builderr);
  (file.write(outpath;html)!$builderr);
  <0
};

f=buildinlinecssonce(html:$str;templatesdir:$str):$str{
  let pos=str.indexof(html;"<link rel=\"stylesheet\"");
  if(pos<0){
    <html
  }el{
    let afterlink=str.slice(html;pos as u64;str.len(html));
    let afterlink2=mt afterlink {$ok:v v;$err:e ""};
    if(str.len(afterlink2)==0){
      <html
    }el{
      let hrefmarker="href=\"";
      let hrefpos=str.indexof(afterlink2;hrefmarker);
      if(hrefpos<0){
        <html
      }el{
        let start=(hrefpos+6) as u64;
        let afterhref=str.slice(afterlink2;start;str.len(afterlink2));
        let afterhref2=mt afterhref {$ok:v v;$err:e ""};
        if(str.len(afterhref2)==0){
          <html
        }el{
          let closequote=str.indexof(afterhref2;"\"");
          if(closequote<0){
            <html
          }el{
            let hrefval=str.slice(afterhref2;0;closequote as u64);
            let hrefval2=mt hrefval {$ok:v v;$err:e ""};
            let csspath=path.join(templatesdir;hrefval2);
            let csscontent=mt file.read(csspath) {$ok:c c;$err:e ""};
            if(str.len(csscontent)==0){
              <html
            }el{
              let tagend=str.indexof(afterlink2;">");
              if(tagend<0){
                <html
              }el{
                let fulltag=str.slice(afterlink2;0;tagend as u64+1);
                let fulltag2=mt fulltag {$ok:v v;$err:e ""};
                let styleblock=str.join("";@("<style>\n";csscontent;"\n</style>"));
                <str.replace(html;fulltag2;styleblock)
              }
            }
          }
        }
      }
    }
  }
};

f=buildinlinecss(html:$str;templatesdir:$str):$str{
  let result=mut.html;
  let running=mut.true;
  lp(let ii=0;running;ii=ii+1){
    let next=buildinlinecssonce(result;templatesdir);
    if(next==result){
      running=false
    }el{
      result=next
    }
  };
  <result
};

f=buildminify(html:$str):$str{
  let s=mut.html;
  let running=mut.true;
  lp(let ii=0;running;ii=ii+1){
    let replaced=str.replace(s;"  ";" ");
    if(replaced==s){
      running=false
    }el{
      s=replaced
    }
  };
  let running2=mut.true;
  lp(let jj=0;running2;jj=jj+1){
    let openpos=str.indexof(s;"<!--");
    if(openpos<0){
      running2=false
    }el{
      let afteropen=str.slice(s;openpos as u64+4;str.len(s));
      let afteropen2=mt afteropen {$ok:v v;$err:e ""};
      if(str.len(afteropen2)==0){
        running2=false
      }el{
        let closepos=str.indexof(afteropen2;"-->");
        if(closepos<0){
          running2=false
        }el{
          let commentend=openpos+4+closepos+3;
          let before=str.slice(s;0;openpos as u64);
          let before2=mt before {$ok:v v;$err:e ""};
          let after=str.slice(s;commentend as u64;str.len(s));
          let after2=mt after {$ok:v v;$err:e ""};
          s=str.concat(before2;after2)
        }
      }
    }
  };
  <s
};

f=buildcopyassets(projectdir:$str;outputdir:$str):i64!$builderr{
  let staticdir=path.join(projectdir;"static");
  if(!file.isdir(staticdir)){
    <0
  }el{
    let files=file.listall(staticdir)!$builderr;
    let count=mut.0;
    lp(let i=0;i<files.len;i=i+1){
      let rel=files.get(i);
      let srcpath=path.join(staticdir;rel);
      let dstpath=path.join(str.concat(outputdir;"/static");rel);
      let dstparent=path.dir(dstpath);
      let mkr2=mt file.mkdir(dstparent) {$ok:v true;$err:e false};
      let copyok=mt file.copy(srcpath;dstpath) {$ok:v true;$err:e false};
      if(copyok){count=count+1}el{}
    };
    <count
  }
};

f=buildrun(projectdir:$str;config:$ookecfg):$buildreport!$builderr{
  let pagesdir=path.join(projectdir;"pages");
  let contentdir=path.join(projectdir;"content");
  let templatesdir=path.join(projectdir;"templates");
  let modelsdir=path.join(projectdir;"models");

  let routes=router.routerscan(pagesdir)!$builderr;

  let pagescount=mut.0;
  let skippedcount=mut.0;
  let allval=mut.validate.validateempty();

  (* 134.24: buildisstaticpage is the flag read the build never did. *)
  let apicount=mut.0;
  lp(let i=0;i<routes.len;i=i+1){
    if(routes.get(i).isapi){
      apicount=apicount+1
    }el{};
    if(buildisstaticpage(routes.get(i))){
      let bp=buildpage(routes.get(i).templatepath;routes.get(i).pattern;config.sitename;config.siteurl;config.sitelanguage;config.buildoutput;templatesdir;config.buildinlinecss;config.buildminify)!$builderr;
      pagescount=pagescount+1
    }el{}
  };
  if(apicount>0){
    (log.info(str.join("";@("build: ";apicount as str;" api route(s) under pages/api/ are request handlers, not pages — they are served by `ooke serve` and are not rendered into the static build"));@()))
  }el{};

  lp(let j=0;j<routes.len;j=j+1){
    (* 134.24: the same flag governs the dynamic branch. pages/api/[id].tk is a
       handler with a path parameter, not a content-backed section index, so it
       must neither be rendered nor warned about as an unbuildable page. *)
    let isdyn2=buildisdynamicpage(routes.get(j));
    let dyncount=router.routecountdynamic(routes.get(j).pattern);
    if(dyncount>1&&isdyn2){
      (log.warn(str.join("";@("build: cannot statically build ";routes.get(j).pattern;" — the static builder resolves exactly one dynamic segment (:slug) backed by a literal content directory; this route is served dynamically only"));@()))
    }el{};
    if(isdyn2&&dyncount==1){
      let ctype=routes.get(j).contenttype;
      let col=mt store.storeall(contentdir;ctype;"flat") {$ok:c c;$err:e @()};
      let model=mt validate.validateloadmodel(modelsdir;ctype) {$ok:m m;$err:e $modeldef{name:"";fields:@($fielddef)}};
      let hasmodel=model.fields.len>0;
      lp(let k=0;k<col.len;k=k+1){
        let slug=col.get(k).slug;
        let body=col.get(k).body;
        let title=col.get(k).title;
        if(str.len(slug)==0){
          (log.warn(str.join("";@("build: not published — a content item in ";ctype;" has no slug. Markdown takes its slug from frontmatter or its filename; a .json content file must carry a slug key. Skipping so it cannot overwrite the section index."));@()))
        }el{};
        if(hasmodel){
          let fpath=str.join("";@(ctype;"/";slug;".md"));
          let vr=validate.validatecontent(model;col.get(k).meta;fpath);
          allval=validate.validatemerge(allval;vr)
        }el{};
        let ctx=@(
          "site.name":config.sitename;
          "site.url":config.siteurl;
          "site.language":config.sitelanguage;
          "slug":slug;
          "body":body;
          "title":title
        );
        let renderedhtml=mt tpl.tplrenderfile(routes.get(j).templatepath;ctx;templatesdir) {$ok:h h;$err:e ""};
        let html=buildfinish(renderedhtml;templatesdir;config.buildinlinecss;config.buildminify);
        if(str.len(html)==0&&str.len(slug)>0){
          (log.error(str.join("";@("build: render produced no output for ";routes.get(j).templatepath;" slug=";slug));@()));
          skippedcount=skippedcount+1
        }el{};
        if(str.len(html)>0&&str.len(slug)>0){
          let slugpattern=str.replace(routes.get(j).pattern;":slug";slug);
          let outpath=buildoutputpath(slugpattern;config.buildoutput);
          let parentdir=path.dir(outpath);
          let mkr3=mt file.mkdir(parentdir) {$ok:v true;$err:e false};
          let writeok=mt file.write(outpath;html) {$ok:v true;$err:e false};
          if(writeok){pagescount=pagescount+1}el{
            (log.error(str.concat("build: write failed for ";outpath);@()));
            skippedcount=skippedcount+1
          }
        }el{}
      }
    }el{}
  };

  (validate.validatelogresult(allval));

  let assetscount=mt buildcopyassets(projectdir;config.buildoutput) {$ok:n n;$err:e 0};

  let notfoundtpl=path.join(templatesdir;"errors/404.tkt");
  if(file.exists(notfoundtpl)){
    let nfctx=@(
      "site.name":config.sitename;
      "site.url":config.siteurl;
      "site.language":config.sitelanguage;
      "request.path":"(unknown)"
    );
    let nfrendered=mt tpl.tplrenderfile(notfoundtpl;nfctx;templatesdir) {$ok:h h;$err:e ""};
    let nfhtml=buildfinish(nfrendered;templatesdir;config.buildinlinecss;config.buildminify);
    if(str.len(nfhtml)>0){
      let nfpath=str.concat(config.buildoutput;"404.html");
      let nfwrite=mt file.write(nfpath;nfhtml) {$ok:v true;$err:e false};
      if(nfwrite){
        pagescount=pagescount+1
      }el{}
    }el{}
  }el{};

  <$buildreport{pagesbuilt:pagescount;assetscopy:assetscount;valerrors:allval.errors.len;valwarnings:allval.warnings.len;pagesskipped:skippedcount}
};
