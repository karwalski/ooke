m=ooke.store;
i=file:std.file;
i=str:std.str;
i=path:std.path;
i=json:std.json;
i=db:std.db;

t=$content{
  slug:$str;
  type:$str;
  title:$str;
  meta:@($str:$str);
  body:$str
};

t=$storeerr{msg:$str};

f=storedefault():$content{
  <$content{slug:"";type:"page";title:"";meta:@($str:$str);body:""}
};

(* Story 132.148. A front-matter value as YAML reads it: trimmed, and when
   it is wrapped in a matching pair of double or single quotes, the quotes
   removed. Inside double quotes \\ is a backslash and \" a quote; inside
   single quotes '' is a quote. An unpaired quote is kept as written. *)
f=storefrontvalue(raw:$str):$str{
  let v=str.trim(raw);
  let n=str.len(v);
  let out=mut.v;
  if(n>1){
    if(str.startswith(v;"\"")&&str.endswith(v;"\"")){
      let inner=mt str.slice(v;1;n-1) {$ok:x x;$err:e v};
      let parts=str.split(inner;"\\\\");
      let un=mut.@($str);
      lp(let i=0;i<parts.len;i=i+1){un=un.append(str.replace(parts.get(i);"\\\"";"\""))};
      out=str.join("\\";un)
    }el{
      if(str.startswith(v;"'")&&str.endswith(v;"'")){
        let inner=mt str.slice(v;1;n-1) {$ok:x x;$err:e v};
        out=str.replace(inner;"''";"'")
      }el{}
    }
  }el{};
  <out
};

f=storeparsefront(src:$str):$content!$storeerr{
  let opener="---\n";
  if(!str.startswith(src;opener)){
    <$content{slug:"";type:"page";title:"";meta:@($str:$str);body:src}
  }el{
    let afteropen=mt str.slice(src;4;str.len(src)) {$ok:v v;$err:e ""};
    let closer="\n---\n";
    let closepos=str.indexof(afteropen;closer);
    if(closepos<0){
      <$content{slug:"";type:"page";title:"";meta:@($str:$str);body:src}
    }el{
      let fmraw=mt str.slice(afteropen;0;closepos as u64) {$ok:v v;$err:e ""};
      let bodystart=(closepos+5) as u64;
      let bodyraw=str.trim(mt str.slice(afteropen;bodystart;str.len(afteropen)) {$ok:v v;$err:e ""});
      let lines=str.split(fmraw;"\n");
      let meta=mut.@($str:$str);
      let slug=mut."";
      let ctype=mut."page";
      let ctitle=mut."";
      (* Story 121.66 (c, d). A line was split on every ":" and only the
         second piece kept, so `url: https://x.io` read "https" and
         `time: 12:30` read "12". The guard `!kv.len<2` parsed as
         `(!kv.len)<2`, which is always true, so a line with no ":" -- a
         blank line in the front matter -- read kv.get(1) past the end and
         the process died with RT003. A line with no key is skipped.
         Story 132.148. The key ends at the first ": " (or a ":" that ends
         the line), as in YAML, and the value goes through storefrontvalue,
         which drops YAML quotes: `title: "A: b"` read `"A: b"` with its
         quotes, and an older build cut it at the first ":" as well, so
         toke-website rendered a page titled `"Canonical facts`. *)
      lp(let i=0;i<lines.len;i=i+1){
        let line=str.trim(lines.get(i));
        let sep=str.indexof(line;": ");
        let n=str.len(line);
        let kend=mut.-1;
        let vstart=mut.0;
        if(!(sep<0)){kend=sep;vstart=sep+2}el{
          if(n>0&&str.endswith(line;":")){kend=(n as i64)-1;vstart=n as i64}el{}
        };
        if(kend>0){
          let k=str.trim(mt str.slice(line;0;kend as u64) {$ok:x x;$err:e ""});
          let v=storefrontvalue(mt str.slice(line;vstart as u64;n) {$ok:x x;$err:e ""});
          if(k=="slug"){slug=v}el{};
          if(k=="type"){ctype=v}el{};
          if(k=="title"){ctitle=v}el{};
          meta=meta.set(k;v)
        }el{}
      };
      <$content{slug:slug;type:ctype;title:ctitle;meta:meta;body:bodyraw}
    }
  }
};

f=storetryparse(src:$str):$content{
  <mt storeparsefront(src) {$ok:c c;$err:e storedefault()}
};

f=storeparsejson(src:$str):$content!$storeerr{
  let doc=json.dec(src)!$storeerr;
  let meta=mut.@($str:$str);
  let slug=mt json.str(doc;"slug") {$ok:v v;$err:e ""};
  let ctype=mt json.str(doc;"type") {$ok:v v;$err:e "page"};
  let ctitle=mt json.str(doc;"title") {$ok:v v;$err:e ""};
  if(str.len(slug)>0){meta=meta.set("slug";slug)}el{};
  if(str.len(ctype)>0){meta=meta.set("type";ctype)}el{};
  if(str.len(ctitle)>0){meta=meta.set("title";ctitle)}el{};
  <$content{slug:slug;type:ctype;title:ctitle;meta:meta;body:""}
};

f=storetryparsejson(src:$str):$content{
  <mt storeparsejson(src) {$ok:c c;$err:e storedefault()}
};

(* Story 121.25 (audit OOK-04). SQLite cannot bind an identifier, so a table
   or column name is spliced into the SQL text -- and nothing checked it:
   storesqlcreate("posts(id);DROP TABLE users;--";...) returned exactly that
   text inside a CREATE. The names come from models/*.toml and the content
   directory today, not from a request, so this is defence in depth; the
   check makes it structural rather than a property of today's callers.
   An identifier is [A-Za-z_][A-Za-z0-9_]* -- the rule ADR-0011 gives the
   planned std db.ident, which does not exist yet (toke 124.5). *)
f=storeident(name:$str):$str!$storeerr{
  let n=str.len(name);
  if(n==0){<$storeerr{msg:"empty SQL identifier"}}el{};
  let alpha="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
  let digits="0123456789";
  lp(let i=0;i<n;i=i+1){
    let c=mt str.slice(name;i;i+1) {$ok:v v;$err:e ""};
    let isalpha=str.len(c)==1&&str.contains(alpha;c);
    let isdigit=str.len(c)==1&&str.contains(digits;c);
    if(!(isalpha||(i>0&&isdigit))){
      <$storeerr{msg:str.join("";@("not a SQL identifier (want [A-Za-z_][A-Za-z0-9_]*): \"";name;"\""))}
    }el{}
  };
  <name
};

f=storesqlcreate(modelname:$str;fields:@($str:$str)):$str!$storeerr{
  let sql=mut."CREATE TABLE IF NOT EXISTS ";
  sql=str.concat(sql;storeident(modelname)!$storeerr);
  (* Story 121.67 (3): title and type are always columns. storewrite writes
     them and storeallsql reads them, but they were made only when the model
     happened to declare them, so on any other model every storewrite failed
     with "no such column: title". A field with the name of a column made
     here (id, slug, body, title, type -- SQLite names are case-insensitive)
     is skipped rather than declared twice, which SQLite refuses. *)
  sql=str.concat(sql;"(id INTEGER PRIMARY KEY,slug TEXT UNIQUE,title TEXT,type TEXT,body TEXT");
  let ks=fields.keys();
  lp(let i=0;i<ks.len;i=i+1){
    let k=ks.get(i);
    let ft=fields.get(k);
    let coltype=mut."TEXT";
    if(str.eq(ft;"bool")){coltype="INTEGER"}el{};
    if(str.eq(ft;"int")){coltype="INTEGER"}el{};
    let col=storeident(k)!$storeerr;
    let lc=str.lower(col);
    let builtin=lc=="id"||lc=="slug"||lc=="title"||lc=="type"||lc=="body";
    if(!builtin){
      sql=str.join("";@(sql;",";col;" ";coltype))
    }el{}
  };
  sql=str.concat(sql;")");
  <sql
};

f=storeallsql(contenttype:$str):@$content!$storeerr{
  let sql=str.concat("SELECT id,slug,title,type,body FROM ";storeident(contenttype)!$storeerr);
  let rows=db.many(sql;@())!$storeerr;
  let results=mut.@($content);
  lp(let i=0;i<rows.len;i=i+1){
    let r=rows.get(i);
    let slug=mt row.str(r;"slug") {$ok:s s;$err:e ""};
    let ctype=mt row.str(r;"type") {$ok:s s;$err:e "page"};
    let ctitle=mt row.str(r;"title") {$ok:s s;$err:e ""};
    let body=mt row.str(r;"body") {$ok:s s;$err:e ""};
    let meta=mut.@($str:$str);
    if(str.len(slug)>0){meta=meta.set("slug";slug)}el{};
    if(str.len(ctype)>0){meta=meta.set("type";ctype)}el{};
    if(str.len(ctitle)>0){meta=meta.set("title";ctitle)}el{};
    let c=$content{slug:slug;type:ctype;title:ctitle;meta:meta;body:body};
    results=results.append(c)
  };
  <results
};

f=storewrite(contenttype:$str;content:$content):bool!$storeerr{
  let table=storeident(contenttype)!$storeerr;
  (* Story 121.66 (e). This was `SELECT id ... WHERE slug=?` matched
     {$ok:r true;$err:e false}, so ANY failure of the check -- not only "no
     rows" -- read as "not found" and the write became an INSERT: on a table
     without an `id` column the check failed with "no such column" and every
     write of an existing slug inserted a duplicate row. A COUNT query
     always returns one row, so a failed check is now an error, propagated. *)
  let check=str.join("";@("SELECT COUNT(*) AS n FROM ";table;" WHERE slug=?"));
  let crow=db.one(check;@(content.slug))!$storeerr;
  let n=mt row.str(crow;"n") {$ok:s s;$err:e ""};
  if(str.len(n)==0){
    <$storeerr{msg:str.concat("storewrite: could not read the existence check for table ";table)}
  }el{};
  let found=!(n=="0");
  if(found){
    let sql=mut."UPDATE ";
    sql=str.concat(sql;table);
    sql=str.concat(sql;" SET title=?,type=?,body=? WHERE slug=?");
    db.exec(sql;@(content.title;content.type;content.body;content.slug))!$storeerr;
    <true
  }el{
    let sql=mut."INSERT INTO ";
    sql=str.concat(sql;table);
    sql=str.concat(sql;"(slug,title,type,body) VALUES(?,?,?,?)");
    db.exec(sql;@(content.slug;content.title;content.type;content.body))!$storeerr;
    <true
  }
};

f=storeallflat(contentdir:$str;contenttype:$str):@$content!$storeerr{
  let dir=path.join(contentdir;contenttype);
  if(!file.isdir(dir)){
    <$storeerr{msg:str.concat("no content dir: ";dir)}
  }el{};
  let files=file.listall(dir)!$storeerr;
  let results=mut.@($content);
  lp(let i=0;i<files.len;i=i+1){
    let fpath=files.get(i);
    if(str.endswith(fpath;".md")){
      let src=mt file.read(path.join(dir;fpath)) {$ok:s s;$err:e ""};
      if(str.len(src)>0){
        let parsed=storetryparse(src);
        let stem=path.stem(fpath);
        let finalslug=if(str.len(parsed.slug)>0){parsed.slug}el{stem};
        results=results.append($content{slug:finalslug;type:parsed.type;title:parsed.title;meta:parsed.meta;body:parsed.body})
      }el{}
    }el{
      if(str.endswith(fpath;".json")){
        let src=mt file.read(path.join(dir;fpath)) {$ok:s s;$err:e ""};
        if(str.len(src)>0){results=results.append(storetryparsejson(src))}el{}
      }el{}
    }
  };
  <results
};

f=storeall(contentdir:$str;contenttype:$str;backend:$str):@$content!$storeerr{
  if(backend=="sqlite"){
    <storeallsql(contenttype)!$storeerr
  }el{
    <storeallflat(contentdir;contenttype)!$storeerr
  }
};

f=storeslug(col:@$content;slug:$str):$content!$storeerr{
  lp(let i=0;i<col.len;i=i+1){
    let item=col.get(i);
    if(item.slug==slug){<item}el{}
  };
  (* Story 127.127: this used to end in (file.listall("")!$storeerr), meant to
     force an error. file.listall("") can SUCCEED, and then the body fell off
     its end and the caller got a null $content (rc 139 on its first read).
     toke now rejects that tail as E4071. Not-found is an explicit error. *)
  <$storeerr{msg:str.concat("no content with slug: ";slug)}
};

f=storefind(col:@$content;key:$str;val:$str):$content!$storeerr{
  lp(let i=0;i<col.len;i=i+1){
    let item=col.get(i);
    let mv=item.meta.get(key);
    if(str.eq(mv;val)){<item}el{}
  };
  (* Story 127.127: explicit not-found error, as in storeslug. *)
  <$storeerr{msg:str.join("";@("no content with ";key;" = ";val))}
};
