{
  "schema_version": "1.0",
  "module": "ooke.serve",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "serveerr", "fields": [{"name": "msg", "type": "str"}]},
    {"kind": "func", "name": "servegetjson", "params": ["str", "str"], "return": "i64"},
    {"kind": "func", "name": "servepostjson", "params": ["str", "str"], "return": "i64"},
    {"kind": "func", "name": "serveregisterstatic", "params": ["str", "str", "str", "str", "str", "str", "str", "str", "[str]"], "return": "i64", "error": "serveerr"},
    {"kind": "func", "name": "servelogtarget", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "serveopenlogs", "params": ["str", "str", "str", "str"], "return": "i64", "error": "serveerr"},
    {"kind": "func", "name": "servetlscheck", "params": ["str", "str", "str"], "return": "i64", "error": "serveerr"},
    {"kind": "func", "name": "serverlisten", "params": ["str", "i64", "u64", "u64", "str", "str"], "return": "i64"},
    {"kind": "func", "name": "serverun", "params": ["str", "i64", "i64", "str", "str", "str", "str", "str", "str", "str", "str", "[str]"], "return": "i64", "error": "serveerr"}
  ]
}
