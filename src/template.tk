m=ooke.template;
i=file:std.file;
i=log:std.log;
i=str:std.str;
i=path:std.path;
i=md:std.md;

t=$tokenkind{raw:bool;expr:bool;directive:bool;comment:bool};

t=$token{
  kind:$tokenkind;
  content:$str
};

t=$tplerr{msg:$str};

t=$block{
  name:$str;
  content:$str
};

t=$tplcache{entries:@($str:@$token)};

t=$renderresult{output:$str;cache:$tplcache};

f=tplescape(s:$str):$str{
  let s1=str.replace(s;"&";"&amp;");
  let s2=str.replace(s1;"<";"&lt;");
  let s3=str.replace(s2;">";"&gt;");
  let s4=str.replace(s3;"\"";"&quot;");
  let s5=str.replace(s4;"'";"&#39;");
  <s5
};

f=tplapplyfilter(val:$str;filtername:$str):$str{
  let fname=str.trim(filtername);
  if(fname=="md"){
    <md.render(val)
  }el{
    if(fname=="raw"){
      <val
    }el{
      if(fname=="escape"){
        <tplescape(val)
      }el{
        if(fname=="upper"){
          <tplescape(str.upper(val))
        }el{
          if(fname=="lower"){
            <tplescape(str.lower(val))
          }el{
            if(fname=="trim"){
              <tplescape(str.trim(val))
            }el{
              <tplescape(val)
            }
          }
        }
      }
    }
  }
};

f=tplresolveexpr(expr:$str;ctx:@($str:$str)):$str{
  let trimmed=str.trim(expr);
  let pipepos=str.indexof(trimmed;"|");
  if(!(pipepos<0)){
    let key=str.trim(mt str.slice(trimmed;0;pipepos) {$ok:v v;$err:e trimmed});
    let filter=str.trim(mt str.slice(trimmed;pipepos+1;str.len(trimmed)) {$ok:v v;$err:e ""});
    let vgot=ctx.get(key);
    let val=mt vgot {$ok:v v;$err:e ""};
    <tplapplyfilter(val;filter)
  }el{
    let vgot2=ctx.get(trimmed);
    let raw=mt vgot2 {$ok:v v;$err:e ""};
    <tplescape(raw)
  }
};

f=tpllex(src:$str):@$token!$tplerr{
  let tokens=mut.@();
  let remaining=mut.src;

  let rawkind=$tokenkind{raw:true;expr:false;directive:false;comment:false};
  let exprkind=$tokenkind{raw:false;expr:true;directive:false;comment:false};
  let dirkind=$tokenkind{raw:false;expr:false;directive:true;comment:false};
  let cmtkind=$tokenkind{raw:false;expr:false;directive:false;comment:true};

  let running=mut.true;
  lp(let ii=0;running;ii=ii+1){
    let rem=remaining;
    let rlen=str.len(rem);
    if(rlen==0){
      running=false
    }el{
      let posexpr=str.indexof(rem;"{=");
      let posdir=str.indexof(rem;"{!");
      let poscmt=str.indexof(rem;"{#");

      let bestpos=mut.-1;
      let besttype=mut."none";

      if(!(posexpr<0)){
        if(bestpos<0||posexpr<bestpos){
          bestpos=posexpr;
          besttype="expr"
        }el{}
      }el{};
      if(!(posdir<0)){
        if(bestpos<0||posdir<bestpos){
          bestpos=posdir;
          besttype="dir"
        }el{}
      }el{};
      if(!(poscmt<0)){
        if(bestpos<0||poscmt<bestpos){
          bestpos=poscmt;
          besttype="cmt"
        }el{}
      }el{};

      if(bestpos<0){
        let tok=$token{kind:rawkind;content:rem};
        tokens=tokens.append(tok);
        remaining="";
        running=false
      }el{
        if(bestpos>0){
          let rawcontent=mt str.slice(rem;0;bestpos) {$ok:v v;$err:e ""};
          let rawtok=$token{kind:rawkind;content:rawcontent};
          tokens=tokens.append(rawtok)
        }el{};

        let afteropen=mt str.slice(rem;bestpos+2;rlen) {$ok:v v;$err:e ""};

        let closedelim=if(besttype=="expr"){"=}"}el if(besttype=="dir"){"!}"}el{"#}"};

        let closepos=str.indexof(afteropen;closedelim);
        if(closepos<0){
          let rawtok=$token{kind:rawkind;content:rem};
          tokens=tokens.append(rawtok);
          remaining="";
          running=false
        }el{
          let inner=mt str.slice(afteropen;0;closepos) {$ok:v v;$err:e ""};
          let afterclose=mt str.slice(afteropen;closepos+2;str.len(afteropen)) {$ok:v v;$err:e ""};

          if(besttype=="expr"){
            let tok=$token{kind:exprkind;content:inner};
            tokens=tokens.append(tok)
          }el{
            if(besttype=="dir"){
              let tok=$token{kind:dirkind;content:inner};
              tokens=tokens.append(tok)
            }el{
              let tok=$token{kind:cmtkind;content:inner};
              tokens=tokens.append(tok)
            }
          };

          remaining=afterclose
        }
      }
    }
  };
  <tokens
};

f=tpldirectivename(content:$str):$str{
  let trimmed=str.trim(content);
  let paren=str.indexof(trimmed;"(");
  if(!(paren<0)){
    <mt str.slice(trimmed;0;paren) {$ok:v v;$err:e trimmed}
  }el{
    <trimmed
  }
};

f=tpldirectivearg(content:$str):$str{
  let trimmed=str.trim(content);
  let open=str.indexof(trimmed;"(");
  if(open<0){
    <""
  }el{
    let afteropen=mt str.slice(trimmed;open+1;str.len(trimmed)) {$ok:v v;$err:e ""};
    let close=str.indexof(afteropen;")");
    if(close<0){
      <""
    }el{
      let raw=mt str.slice(afteropen;0;close) {$ok:v v;$err:e ""};
      let t=str.trim(raw);
      let tlen=str.len(t);
      if(tlen>1){
        let first=mt str.slice(t;0;1) {$ok:v v;$err:e ""};
        let last=mt str.slice(t;tlen-1;tlen) {$ok:v v;$err:e ""};
        if(first=="\""&&last=="\""){
          <mt str.slice(t;1;tlen-1) {$ok:v v;$err:e t}
        }el{
          <t
        }
      }el{
        <t
      }
    }
  }
};

f=tplfindblock(blocks:@$block;name:$str):$str{
  lp(let i=0;i<blocks.len;i=i+1){
    let b=blocks.get(i);
    if(b.name==name){
      <b.content
    }el{}
  };
  <""
};

f=tplislandparse(content:$str):@($str:$str){
  let trimmed=str.trim(content);
  let open=str.indexof(trimmed;"(");
  if(open<0){
    <@("name":"";"hydrate":"load")
  }el{
    let afteropen=mt str.slice(trimmed;open+1;str.len(trimmed)) {$ok:v v;$err:e ""};
    let close=str.indexof(afteropen;")");
    let inner=mt str.slice(afteropen;0;close) {$ok:v v;$err:e afteropen};
    let q1=str.indexof(inner;"\"");
    if(q1<0){
      <@("name":"";"hydrate":"load")
    }el{
      let afterq1=mt str.slice(inner;q1+1;str.len(inner)) {$ok:v v;$err:e ""};
      let q2=str.indexof(afterq1;"\"");
      if(q2<0){
        <@("name":"";"hydrate":"load")
      }el{
        let iname=mt str.slice(afterq1;0;q2) {$ok:v v;$err:e ""};
        let rest=mt str.slice(afterq1;q2+1;str.len(afterq1)) {$ok:v v;$err:e ""};
        let hpos=str.indexof(rest;"hydrate=\"");
        if(hpos<0){
          <@("name":iname;"hydrate":"load")
        }el{
          let afterh=mt str.slice(rest;hpos+9;str.len(rest)) {$ok:v v;$err:e ""};
          let hclose=str.indexof(afterh;"\"");
          if(hclose<0){
            <@("name":iname;"hydrate":"load")
          }el{
            let hval=mt str.slice(afterh;0;hclose) {$ok:v v;$err:e "load"};
            <@("name":iname;"hydrate":hval)
          }
        }
      }
    }
  }
};

f=tplnameok(name:$str):bool{
  (* 121.57: a partial or layout name is a name inside the templates
     directory, not a path.  `partials/header` is a name; `../x`, `/etc/x`,
     `a/../../x`, `a\x`, `a//b`, `./a` and the empty name are not, because
     each either leaves the directory or is not the one spelling of a file
     in it.  Mirrors toke's layout() rule (121.41), which also forbids '/'
     outright; ooke keeps '/' as the separator for nested template names. *)
  if(str.len(name)==0){<false};
  if(str.contains(name;"\\")){<false};
  if(str.startswith(name;"/")){<false};
  let segs=str.split(name;"/");
  lp(let i=0;i<segs.len;i=i+1){
    let sg=segs.get(i);
    if(str.len(sg)==0||sg=="."||sg==".."){<false}
  };
  <true
};

f=tplnamepath(templatesdir:$str;kind:$str;name:$str):$str!$tplerr{
  if(!tplnameok(name)){
    let m=str.join("";@("template: refused ";kind;" name \"";name;"\": a ";kind;" is named relative to the templates directory (e.g. partials/header), without .., a leading /, a backslash or empty segments"));
    (log.error(m;@()));
    <$tplerr{msg:m}
  }el{};
  <path.join(templatesdir;str.concat(name;".tkt"))
};

f=tplrender(
  tokens:@$token;
  ctx:@($str:$str);
  templatesdir:$str;
  blocks:@$block
):$str!$tplerr{
  (* Story 134.4. Both accumulators were `x=str.concat(x;part)` chains. That
     is the form the Epic 131 catalogue measures as worse-bigO on `str-build-
     loop` -- it copies the whole accumulator on every token, so rendering a
     63 KB page from N tokens copies O(N x 63 KB). The catalogue's canonical
     form is str.builder/str.add/str.build, one growing buffer. 134.3 left
     this site alone because no lint rule covers string-building loops
     (131.64); the macro numbers are what found it. *)
  let buf=str.builder();
  let hasislands=mut.false;

  let inblock=mut.false;
  let currentblockname=mut."";
  let currentblockbuf=mut.str.builder();
  let collectedblocks=mut.@();

  let layoutname=mut."";

  lp(let i=0;i<tokens.len;i=i+1){
    let tok=tokens.get(i);

    if(tok.kind.raw){
      if(inblock){
        str.add(currentblockbuf;tok.content)
      }el{
        str.add(buf;tok.content)
      }
    }el{};

    if(tok.kind.expr){
      let val=tplresolveexpr(tok.content;ctx);
      if(inblock){
        str.add(currentblockbuf;val)
      }el{
        str.add(buf;val)
      }
    }el{};

    if(tok.kind.directive){
      let dname=tpldirectivename(tok.content);
      let darg=tpldirectivearg(tok.content);

      if(dname=="layout"){
        layoutname=darg
      }el{
        if(dname=="block"){
          inblock=true;
          currentblockname=darg;
          currentblockbuf=str.builder()
        }el{
          if(dname=="end"){
            if(inblock){
              let b=$block{name:currentblockname;content:str.build(currentblockbuf)};
              collectedblocks=collectedblocks.append(b);
              inblock=false;
              currentblockname="";
              currentblockbuf=str.builder()
            }el{}
          }el{
            if(dname=="var"){
              let vargot=ctx.get(darg);
              let varraw=mt vargot {$ok:v v;$err:e ""};
              let varval=tplescape(varraw);
              if(inblock){
                str.add(currentblockbuf;varval)
              }el{
                str.add(buf;varval)
              }
            }el{
            if(dname=="yield"){
              let blockcontent=tplfindblock(blocks;darg);
              if(str.len(blockcontent)>0){
                str.add(buf;blockcontent)
              }el{}
            }el{
              if(dname=="partial"){
                let partialpath=tplnamepath(templatesdir;"partial";darg)!$tplerr;
                let psrcr=file.read(partialpath);
                let partialsrc=mt psrcr {$ok:s s;$err:e ""};
                if(str.len(partialsrc)>0){
                  let partialtokens=tpllex(partialsrc)!$tplerr;
                  let partialout=tplrender(partialtokens;ctx;templatesdir;@())!$tplerr;
                  if(inblock){
                    str.add(currentblockbuf;partialout)
                  }el{
                    str.add(buf;partialout)
                  }
                }el{}
              }el{
                if(dname=="island"){
                  let iparse=tplislandparse(tok.content);
                  let inameg=iparse.get("name");
                  let iname=mt inameg {$ok:v v;$err:e ""};
                  let ihydrateg=iparse.get("hydrate");
                  let ihydrate=mt ihydrateg {$ok:v v;$err:e "load"};
                  let idiv=str.join("";@("<div data-island=\"";iname;"\" data-hydrate=\"";ihydrate;"\"></div>"));
                  if(inblock){
                    str.add(currentblockbuf;idiv)
                  }el{
                    str.add(buf;idiv)
                  };
                  hasislands=true
                }el{}
              }
            }
          }
          }
        }
      }
    }el{}
  };

  let islandscript="<script src=\"/static/ooke-islands.js\" defer></script>";

  if(str.len(layoutname)>0){
    let layoutpath=tplnamepath(templatesdir;"layout";layoutname)!$tplerr;
    if(!file.exists(layoutpath)){
      (* 134.24: log where the message exists. A caller cannot read `e.msg` off
         this payload (RT005, toke 127.78, open), so an unlogged $tplerr is a
         message that reaches nobody. *)
      let ml=str.concat("template: no layout template: ";layoutpath);
      (log.error(ml;@()));
      <$tplerr{msg:ml}
    }el{};
    let layoutsrc=file.read(layoutpath)!$tplerr;
    let layouttokens=tpllex(layoutsrc)!$tplerr;
    let layoutout=tplrender(layouttokens;ctx;templatesdir;collectedblocks)!$tplerr;
    if(hasislands){
      <str.concat(layoutout;islandscript)
    }el{
      <layoutout
    }
  }el{
    if(hasislands){
      <str.concat(str.build(buf);islandscript)
    }el{
      <str.build(buf)
    }
  }
};

f=tplrenderfile(
  templatepath:$str;
  ctx:@($str:$str);
  templatesdir:$str
):$str!$tplerr{
  if(!file.exists(templatepath)){
    (* 134.24: see the layout case above — an unlogged $tplerr reaches nobody. *)
    let mt0=str.concat("template: no template file: ";templatepath);
    (log.error(mt0;@()));
    <$tplerr{msg:mt0}
  }el{};
  let src=file.read(templatepath)!$tplerr;
  let tokens=tpllex(src)!$tplerr;
  <tplrender(tokens;ctx;templatesdir;@())!$tplerr
};

f=tplcachenew():$tplcache{
  <$tplcache{entries:@($str:@($token))}
};

f=tplcacheget(
  cache:$tplcache;
  path:$str
):@$token!$tplerr{
  let r=cache.entries.get(path);
  let hit=mt r {$ok:toks true;$err:e false};
  if(hit){
    <mt r {$ok:toks toks;$err:e @()}
  }el{
    let src=file.read(path)!$tplerr;
    <tpllex(src)!$tplerr
  }
};

f=tplrenderfilecached(
  templatepath:$str;
  ctx:@($str:$str);
  templatesdir:$str;
  cache:$tplcache
):$renderresult!$tplerr{
  let r=cache.entries.get(templatepath);
  let hit=mt r {$ok:toks true;$err:e false};
  let tokens=mut.@();
  if(hit){
    tokens=mt r {$ok:toks toks;$err:e @()}
  }el{
    let src=file.read(templatepath)!$tplerr;
    tokens=tpllex(src)!$tplerr
  };
  let newentries=cache.entries.set(templatepath;tokens);
  let newcache=$tplcache{entries:newentries};
  let out=tplrender(tokens;ctx;templatesdir;@())!$tplerr;
  <$renderresult{output:out;cache:newcache}
};
