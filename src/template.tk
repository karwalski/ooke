m=ooke.template;
i=file:std.file;
i=log:std.log;
i=str:std.str;
i=path:std.path;
i=md:std.md;

t=$tokenkind{raw:bool;expr:bool;directive:bool;comment:bool};

t=$token{
  kind:$tokenkind;
  content:$str
};

t=$tplerr{msg:$str};

(* A block's tokens, not its rendered text (121.58): a block is rendered
   where the layout yields it, so its values are escaped for that place. *)
t=$block{
  name:$str;
  toks:@$token
};

(* HTML context tracker state; see hcfeed. *)
t=$hc{st:i64;closing:i64;tagel:i64;rawel:i64;rname:$str;name:$str;nover:i64;ak:i64;quote:i64;vlen:i64;urlpart:i64;js:i64;css:i64;esc:i64;slash:i64;star:i64;dashes:i64;mcount:i64;endlen:i64};

(* One render's output, the tracker state after it, and whether it held an
   island directive (the islands script is appended once, at the top). *)
t=$rout{text:$str;hc:$hc;islands:bool};

t=$tplcache{entries:@($str:@$token)};

t=$renderresult{output:$str;cache:$tplcache};

f=tplescape(s:$str):$str{
  let s1=str.replace(s;"&";"&amp;");
  let s2=str.replace(s1;"<";"&lt;");
  let s3=str.replace(s2;">";"&gt;");
  let s4=str.replace(s3;"\"";"&quot;");
  let s5=str.replace(s4;"'";"&#39;");
  <s5
};

(* ── HTML context tracker (story 121.58) ────────────────────────────────
   A port of toke's src/stdlib/template.c tracker (121.37, be8086d0) so that
   ooke's {= x =} is escaped for the place in the HTML where it lands, not
   with one HTML-body escaper everywhere.  Every byte of output -- template
   text, escaped values and |raw / |md values -- is fed through hcfeed, and
   ctxescape picks the escaper from the state it leaves:

     text, comment, <title>, <textarea>   & < > " ' as entities
     quoted attribute value               the same entities
     unquoted attribute value             every byte but [A-Za-z0-9] as &#N;
     URL attribute, at the value start    scheme other than http/https/mailto
                                          -> "#ZtokeZ"; else percent-encoded
     URL attribute after ? or #           percent-encoded as a component
     <script>, on* attribute              in a string/comment: \u00HH;
                                          in code: a quoted "..." literal
     <style>, style attribute             in a string/comment: \HH ;
                                          in code: [A-Za-z0-9 #%.,_-] only,
                                          else "ZtokeZ"
     tag or attribute name                [A-Za-z0-9_-] naming a plain
                                          attribute, else "ZtokeZ"

   Numeric encodings (template.c's enums, in the same order):
     st   0 text 1 tagopen 2 endtagopen 3 tagname 4 intag 5 attrname
          6 afterattrname 7 beforevalue 8 value 9 markup 10 comment
          11 rawtext
     ak   0 normal 1 url 2 js 3 css
     tagel 0 none 1 script 2 style 3 rcdata (title, textarea)
     js   0 code 1 "..." 2 '...' 3 `...` 4 // 5 /* */
     css  0 code 1 "..." 2 '...' 3 /* */
   The JS and CSS sub-machines are pure functions over a packed i64
   (mode | esc<<3 | slash<<4 | star<<5) so hcfeed allocates nothing per byte.

   Limits, as in toke: character references written in the template inside
   an attribute are not decoded, and JS regular-expression literals are not
   recognised.  Either can only mislead the tracker about being inside a
   string; every JS/CSS escaper's output holds no quote, slash, star, newline
   or angle bracket, so a mis-tracked value comes out as wrong text, not code. *)

f=hcnew():$hc{
  <$hc{st:0;closing:0;tagel:0;rawel:0;rname:"";name:"";nover:0;ak:0;quote:0;vlen:0;urlpart:0;js:0;css:0;esc:0;slash:0;star:0;dashes:0;mcount:0;endlen:0}
};

f=hcspace(c:i64):bool{
  <c==32||c==9||c==10||c==13||c==12
};

f=hcalpha(c:i64):bool{
  <(c>96&&c<123)||(c>64&&c<91)
};

f=hcalnum(c:i64):bool{
  <hcalpha(c)||(c>47&&c<58)
};

f=hcpack(m:i64;e:i64;sl:i64;sr:i64):i64{
  <m|(e<<3)|(sl<<4)|(sr<<5)
};

f=hcjs(p:i64;c:i64):i64{
  let js=p&7;
  let esc=(p>>3)&1;
  let slash=(p>>4)&1;
  let star=(p>>5)&1;
  if(js==0){
    if(slash==1&&c==47){<hcpack(4;esc;0;star)};
    if(slash==1&&c==42){<hcpack(5;esc;0;0)};
    let sl=if(c==47){1}el{0};
    let m=if(c==34){1}el if(c==39){2}el if(c==96){3}el{0};
    <hcpack(m;0;sl;star)
  }el{};
  if(js<4){
    if(esc==1){<hcpack(js;0;slash;star)};
    if(c==92){<hcpack(js;1;slash;star)};
    let q=if(js==1){34}el if(js==2){39}el{96};
    let m=if(c==q||(c==10&&js!=3)){0}el{js};
    <hcpack(m;esc;0;star)
  }el{};
  if(js==4){
    let m=if(c==10){0}el{4};
    <hcpack(m;esc;slash;star)
  }el{};
  if(star==1&&c==47){<hcpack(0;esc;0;0)};
  let sr=if(c==42){1}el{0};
  <hcpack(5;esc;slash;sr)
};

f=hccss(p:i64;c:i64):i64{
  let css=p&7;
  let esc=(p>>3)&1;
  let slash=(p>>4)&1;
  let star=(p>>5)&1;
  if(css==0){
    if(slash==1&&c==42){<hcpack(3;esc;0;0)};
    let sl=if(c==47){1}el{0};
    let m=if(c==34){1}el if(c==39){2}el{0};
    <hcpack(m;0;sl;star)
  }el{};
  if(css<3){
    if(esc==1){<hcpack(css;0;slash;star)};
    if(c==92){<hcpack(css;1;slash;star)};
    let q=if(css==1){34}el{39};
    let m=if(c==q||c==10){0}el{css};
    <hcpack(m;esc;slash;star)
  }el{};
  if(star==1&&c==47){<hcpack(0;esc;slash;0)};
  let sr=if(c==42){1}el{0};
  <hcpack(3;esc;slash;sr)
};

f=hcelemkind(n:$str;over:i64):i64{
  if(over==1){<0};
  if(n=="script"){<1};
  if(n=="style"){<2};
  if(n=="title"||n=="textarea"){<3};
  <0
};

f=hcattrkind(n:$str;over:i64):i64{
  if(str.startswith(n;"on")){<2};
  if(over==1){<0};
  if(n=="style"){<3};
  let urls=@("href";"src";"action";"formaction";"cite";"data";"poster";"background";"codebase";"longdesc";"usemap";"manifest";"icon";"profile";"classid";"archive";"srcset";"ping";"lowsrc";"dynsrc";"xlink:href";"xmlns");
  lp(let i=0;i<urls.len;i=i+1){
    if(urls.get(i)==n){<1}
  };
  if(str.contains(n;"url")||str.contains(n;"uri")){<1};
  <0
};

(* Feed s through the tracker; returns the state after its last byte. *)
f=hcfeed(h:$hc;s:$str):$hc{
  let st=mut.h.st;
  let closing=mut.h.closing;
  let tagel=mut.h.tagel;
  let rawel=mut.h.rawel;
  let rname=mut.h.rname;
  let name=mut.h.name;
  let nover=mut.h.nover;
  let ak=mut.h.ak;
  let quote=mut.h.quote;
  let vlen=mut.h.vlen;
  let urlpart=mut.h.urlpart;
  let js=mut.h.js;
  let css=mut.h.css;
  let esc=mut.h.esc;
  let slash=mut.h.slash;
  let star=mut.h.star;
  let dashes=mut.h.dashes;
  let mcount=mut.h.mcount;
  let endlen=mut.h.endlen;
  let n=str.len(s);
  lp(let i=0;i<n;i=i+1){
    let c=str.charat(s;i);
    let sp=hcspace(c);
    let tagend=mut.false;
    let attrstart=mut.false;
    let vstart=mut.false;
    let vbyte=mut.false;
    let nameadd=mut.false;
    if(st==0){
      if(c==60){st=1}el{}
    }el if(st==1){
      if(hcalpha(c)){
        closing=0;name="";nover=0;nameadd=true;st=3
      }el if(c==47){
        st=2
      }el if(c==33||c==63){
        st=9;dashes=0;mcount=if(c==63){2}el{0}
      }el if(c==60){
        st=1
      }el{
        st=0
      }
    }el if(st==2){
      if(hcalpha(c)){
        closing=1;name="";nover=0;nameadd=true;st=3
      }el if(c==62){
        st=0
      }el{
        st=9;mcount=2;dashes=0
      }
    }el if(st==3){
      if(sp||c==47){
        tagel=if(closing==1){0}el{hcelemkind(name;nover)};st=4
      }el if(c==62){
        tagel=if(closing==1){0}el{hcelemkind(name;nover)};tagend=true
      }el{
        nameadd=true
      }
    }el if(st==4){
      if(sp||c==47){}el if(c==62){tagend=true}el{attrstart=true}
    }el if(st==5){
      if(sp){
        ak=hcattrkind(name;nover);st=6
      }el if(c==61){
        ak=hcattrkind(name;nover);st=7
      }el if(c==47){
        st=4
      }el if(c==62){
        tagend=true
      }el{
        nameadd=true
      }
    }el if(st==6){
      if(sp){}el if(c==61){st=7}el if(c==47){st=4}el if(c==62){tagend=true}el{attrstart=true}
    }el if(st==7){
      if(sp){}el if(c==34||c==39){vstart=true;quote=c}el if(c==62){tagend=true}el{vstart=true;quote=0;vbyte=true}
    }el if(st==8){
      let closes=if(quote!=0){c==quote}el{sp};
      if(closes){st=4}el if(quote==0&&c==62){tagend=true}el{vbyte=true}
    }el if(st==9){
      (* "<!--" opens a comment; any other "<!" or "<?" runs to '>' *)
      let mdone=mut.false;
      if(mcount<2){
        mcount=mcount+1;
        if(c==45){
          if(mcount==2){st=10;dashes=0}el{};
          mdone=true
        }el{
          mcount=2
        }
      }el{};
      if(!mdone&&c==62){st=0}el{}
    }el if(st==10){
      if(c==62&&dashes>1){st=0}el{dashes=if(c==45){dashes+1}el{0}}
    }el{
      (* RAWTEXT: "</name" followed by space, '/' or '>' ends the element even
         inside a JS string -- that is how HTML parses it. *)
      let wlen=str.len(rname);
      let rdone=mut.false;
      if(endlen==2+wlen){
        endlen=0;
        if(sp||c==47){
          st=4;closing=1;tagel=0;rawel=0;rdone=true
        }el if(c==62){
          st=0;rawel=0;rdone=true
        }el{}
      }el{};
      if(!rdone){
        let lcc=if(c>64&&c<91){c+32}el{c};
        if(c==60){
          endlen=1
        }el if(endlen==1&&c==47){
          endlen=2
        }el if(endlen>1&&lcc==str.charat(rname;endlen-2)){
          endlen=endlen+1
        }el{
          endlen=0
        };
        if(rawel==1){
          let r=hcjs(hcpack(js;esc;slash;star);c);
          js=r&7;esc=(r>>3)&1;slash=(r>>4)&1;star=(r>>5)&1
        }el if(rawel==2){
          let r2=hccss(hcpack(css;esc;slash;star);c);
          css=r2&7;esc=(r2>>3)&1;slash=(r2>>4)&1;star=(r2>>5)&1
        }el{}
      }el{}
    };
    if(attrstart){name="";nover=0;nameadd=true;st=5}el{};
    if(nameadd){
      if(str.len(name)<31){
        let one=mt str.slice(s;i;i+1) {$ok:v v;$err:e ""};
        name=str.concat(name;str.lower(one))
      }el{
        nover=1
      }
    }el{};
    if(tagend){
      if(closing==0&&tagel!=0){
        st=11;rawel=tagel;endlen=0;rname=name;js=0;css=0;esc=0;slash=0;star=0
      }el{
        st=0
      };
      tagel=0;closing=0
    }el{};
    if(vstart){st=8;vlen=0;urlpart=0;js=0;css=0;esc=0;slash=0;star=0}el{};
    if(vbyte){
      if(vlen==0&&sp){}el{
        vlen=vlen+1;
        if(ak==1&&(c==63||c==35)){
          urlpart=1
        }el if(ak==2){
          let r3=hcjs(hcpack(js;esc;slash;star);c);
          js=r3&7;esc=(r3>>3)&1;slash=(r3>>4)&1;star=(r3>>5)&1
        }el if(ak==3){
          let r4=hccss(hcpack(css;esc;slash;star);c);
          css=r4&7;esc=(r4>>3)&1;slash=(r4>>4)&1;star=(r4>>5)&1
        }el{}
      }
    }el{}
  };
  <$hc{st:st;closing:closing;tagel:tagel;rawel:rawel;rname:rname;name:name;nover:nover;ak:ak;quote:quote;vlen:vlen;urlpart:urlpart;js:js;css:css;esc:esc;slash:slash;star:star;dashes:dashes;mcount:mcount;endlen:endlen}
};

(* ── escapers ─────────────────────────────────────────────────────────── *)

f=hchexdigit(d:i64):$str{
  <mt str.slice("0123456789ABCDEF";d;d+1) {$ok:v v;$err:e "0"}
};

f=hchex2(c:i64):$str{
  <str.concat(hchexdigit((c>>4)&15);hchexdigit(c&15))
};

(* Which bytes pass unchanged.  mode 1 unquoted attribute, 2 JS string body,
   3 CSS string body, 4 URL, 5 URL component (after ? or #). *)
f=esckeep(mode:i64;c:i64):bool{
  if(hcalnum(c)){<true};
  if(mode==1){<c>127};
  if(mode==2){<c>127||c==32||c==95||c==44||c==46};
  if(mode==3){<c>127||c==32};
  if(c==45||c==46||c==95||c==126){<true};
  if(mode==5){<false};
  (* : / ? # [ ] @ ! $ & ' ( ) * + , ; = % *)
  <c==58||c==47||c==63||c==35||c==91||c==93||c==64||c==33||c==36||c==38||c==39||c==40||c==41||c==42||c==43||c==44||c==59||c==61||c==37
};

f=escrepl(mode:i64;c:i64):$str{
  if(mode==1){<str.join("";@("&#";str.fromint(c);";"))};
  if(mode==2){<str.concat("\\u00";hchex2(c))};
  if(mode==3){
    if(c<16){<str.join("";@("\\";hchexdigit(c);" "))};
    <str.join("";@("\\";hchex2(c);" "))
  };
  <str.concat("%";hchex2(c))
};

f=escbytes(s:$str;mode:i64):$str{
  let b=str.builder();
  let n=str.len(s);
  let run=mut.0;
  let skip=mut.0;
  lp(let i=0;i<n;i=i+1){
    if(skip>0){
      skip=skip-1
    }el{
      let c=str.charat(s;i);
      (* U+2028 / U+2029 (E2 80 A8/A9) end a line in pre-2019 JS strings *)
      let ls=mode==2&&c==226&&str.charat(s;i+1)==128&&(str.charat(s;i+2)==168||str.charat(s;i+2)==169);
      if(ls){
        if(i>run){str.add(b;mt str.slice(s;run;i) {$ok:v v;$err:e ""})}el{};
        str.add(b;if(str.charat(s;i+2)==168){"\\u2028"}el{"\\u2029"});
        skip=2;
        run=i+3
      }el if(esckeep(mode;c)){}el{
        if(i>run){str.add(b;mt str.slice(s;run;i) {$ok:v v;$err:e ""})}el{};
        str.add(b;escrepl(mode;c));
        run=i+1
      }
    }
  };
  if(n>run){str.add(b;mt str.slice(s;run;n) {$ok:v v;$err:e ""})}el{};
  <str.build(b)
};

f=escjs(js:i64;s:$str):$str{
  if(js==0){<str.join("";@("\"";escbytes(s;2);"\""))};
  <escbytes(s;2)
};

f=esccss(css:i64;s:$str):$str{
  if(css==0){
    let n=str.len(s);
    lp(let i=0;i<n;i=i+1){
      let c=str.charat(s;i);
      let ok=hcalnum(c)||c>127||c==32||c==35||c==37||c==46||c==44||c==95||c==45;
      if(!ok){<"ZtokeZ"}
    };
    <s
  };
  <escbytes(s;3)
};

f=escurl(vlen:i64;urlpart:i64;s:$str):$str{
  if(vlen==0&&urlpart==0){
    (* the value starts here, so the scheme is decided here *)
    let n=str.len(s);
    let p=mut.0;
    lp(let k=0;p<n&&hcspace(str.charat(s;p));k=k+1){p=p+1};
    let i=mut.p;
    let scanning=mut.true;
    lp(let k2=0;scanning;k2=k2+1){
      if(!(i<n)){
        scanning=false
      }el{
        let c=str.charat(s;i);
        if(c==58||c==47||c==63||c==35){scanning=false}el{i=i+1}
      }
    };
    if(i<n&&str.charat(s;i)==58){
      let scheme=str.lower(mt str.slice(s;p;i) {$ok:v v;$err:e ""});
      if(!(scheme=="http"||scheme=="https"||scheme=="mailto")){<"#ZtokeZ"}
    }
  };
  if(urlpart==1){<escbytes(s;5)};
  <escbytes(s;4)
};

f=escname(s:$str):$str{
  let n=str.len(s);
  if(n==0||n>31){<"ZtokeZ"};
  lp(let i=0;i<n;i=i+1){
    let c=str.charat(s;i);
    if(!(hcalnum(c)||c==45||c==95)){<"ZtokeZ"}
  };
  if(hcattrkind(str.lower(s);0)!=0){<"ZtokeZ"};
  <s
};

(* Escape one value for the context the output is in. *)
f=ctxescape(h:$hc;v:$str):$str{
  let st=h.st;
  if(st==0||st==9||st==10){<tplescape(v)};
  if(st==11){
    if(h.rawel==1){<escjs(h.js;v)};
    if(h.rawel==2){<esccss(h.css;v)};
    <tplescape(v)
  };
  if(st<7){<escname(v)};
  (* 7: the value starts an unquoted attribute value; 8: inside a value *)
  let fresh=st==7;
  let quote=if(fresh){0}el{h.quote};
  let vlen=if(fresh){0}el{h.vlen};
  let urlpart=if(fresh){0}el{h.urlpart};
  let js=if(fresh){0}el{h.js};
  let css=if(fresh){0}el{h.css};
  let inner=if(h.ak==1){escurl(vlen;urlpart;v)}el if(h.ak==2){escjs(js;v)}el if(h.ak==3){esccss(css;v)}el{v};
  if(quote!=0){<tplescape(inner)};
  <escbytes(inner;1)
};

(* ── values ──────────────────────────────────────────────────────────── *)

(* A filtered value for the context h.  |md and |raw write their output
   unchanged (md is HTML ooke produced; raw is the explicit opt-out); every
   other filter -- escape, upper, lower, trim, or an unknown name -- is
   escaped for the context after it is applied. *)
f=tplfilterctx(val:$str;filtername:$str;h:$hc):$str{
  let fname=str.trim(filtername);
  if(fname=="md"){<md.render(val)};
  if(fname=="raw"){<val};
  let v=if(fname=="upper"){str.upper(val)}el if(fname=="lower"){str.lower(val)}el if(fname=="trim"){str.trim(val)}el{val};
  <ctxescape(h;v)
};

f=tplexprctx(expr:$str;ctx:@($str:$str);h:$hc):$str{
  let trimmed=str.trim(expr);
  let pipepos=str.indexof(trimmed;"|");
  if(!(pipepos<0)){
    let key=str.trim(mt str.slice(trimmed;0;pipepos) {$ok:v v;$err:e trimmed});
    let filter=str.trim(mt str.slice(trimmed;pipepos+1;str.len(trimmed)) {$ok:v v;$err:e ""});
    let vgot=ctx.get(key);
    let val=mt vgot {$ok:v v;$err:e ""};
    <tplfilterctx(val;filter;h)
  }el{
    let vgot2=ctx.get(trimmed);
    let raw=mt vgot2 {$ok:v v;$err:e ""};
    <ctxescape(h;raw)
  }
};

(* The HTML-text forms, kept for callers outside a template render. *)
f=tplapplyfilter(val:$str;filtername:$str):$str{
  <tplfilterctx(val;filtername;hcnew())
};

f=tplresolveexpr(expr:$str;ctx:@($str:$str)):$str{
  <tplexprctx(expr;ctx;hcnew())
};

f=tpllex(src:$str):@$token!$tplerr{
  (* 127.257: scans src by index.  It used to keep the unscanned tail as a
     string and re-slice it twice per tag (the text after the opener, then
     the text after the closer), so every tag copied the rest of the
     template: a 70 KB page with 104 tags allocated 7.4 MB per lex, and
     nothing frees it.  Now each token's text is the one slice it needs, and
     the next position of each opener is searched again only once the scan
     has passed it.  The tokens produced are unchanged, including the
     unclosed-tag case (127.271). *)
  let tokens=mut.@();
  let n=str.len(src);
  let pos=mut.0;

  let rawkind=$tokenkind{raw:true;expr:false;directive:false;comment:false};
  let exprkind=$tokenkind{raw:false;expr:true;directive:false;comment:false};
  let dirkind=$tokenkind{raw:false;expr:false;directive:true;comment:false};
  let cmtkind=$tokenkind{raw:false;expr:false;directive:false;comment:true};

  (* next opener at or after pos; -1 = none left.  -2 = not searched yet *)
  let nexpr=mut.-2;
  let ndir=mut.-2;
  let ncmt=mut.-2;

  let running=mut.true;
  lp(let ii=0;running;ii=ii+1){
    if(pos>=n){
      running=false
    }el{
      if(nexpr==-2||(nexpr>=0&&nexpr<pos)){nexpr=str.indexfrom(src;"{=";pos)}el{};
      if(ndir==-2||(ndir>=0&&ndir<pos)){ndir=str.indexfrom(src;"{!";pos)}el{};
      if(ncmt==-2||(ncmt>=0&&ncmt<pos)){ncmt=str.indexfrom(src;"{#";pos)}el{};

      let bestpos=mut.-1;
      let besttype=mut."none";

      if(!(nexpr<0)){
        if(bestpos<0||nexpr<bestpos){
          bestpos=nexpr;
          besttype="expr"
        }el{}
      }el{};
      if(!(ndir<0)){
        if(bestpos<0||ndir<bestpos){
          bestpos=ndir;
          besttype="dir"
        }el{}
      }el{};
      if(!(ncmt<0)){
        if(bestpos<0||ncmt<bestpos){
          bestpos=ncmt;
          besttype="cmt"
        }el{}
      }el{};

      if(bestpos<0){
        let rest=mt str.slice(src;pos;n) {$ok:v v;$err:e ""};
        let tok=$token{kind:rawkind;content:rest};
        tokens=tokens.append(tok);
        pos=n;
        running=false
      }el{
        if(bestpos>pos){
          let rawcontent=mt str.slice(src;pos;bestpos) {$ok:v v;$err:e ""};
          let rawtok=$token{kind:rawkind;content:rawcontent};
          tokens=tokens.append(rawtok)
        }el{};

        let closedelim=if(besttype=="expr"){"=}"}el if(besttype=="dir"){"!}"}el{"#}"};

        let closepos=str.indexfrom(src;closedelim;bestpos+2);
        if(closepos<0){
          let rest=mt str.slice(src;pos;n) {$ok:v v;$err:e ""};
          let rawtok=$token{kind:rawkind;content:rest};
          tokens=tokens.append(rawtok);
          pos=n;
          running=false
        }el{
          let inner=mt str.slice(src;bestpos+2;closepos) {$ok:v v;$err:e ""};

          if(besttype=="expr"){
            let tok=$token{kind:exprkind;content:inner};
            tokens=tokens.append(tok)
          }el{
            if(besttype=="dir"){
              let tok=$token{kind:dirkind;content:inner};
              tokens=tokens.append(tok)
            }el{
              let tok=$token{kind:cmtkind;content:inner};
              tokens=tokens.append(tok)
            }
          };

          pos=closepos+2
        }
      }
    }
  };
  <tokens
};

f=tpldirectivename(content:$str):$str{
  let trimmed=str.trim(content);
  let paren=str.indexof(trimmed;"(");
  if(!(paren<0)){
    <mt str.slice(trimmed;0;paren) {$ok:v v;$err:e trimmed}
  }el{
    <trimmed
  }
};

f=tpldirectivearg(content:$str):$str{
  let trimmed=str.trim(content);
  let open=str.indexof(trimmed;"(");
  if(open<0){
    <""
  }el{
    let afteropen=mt str.slice(trimmed;open+1;str.len(trimmed)) {$ok:v v;$err:e ""};
    let close=str.indexof(afteropen;")");
    if(close<0){
      <""
    }el{
      let raw=mt str.slice(afteropen;0;close) {$ok:v v;$err:e ""};
      let t=str.trim(raw);
      let tlen=str.len(t);
      if(tlen>1){
        let first=mt str.slice(t;0;1) {$ok:v v;$err:e ""};
        let last=mt str.slice(t;tlen-1;tlen) {$ok:v v;$err:e ""};
        if(first=="\""&&last=="\""){
          <mt str.slice(t;1;tlen-1) {$ok:v v;$err:e t}
        }el{
          <t
        }
      }el{
        <t
      }
    }
  }
};

(* 138.29: the directives tplrenderctx implements. Any other name is a
   $tplerr there, not a silent no-op. *)
f=tpldirectiveknown(name:$str):bool{
  <name=="layout"||name=="block"||name=="end"||name=="var"||name=="yield"||name=="partial"||name=="island"
};

f=tplfindblock(blocks:@$block;name:$str):@$token{
  lp(let i=0;i<blocks.len;i=i+1){
    let b=blocks.get(i);
    if(b.name==name){
      <b.toks
    }el{}
  };
  <@()
};

f=tplislandparse(content:$str):@($str:$str){
  let trimmed=str.trim(content);
  let open=str.indexof(trimmed;"(");
  if(open<0){
    <@("name":"";"hydrate":"load")
  }el{
    let afteropen=mt str.slice(trimmed;open+1;str.len(trimmed)) {$ok:v v;$err:e ""};
    let close=str.indexof(afteropen;")");
    let inner=mt str.slice(afteropen;0;close) {$ok:v v;$err:e afteropen};
    let q1=str.indexof(inner;"\"");
    if(q1<0){
      <@("name":"";"hydrate":"load")
    }el{
      let afterq1=mt str.slice(inner;q1+1;str.len(inner)) {$ok:v v;$err:e ""};
      let q2=str.indexof(afterq1;"\"");
      if(q2<0){
        <@("name":"";"hydrate":"load")
      }el{
        let iname=mt str.slice(afterq1;0;q2) {$ok:v v;$err:e ""};
        let rest=mt str.slice(afterq1;q2+1;str.len(afterq1)) {$ok:v v;$err:e ""};
        let hpos=str.indexof(rest;"hydrate=\"");
        if(hpos<0){
          <@("name":iname;"hydrate":"load")
        }el{
          let afterh=mt str.slice(rest;hpos+9;str.len(rest)) {$ok:v v;$err:e ""};
          let hclose=str.indexof(afterh;"\"");
          if(hclose<0){
            <@("name":iname;"hydrate":"load")
          }el{
            let hval=mt str.slice(afterh;0;hclose) {$ok:v v;$err:e "load"};
            <@("name":iname;"hydrate":hval)
          }
        }
      }
    }
  }
};

f=tplnameok(name:$str):bool{
  (* 121.57: a partial or layout name is a name inside the templates
     directory, not a path.  `partials/header` is a name; `../x`, `/etc/x`,
     `a/../../x`, `a\x`, `a//b`, `./a` and the empty name are not, because
     each either leaves the directory or is not the one spelling of a file
     in it.  Mirrors toke's layout() rule (121.41), which also forbids '/'
     outright; ooke keeps '/' as the separator for nested template names. *)
  if(str.len(name)==0){<false};
  if(str.contains(name;"\\")){<false};
  if(str.startswith(name;"/")){<false};
  let segs=str.split(name;"/");
  lp(let i=0;i<segs.len;i=i+1){
    let sg=segs.get(i);
    if(str.len(sg)==0||sg=="."||sg==".."){<false}
  };
  <true
};

f=tplnamepath(templatesdir:$str;kind:$str;name:$str):$str!$tplerr{
  if(!tplnameok(name)){
    let m=str.join("";@("template: refused ";kind;" name \"";name;"\": a ";kind;" is named relative to the templates directory (e.g. partials/header), without .., a leading /, a backslash or empty segments"));
    (log.error(m;@()));
    <$tplerr{msg:m}
  }el{};
  let joined=path.join(templatesdir;str.concat(name;".tkt"));
  (* 121.59 (3): the name rule above is lexical, so it cannot see a symlinked
     directory (or file) inside templates/ that points outside it.  Resolve the
     path and the templates root with file.realpath (toke 121.60) and require
     the one to be inside the other: the root plus a separator, not a bare
     prefix, so templates2/ is not inside templates/.  A symlink whose target
     stays inside templates/ keeps working, and the resolved path is what is
     read, so what was checked is what is opened.  A name that does not exist
     is returned unresolved: the caller reports it as missing, as before. *)
  if(!file.exists(joined)){<joined}el{};
  let root=mt file.realpath(templatesdir) {$ok:t t;$err:e ""};
  let real=mt file.realpath(joined) {$ok:t t;$err:e ""};
  let inside=str.len(root)>0&&str.len(real)>0&&str.startswith(real;str.concat(root;"/"));
  if(!inside){
    let mo=str.join("";@("template: refused ";kind;" name \"";name;"\": it resolves outside the templates directory (a symlink inside templates/ may only point within it)"));
    (log.error(mo;@()));
    <$tplerr{msg:mo}
  }el{};
  <real
};

f=tplrenderctx(
  tokens:@$token;
  ctx:@($str:$str);
  templatesdir:$str;
  blocks:@$block;
  hc0:$hc;
  depth:i64
):$rout!$tplerr{
  (* 121.58: renders tokens as a continuation of output whose HTML context
     is hc0, and returns the context after its own output.  Partials and
     yielded blocks are rendered through here with the current context, so
     their values are escaped for where they land in the page.  depth bounds
     partial/layout/yield nesting: a template that includes itself was
     unbounded recursion. *)
  if(depth>32){
    let md0="template: partials, layouts and yields nest more than 32 deep (does a template include itself?)";
    (log.error(md0;@()));
    <$tplerr{msg:md0}
  }el{};
  (* Story 134.4: one str.builder per render, not a str.concat chain. *)
  let buf=str.builder();
  let hc=mut.hc0;
  let hasislands=mut.false;

  let inblock=mut.false;
  let blockname=mut."";
  let blocktoks=mut.@();
  let collectedblocks=mut.@();

  let layoutname=mut."";

  lp(let i=0;i<tokens.len;i=i+1){
    let tok=tokens.get(i);
    let isend=tok.kind.directive&&tpldirectivename(tok.content)=="end";

    (* 138.29: a directive this engine does not know is an error, whether or
       not it sits inside a block. It used to be dropped (the dispatch below
       ended in `}el{}`), so a typo -- `{! endblock !}`, `{! frobnicate !}` --
       rendered as nothing with $ok and no log. It is checked here, before
       block collection, so a typo inside a block is reported even when no
       layout yields that block. *)
    if(tok.kind.directive){
      let kname=tpldirectivename(tok.content);
      if(!tpldirectiveknown(kname)){
        let mu=str.join("";@("template: unknown directive \"";kname;"\" (known: layout, block, end, var, yield, partial, island)"));
        (log.error(mu;@()));
        <$tplerr{msg:mu}
      }el{}
    }el{};

    if(inblock&&!isend){
      (* inside a block: keep the tokens, render them where they are yielded *)
      blocktoks=blocktoks.append(tok)
    }el{
      if(tok.kind.raw){
        str.add(buf;tok.content);
        hc=hcfeed(hc;tok.content)
      }el{};

      if(tok.kind.expr){
        let val=tplexprctx(tok.content;ctx;hc);
        str.add(buf;val);
        hc=hcfeed(hc;val)
      }el{};

      if(tok.kind.directive){
        let dname=tpldirectivename(tok.content);
        let darg=tpldirectivearg(tok.content);

        if(dname=="layout"){
          layoutname=darg
        }el if(dname=="block"){
          inblock=true;
          blockname=darg;
          blocktoks=@()
        }el if(dname=="end"){
          if(inblock){
            let b=$block{name:blockname;toks:blocktoks};
            collectedblocks=collectedblocks.append(b);
            inblock=false;
            blockname="";
            blocktoks=@()
          }el{
            (* 138.29: an `end` with no open block was ignored, so a stray or
               doubled `end` rendered with $ok and no log. *)
            let me="template: {! end !} with no open block";
            (log.error(me;@()));
            <$tplerr{msg:me}
          }
        }el if(dname=="var"){
          let vargot=ctx.get(darg);
          let varraw=mt vargot {$ok:v v;$err:e ""};
          let varval=ctxescape(hc;varraw);
          str.add(buf;varval);
          hc=hcfeed(hc;varval)
        }el if(dname=="yield"){
          let btoks=tplfindblock(blocks;darg);
          if(btoks.len>0){
            let yr=tplrenderctx(btoks;ctx;templatesdir;@();hc;depth+1)!$tplerr;
            str.add(buf;yr.text);
            hc=yr.hc;
            if(yr.islands){hasislands=true}el{}
          }el{}
        }el if(dname=="partial"){
          let partialpath=tplnamepath(templatesdir;"partial";darg)!$tplerr;
          (* 121.59: a missing partial is an error, as a missing layout is.
             It used to render as nothing, with no error and no log, so a
             typo in a partial name shipped a page with a hole in it. A file
             that exists but cannot be read is an error too; an empty
             partial file still renders as nothing.  (tplnamepath returns
             the realpath-resolved file, 121.59 (3), so a symlink inside
             templates/ is read through its in-tree target.) *)
          if(!file.exists(partialpath)){
            let mp=str.concat("template: no partial template: ";partialpath);
            (log.error(mp;@()));
            <$tplerr{msg:mp}
          }el{};
          let psrcr=file.read(partialpath);
          let preadfailed=mt psrcr {$ok:s false;$err:e true};
          if(preadfailed){
            let mpr=str.concat("template: partial template could not be read: ";partialpath);
            (log.error(mpr;@()));
            <$tplerr{msg:mpr}
          }el{};
          let partialsrc=mt psrcr {$ok:s s;$err:e ""};
          if(str.len(partialsrc)>0){
            let partialtokens=tpllex(partialsrc)!$tplerr;
            let pr=tplrenderctx(partialtokens;ctx;templatesdir;@();hc;depth+1)!$tplerr;
            str.add(buf;pr.text);
            hc=pr.hc;
            if(pr.islands){hasislands=true}el{}
          }el{}
        }el if(dname=="island"){
          let iparse=tplislandparse(tok.content);
          let inameg=iparse.get("name");
          let iname=mt inameg {$ok:v v;$err:e ""};
          let ihydrateg=iparse.get("hydrate");
          let ihydrate=mt ihydrateg {$ok:v v;$err:e "load"};
          let idiv=str.join("";@("<div data-island=\"";iname;"\" data-hydrate=\"";ihydrate;"\"></div>"));
          str.add(buf;idiv);
          hc=hcfeed(hc;idiv);
          hasislands=true
        }el{}
      }el{}
    }
  };

  (* 138.29: a block still open when the tokens run out was discarded with
     everything collected into it, and the render answered $ok -- a missing
     `{! end !}` shipped a page with a hole in it. *)
  if(inblock){
    let mb=str.join("";@("template: block \"";blockname;"\" is never closed with {! end !}"));
    (log.error(mb;@()));
    <$tplerr{msg:mb}
  }el{};

  if(str.len(layoutname)>0){
    let layoutpath=tplnamepath(templatesdir;"layout";layoutname)!$tplerr;
    if(!file.exists(layoutpath)){
      (* 134.24: log where the message exists. A caller cannot read `e.msg` off
         this payload (RT005, toke 127.78, open), so an unlogged $tplerr is a
         message that reaches nobody. *)
      let ml=str.concat("template: no layout template: ";layoutpath);
      (log.error(ml;@()));
      <$tplerr{msg:ml}
    }el{};
    (* 121.59: log a read failure too, for the reason given above. *)
    let lsrcr=file.read(layoutpath);
    let lreadfailed=mt lsrcr {$ok:s false;$err:e true};
    if(lreadfailed){
      let mlr=str.concat("template: layout template could not be read: ";layoutpath);
      (log.error(mlr;@()));
      <$tplerr{msg:mlr}
    }el{};
    let layoutsrc=mt lsrcr {$ok:s s;$err:e ""};
    let layouttokens=tpllex(layoutsrc)!$tplerr;
    (* the layout's output replaces this template's, from the same start *)
    let lr=tplrenderctx(layouttokens;ctx;templatesdir;collectedblocks;hc0;depth+1)!$tplerr;
    <$rout{text:lr.text;hc:lr.hc;islands:hasislands||lr.islands}
  }el{};
  <$rout{text:str.build(buf);hc:hc;islands:hasislands}
};

f=tplrender(
  tokens:@$token;
  ctx:@($str:$str);
  templatesdir:$str;
  blocks:@$block
):$str!$tplerr{
  let r=tplrenderctx(tokens;ctx;templatesdir;blocks;hcnew();0)!$tplerr;
  if(r.islands){
    <str.concat(r.text;"<script src=\"/static/ooke-islands.js\" defer></script>")
  }el{};
  <r.text
};

(* 121.63: the one place a template file is read for tplrenderfile and the
   cached path (tplrenderfilecached, tplcacheget). Those two read the file
   with `file.read(p)!$tplerr` and logged nothing, the gap 121.59 closed for
   tplrenderfile: a missing or unreadable template reached a caller as a bare
   $tplerr that nobody reported. They now fail and log exactly as
   tplrenderfile does, because they all call this. *)
f=tplreadsource(templatepath:$str):$str!$tplerr{
  if(!file.exists(templatepath)){
    (* 134.24: see the layout case above — an unlogged $tplerr reaches nobody. *)
    let mt0=str.concat("template: no template file: ";templatepath);
    (log.error(mt0;@()));
    <$tplerr{msg:mt0}
  }el{};
  let srcr=file.read(templatepath);
  let readfailed=mt srcr {$ok:s false;$err:e true};
  if(readfailed){
    (* 121.59: logged for the same reason as a missing file. *)
    let mr=str.concat("template: template file could not be read: ";templatepath);
    (log.error(mr;@()));
    <$tplerr{msg:mr}
  }el{};
  <mt srcr {$ok:s s;$err:e ""}
};

f=tplrenderfile(
  templatepath:$str;
  ctx:@($str:$str);
  templatesdir:$str
):$str!$tplerr{
  let src=tplreadsource(templatepath)!$tplerr;
  let tokens=tpllex(src)!$tplerr;
  <tplrender(tokens;ctx;templatesdir;@())!$tplerr
};

f=tplcachenew():$tplcache{
  <$tplcache{entries:@($str:@($token))}
};

f=tplcacheget(
  cache:$tplcache;
  path:$str
):@$token!$tplerr{
  let r=cache.entries.get(path);
  let hit=mt r {$ok:toks true;$err:e false};
  if(hit){
    <mt r {$ok:toks toks;$err:e @()}
  }el{
    let src=tplreadsource(path)!$tplerr;
    <tpllex(src)!$tplerr
  }
};

f=tplrenderfilecached(
  templatepath:$str;
  ctx:@($str:$str);
  templatesdir:$str;
  cache:$tplcache
):$renderresult!$tplerr{
  let r=cache.entries.get(templatepath);
  let hit=mt r {$ok:toks true;$err:e false};
  let tokens=mut.@();
  if(hit){
    tokens=mt r {$ok:toks toks;$err:e @()}
  }el{
    let src=tplreadsource(templatepath)!$tplerr;
    tokens=tpllex(src)!$tplerr
  };
  let newentries=cache.entries.set(templatepath;tokens);
  let newcache=$tplcache{entries:newentries};
  let out=tplrender(tokens;ctx;templatesdir;@())!$tplerr;
  <$renderresult{output:out;cache:newcache}
};
