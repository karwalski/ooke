{
  "schema_version": "1.0",
  "module": "ooke.store",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "content", "fields": [{"name": "slug", "type": "str"}, {"name": "type", "type": "str"}, {"name": "title", "type": "str"}, {"name": "meta", "type": "[str:str]"}, {"name": "body", "type": "str"}]},
    {"kind": "type", "name": "storeerr", "fields": [{"name": "msg", "type": "str"}]},
    {"kind": "func", "name": "storedefault", "params": [], "return": "content"},
    {"kind": "func", "name": "storeparsefront", "params": ["str"], "return": "content", "error": "storeerr"},
    {"kind": "func", "name": "storetryparse", "params": ["str"], "return": "content"},
    {"kind": "func", "name": "storeparsejson", "params": ["str"], "return": "content", "error": "storeerr"},
    {"kind": "func", "name": "storetryparsejson", "params": ["str"], "return": "content"},
    {"kind": "func", "name": "storesqlcreate", "params": ["str", "[str:str]"], "return": "str"},
    {"kind": "func", "name": "storeallsql", "params": ["str"], "return": "[content]", "error": "storeerr"},
    {"kind": "func", "name": "storewrite", "params": ["str", "content"], "return": "bool", "error": "storeerr"},
    {"kind": "func", "name": "storeallflat", "params": ["str", "str"], "return": "[content]", "error": "storeerr"},
    {"kind": "func", "name": "storeall", "params": ["str", "str", "str"], "return": "[content]", "error": "storeerr"},
    {"kind": "func", "name": "storeslug", "params": ["[content]", "str"], "return": "content", "error": "storeerr"},
    {"kind": "func", "name": "storefind", "params": ["[content]", "str", "str"], "return": "content", "error": "storeerr"}
  ]
}
