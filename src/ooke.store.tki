{
  "schema_version": "1.0",
  "module": "ooke.store",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "content", "fields": [{"name": "slug", "type": "str"}, {"name": "type", "type": "str"}, {"name": "title", "type": "str"}, {"name": "meta", "type": "@"}, {"name": "body", "type": "str"}]},
    {"kind": "type", "name": "storeerr", "fields": [{"name": "msg", "type": "str"}]},
    {"kind": "func", "name": "storeparsefront", "params": ["str"], "return": "content"},
    {"kind": "func", "name": "storedefault", "params": [], "return": "content"},
    {"kind": "func", "name": "storetryparse", "params": ["str"], "return": "content"},
    {"kind": "func", "name": "storeparsejson", "params": ["str"], "return": "content"},
    {"kind": "func", "name": "storetryparsejson", "params": ["str"], "return": "content"},
    {"kind": "func", "name": "storesqlcreate", "params": ["str", "@"], "return": "str"},
    {"kind": "func", "name": "storeallsql", "params": ["str"], "return": "@"},
    {"kind": "func", "name": "storewrite", "params": ["str", "content"], "return": "bool"},
    {"kind": "func", "name": "storeallflat", "params": ["str", "str"], "return": "@"},
    {"kind": "func", "name": "storeall", "params": ["str", "str", "str"], "return": "@"},
    {"kind": "func", "name": "storeslug", "params": ["@", "str"], "return": "content"},
    {"kind": "func", "name": "storefind", "params": ["@", "str", "str"], "return": "content"}
  ]
}
