{
  "schema_version": "1.0",
  "module": "ooke.config",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "ookecfg", "fields": [{"name": "sitename", "type": "str"}, {"name": "siteurl", "type": "str"}, {"name": "sitelanguage", "type": "str"}, {"name": "buildoutput", "type": "str"}, {"name": "buildminify", "type": "bool"}, {"name": "buildinlinecss", "type": "bool"}, {"name": "serverport", "type": "i64"}, {"name": "serverhost", "type": "str"}, {"name": "serverworkers", "type": "i64"}, {"name": "servercorsorigins", "type": "str"}, {"name": "logaccess", "type": "str"}, {"name": "logerror", "type": "str"}, {"name": "logaccessformat", "type": "str"}, {"name": "tlscert", "type": "str"}, {"name": "tlskey", "type": "str"}, {"name": "apiprefix", "type": "str"}]},
    {"kind": "type", "name": "configerr", "fields": [{"name": "msg", "type": "str"}]},
