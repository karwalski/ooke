{
  "schema_version": "1.0",
  "module": "ooke.build",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "builderr", "fields": [{"name": "msg", "type": "str"}]},
    {"kind": "type", "name": "buildreport", "fields": [{"name": "pagesbuilt", "type": "i64"}, {"name": "assetscopy", "type": "i64"}, {"name": "valerrors", "type": "i64"}, {"name": "valwarnings", "type": "i64"}, {"name": "pagesskipped", "type": "i64"}, {"name": "assetsfailed", "type": "i64"}]},
    {"kind": "type", "name": "assetreport", "fields": [{"name": "copied", "type": "i64"}, {"name": "failed", "type": "i64"}]},
    {"kind": "func", "name": "buildisstaticpage", "params": ["route"], "return": "bool"},
    {"kind": "func", "name": "buildisdynamicpage", "params": ["route"], "return": "bool"},
    {"kind": "func", "name": "buildresolve", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "buildoutputpath", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "buildfinish", "params": ["str", "str", "bool", "bool"], "return": "str"},
    {"kind": "func", "name": "buildpage", "params": ["str", "str", "str", "str", "str", "str", "str", "bool", "bool"], "return": "i64", "error": "builderr"},
    {"kind": "func", "name": "buildinlinecssonce", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "buildinlinecss", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "buildminify", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "buildcopyassets", "params": ["str", "str"], "return": "assetreport"},
    {"kind": "func", "name": "buildrun", "params": ["str", "ookecfg"], "return": "buildreport", "error": "builderr"}
  ]
}
