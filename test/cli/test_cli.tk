m=test.cli;
i=str:std.str;
i=file:std.file;
i=chk:ookeassert;
i=path:std.path;
i=cli:ooke.cli;
i=cfgmod:ooke.config;

f=delfile(p:$str):bool{
  <mt file.delete(p) {$ok:v true;$err:e false}
};

f=testcfgdefault():bool{
  let cfg=cli.cfgdefault();
  let a0=chk.eqstr(cfg.sitename;"my-site";"cfgdefault site.name");
  let a1=chk.eqstr(cfg.siteurl;"";"cfgdefault site.url");
  let a2=chk.eqstr(cfg.sitelanguage;"en";"cfgdefault site.language");
  let a3=chk.eqstr(cfg.buildoutput;"build/";"cfgdefault build.output");
  let a4=chk.eqbool(cfg.buildminify;true;"cfgdefault build.minify");
  let a5=chk.eqbool(cfg.buildinlinecss;true;"cfgdefault build.inlinecss");
  let a6=chk.eqint(cfg.serverport;3000;"cfgdefault server.port");
  let a7=chk.eqint(cfg.serverworkers;0;"cfgdefault server.workers");
  let a8=chk.eqstr(cfg.servercorsorigins;"";"cfgdefault server.corsorigins");
  let a9=chk.eqstr(cfg.storebackend;"flat";"cfgdefault store.backend");
  let a10=chk.eqstr(cfg.logaccessformat;"combined";"cfgdefault log.accessformat");
  let a11=chk.eqint(cfg.logmaxlines;10000;"cfgdefault log.maxlines");
  let a12=chk.eqint(cfg.logmaxagedays;30;"cfgdefault log.maxagedays");
  let a13=chk.eqstr(cfg.apiprefix;"";"cfgdefault paths.apiprefix");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7&&a8&&a9&&a10&&a11&&a12&&a13
};

f=testretcolon():bool{
  let r=cli.retcolon("i64");
  <chk.eqstr(r;"):i64";"retcolon")
};

f=testspecstack():bool{
  let code=cli.specstack("i64";"intstack");
  let okmod=str.contains(code;"m=intstack;");
  let okimp=str.contains(code;"i=stk:std.stack;");
  let oktype=str.contains(code;"t=$intstack=stk.$stack;");
  let oknew=str.contains(code;"f=new():$intstack");
  let okpush=str.contains(code;"f=push(s:$intstack;val:i64):i64");
  let okpushbody=str.contains(code;"<stk.stack.push(s as stk.$stack;val);");
  let okpop=str.contains(code;"f=pop(s:$intstack):i64");
  let okpeek=str.contains(code;"f=peek(s:$intstack):i64");
  let oklen=str.contains(code;"f=len(s:$intstack):i64");
  let okempty=str.contains(code;"f=empty(s:$intstack):i64");
  let a0=chk.istrue(okmod;"specstack module header");
  let a1=chk.istrue(okimp;"specstack std.stack import");
  let a2=chk.istrue(oktype;"specstack type alias");
  let a3=chk.istrue(oknew;"specstack new signature");
  let a4=chk.istrue(okpush;"specstack push signature");
  let a5=chk.istrue(okpushbody;"specstack push body");
  let a6=chk.istrue(okpop;"specstack pop signature");
  let a7=chk.istrue(okpeek;"specstack peek signature");
  let a8=chk.istrue(oklen;"specstack len signature");
  let a9=chk.istrue(okempty;"specstack empty signature");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7&&a8&&a9
};

f=testspecqueue():bool{
  let code=cli.specqueue("$str";"strqueue");
  let okmod=str.contains(code;"m=strqueue;");
  let okimp=str.contains(code;"i=que:std.queue;");
  let oktype=str.contains(code;"t=$strqueue=que.$queue;");
  let okpush=str.contains(code;"f=push(q:$strqueue;val:$str):$str");
  let okpushbody=str.contains(code;"<que.queue.push(q as que.$queue;val);");
  let okpop=str.contains(code;"f=pop(q:$strqueue):$str");
  let oklen=str.contains(code;"f=len(q:$strqueue):i64");
  let a0=chk.istrue(okmod;"specqueue module header");
  let a1=chk.istrue(okimp;"specqueue std.queue import");
  let a2=chk.istrue(oktype;"specqueue type alias");
  let a3=chk.istrue(okpush;"specqueue push signature");
  let a4=chk.istrue(okpushbody;"specqueue push body");
  let a5=chk.istrue(okpop;"specqueue pop signature");
  let a6=chk.istrue(oklen;"specqueue len signature");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6
};

f=testspecset():bool{
  let code=cli.specset("i64";"intset");
  let okmod=str.contains(code;"m=intset;");
  let okimp=str.contains(code;"i=st:std.set;");
  let oktype=str.contains(code;"t=$intset=st.$set;");
  let okadd=str.contains(code;"f=add(s:$intset;val:i64):i64");
  let okhas=str.contains(code;"f=has(s:$intset;val:i64):i64");
  let okhasbody=str.contains(code;"<st.set.has(s as st.$set;val);");
  let okremove=str.contains(code;"f=remove(s:$intset;val:i64):i64");
  let oklen=str.contains(code;"f=len(s:$intset):i64");
  let a0=chk.istrue(okmod;"specset module header");
  let a1=chk.istrue(okimp;"specset std.set import");
  let a2=chk.istrue(oktype;"specset type alias");
  let a3=chk.istrue(okadd;"specset add signature");
  let a4=chk.istrue(okhas;"specset has signature");
  let a5=chk.istrue(okhasbody;"specset has body");
  let a6=chk.istrue(okremove;"specset remove signature");
  let a7=chk.istrue(oklen;"specset len signature");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7
};

f=testgenunknowntype():bool{
  let rc=cli.cligen("unknowntype";"foo");
  <chk.eqint(rc;1;"cligen rejects an unknown type")
};

f=testgenspecunknown():bool{
  let rc=cli.cligenspec("tree";"foo");
  <chk.eqint(rc;1;"cligenspec rejects an unknown container")
};

f=testgenpage():bool{
  let mkresult=file.mkdir("pages");
  (mt mkresult {$ok:v 0;$err:e 0});
  let rc=cli.cligen("page";"mypage");
  let a0=chk.eqint(rc;0;"cligen page exit code");
  let pagepath=path.join("pages";"mypage.tk");
  let exists=mt file.exists(pagepath) {$ok:v v;$err:e false};
  let contentok=mt file.read(pagepath) {$ok:src str.contains(src;"m=pages.mypage;");$err:e false};
  (delfile(pagepath));
  let a1=chk.istrue(exists;"gen page file exists");
  let a2=chk.istrue(contentok;"gen page content");
  <a0&&a1&&a2
};

f=testgenspecstackfile():bool{
  let rc=cli.cligenspec("stack";"i64stk");
  let a0=chk.eqint(rc;0;"cligenspec stack exit code");
  let fpath="stacki64stk.tk";
  let exists=mt file.exists(fpath) {$ok:v v;$err:e false};
  let contentok=mt file.read(fpath) {$ok:src str.contains(src;"t=$stacki64stk=stk.$stack;");$err:e false};
  (delfile(fpath));
  let a1=chk.istrue(exists;"gen spec stack file exists");
  let a2=chk.istrue(contentok;"gen spec stack file content");
  <a0&&a1&&a2
};

f=main():i64{
  let r0=testcfgdefault();
  let r1=testretcolon();
  let r2=testspecstack();
  let r3=testspecqueue();
  let r4=testspecset();
  let r5=testgenunknowntype();
  let r6=testgenspecunknown();
  let r7=testgenpage();
  let r8=testgenspecstackfile();
  if(r0&&r1&&r2&&r3&&r4&&r5&&r6&&r7&&r8){
    <0
  }el{
    <1
  }
};
