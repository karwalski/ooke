m=test.apihealth;
i=apihealth:ooke.apihealth;
i=chk:ookeassert;

f=testapigetjson():bool{
  let body=apihealth.apigetjson();
  let want="{\"status\":\"ok\",\"service\":\"ooke\"}";
  <chk.eqstr(body;want;"apigetjson body")
};

f=testget():bool{
  let res=apihealth.get(0);
  <chk.nonzero(res;"apihealth.get handle")
};

f=main():i64{
  let r0=testapigetjson();
  let r1=testget();
  if(r0&&r1){
    <0
  }el{
    <1
  }
};
