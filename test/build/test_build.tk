m=test.build;
i=build:ooke.build;
i=chk:ookeassert;
i=file:std.file;
i=str:std.str;

f=testoutputpathroot():bool{
  let p=build.buildoutputpath("/";"build/");
  <chk.eqstr(p;"build/index.html";"outputpath /")
};

f=testoutputpathnested():bool{
  let p=build.buildoutputpath("/about";"build");
  <chk.eqstr(p;"build/about/index.html";"outputpath /about")
};

f=testoutputpathdeep():bool{
  let p=build.buildoutputpath("/blog/post";"out");
  <chk.eqstr(p;"out/blog/post/index.html";"outputpath /blog/post")
};

f=testminifycollapsespaces():bool{
  let out=build.buildminify("<p>a    b</p>");
  <chk.eqstr(out;"<p>a b</p>";"minify collapses spaces")
};

f=testminifystripscomment():bool{
  let out=build.buildminify("<p>x</p><!-- hidden -->");
  let a0=chk.isfalse(str.contains(out;"hidden");"minify strips comment text");
  let a1=chk.istrue(str.contains(out;"<p>x</p>");"minify keeps markup");
  <a0&&a1
};

f=testminifynoop():bool{
  let out=build.buildminify("<p>clean</p>");
  <chk.eqstr(out;"<p>clean</p>";"minify is a no-op on clean html")
};

f=testinlinecssnolink():bool{
  let html="<html><body>no stylesheet here</body></html>";
  let out=build.buildinlinecss(html;"/tmp/test_build_tpls");
  <chk.eqstr(out;html;"inlinecss no-op without a link tag")
};

f=testinlinecssinlines():bool{
  let dir="/tmp/test_build_css";
  let mkr=mt file.mkdir(dir) {$ok:v true;$err:e false};
  if(mkr==false){<false};
  let cssw=mt file.write("/tmp/test_build_css/style.css";"body{color:red}") {$ok:v true;$err:e false};
  if(cssw==false){<false};
  let html="<head><link rel=\"stylesheet\" href=\"style.css\"></head>";
  let out=build.buildinlinecss(html;dir);
  let a0=chk.istrue(str.contains(out;"<style>");"inlinecss emits a style tag");
  let a1=chk.istrue(str.contains(out;"body{color:red}");"inlinecss inlines the css");
  let a2=chk.isfalse(str.contains(out;"<link rel=\"stylesheet\"");"inlinecss drops the link tag");
  <a0&&a1&&a2
};

f=testinlinecssmissingfile():bool{
  let html="<head><link rel=\"stylesheet\" href=\"missing.css\"></head>";
  let out=build.buildinlinecss(html;"/tmp/test_build_nodir");
  <chk.eqstr(out;html;"inlinecss no-op when the css file is missing")
};

f=main():i64{
  let r0=testoutputpathroot();
  let r1=testoutputpathnested();
  let r2=testoutputpathdeep();
  let r3=testminifycollapsespaces();
  let r4=testminifystripscomment();
  let r5=testminifynoop();
  let r6=testinlinecssnolink();
  let r7=testinlinecssinlines();
  let r8=testinlinecssmissingfile();
  if(r0&&r1&&r2&&r3&&r4&&r5&&r6&&r7&&r8){<0}el{<1}
};
