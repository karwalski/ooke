m=test.repair;
i=repair:ooke.repair;
i=chk:ookeassert;
i=file:std.file;

f=testparsediagsempty():bool{
  let a0=chk.eqint(repair.parsediags("");0;"parsediags of the empty string");
  let a1=chk.eqint(repair.parsediags("\n\n  \n");0;"parsediags of blank lines only");
  <a0&&a1
};

f=testparsediagscounts():bool{
  let a0=chk.eqint(repair.parsediags("a\n\n  b  \nc\n");3;"parsediags counts non-blank lines");
  let a1=chk.eqint(repair.parsediags("one line");1;"parsediags of a single line");
  <a0&&a1
};

f=testrepairfileclean():bool{
  let src="m=t;\nf=main():i64{<0};\n";
  let wrok=mt file.write("/tmp/test_repair_ok.tk";src) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  <chk.eqint(repair.repairfile("/tmp/test_repair_ok.tk";1);0;"a clean file reports no diagnostics")
};

f=testrepairfilebroken():bool{
  let src="m=t;\nf=main():i64{<\n";
  let wrok=mt file.write("/tmp/test_repair_bad.tk";src) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let n=repair.repairfile("/tmp/test_repair_bad.tk";1);
  <chk.istrue(n>0;"a broken file reports diagnostics")
};

f=main():i64{
  let r0=testparsediagsempty();
  let r1=testparsediagscounts();
  let r2=testrepairfileclean();
  let r3=testrepairfilebroken();
  if(r0&&r1&&r2&&r3){
    <0
  }el{
    <1
  }
};
