m=test.serve;
i=serve:ooke.serve;
i=chk:ookeassert;
i=file:std.file;
i=path:std.path;
i=str:std.str;

f=mkfixture(root:$str):bool{
  let pages=path.join(root;"pages");
  let pagesapi=path.join(pages;"api");
  let pagesblog=path.join(pages;"blog");
  let tpls=path.join(root;"templates");
  let tplsapi=path.join(tpls;"api");
  let tplsblog=path.join(tpls;"blog");
  let contentblog=path.join(path.join(root;"content");"blog");
  (mt file.mkdir(pagesapi) {$ok:v v;$err:e false});
  (mt file.mkdir(pagesblog) {$ok:v v;$err:e false});
  (mt file.mkdir(tplsapi) {$ok:v v;$err:e false});
  (mt file.mkdir(tplsblog) {$ok:v v;$err:e false});
  (mt file.mkdir(contentblog) {$ok:v v;$err:e false});

  let w0=mt file.write(path.join(pages;"index.tk");"m=p.index;\nf=get():i64{<0};\n") {$ok:v true;$err:e false};
  let w1=mt file.write(path.join(pagesapi;"hello.tk");"m=p.api.hello;\nf=post():i64{<0};\n") {$ok:v true;$err:e false};
  let w2=mt file.write(path.join(pagesblog;"[slug].tk");"m=p.blog.slug;\nf=get():i64{<0};\n") {$ok:v true;$err:e false};

  let w3=mt file.write(path.join(tpls;"index.tkt");"<html><body>home {{ site.name }}</body></html>") {$ok:v true;$err:e false};
  let w4=mt file.write(path.join(tplsblog;"[slug].tkt");"<html><body>{{ title }}: {{ body }}</body></html>") {$ok:v true;$err:e false};

  let w5=mt file.write(path.join(contentblog;"post1.md");"---\nslug: post1\ntitle: First Post\ntype: blog\n---\nhello body") {$ok:v true;$err:e false};

  <w0&&w1&&w2&&w3&&w4&&w5
};

f=testregisternoprefix():bool{
  let root="/tmp/ooke_serve_noprefix";
  let mk=mkfixture(root);
  if(mk==false){<false};
  let pages=path.join(root;"pages");
  let content=path.join(root;"content");
  let tpls=path.join(root;"templates");
  let handled=@($str);
  let rc=mt serve.serveregisterstatic(root;pages;content;tpls;"My Site";"https://example.com";"en";"";handled) {$ok:v v;$err:e 0-1};
  (* "/" from templates/index.tkt and /blog/post1 from templates/blog/[slug].tkt,
     both resolved against the fixture, not the working directory (134.37). *)
  <chk.eqint(rc;2;"register with no api prefix renders 2 routes from their templates")
};

f=testregisterwithprefix():bool{
  let root="/tmp/ooke_serve_prefix";
  let mk=mkfixture(root);
  if(mk==false){<false};
  let pages=path.join(root;"pages");
  let content=path.join(root;"content");
  let tpls=path.join(root;"templates");
  let handled=@($str);
  let rc=mt serve.serveregisterstatic(root;pages;content;tpls;"My Site";"https://example.com";"en";"v1";handled) {$ok:v v;$err:e 0-1};
  <chk.eqint(rc;2;"register with an api prefix renders 2 routes from their templates")
};

f=testregisterdedup():bool{
  let root="/tmp/ooke_serve_dedup";
  let mk=mkfixture(root);
  if(mk==false){<false};
  let pages=path.join(root;"pages");
  let content=path.join(root;"content");
  let tpls=path.join(root;"templates");
  let handled=@("/";"/api/hello");
  let rc=mt serve.serveregisterstatic(root;pages;content;tpls;"My Site";"https://example.com";"en";"";handled) {$ok:v v;$err:e 0-1};
  (* "/" is owned by a handler, so only /blog/post1 is rendered. *)
  <chk.eqint(rc;1;"register skips paths a dynamic handler already owns")
};

f=testservejson():bool{
  let a0=chk.eqint(serve.servegetjson("/api/status";"{\"status\":\"ok\"}");0;"servegetjson");
  let a1=chk.eqint(serve.servepostjson("/api/submit";"{\"ok\":true}");0;"servepostjson");
  <a0&&a1
};

(* Story 134.18. A failed route scan used to be swallowed into an empty route
   set, so the server started and answered 404 for everything while looking
   healthy. It must now report the failure instead. *)
f=testregisterfailsonmissingpages():bool{
  let root="/tmp/ooke_serve_nopages";
  let handled=@($str);
  let iserr=mt serve.serveregisterstatic(root;path.join(root;"pages");path.join(root;"content");path.join(root;"templates");"My Site";"https://example.com";"en";"";handled) {$ok:v false;$err:e true};
  <chk.istrue(iserr;"a missing pages dir must fail registration, not register zero routes")
};

f=main():i64{
  let r0=testregisternoprefix();
  let r1=testregisterwithprefix();
  let r2=testregisterdedup();
  let r3=testservejson();
  let r4=testregisterfailsonmissingpages();
  if(r0&&r1&&r2&&r3&&r4){
    <0
  }el{
    <1
  }
};
