m=test.store;
i=store:ooke.store;
i=chk:ookeassert;
i=file:std.file;
i=str:std.str;

f=testdefault():bool{
  let c=store.storedefault();
  let a0=chk.eqstr(c.slug;"";"storedefault slug");
  let a1=chk.eqstr(c.type;"page";"storedefault type");
  let a2=chk.eqstr(c.title;"";"storedefault title");
  let a3=chk.eqstr(c.body;"";"storedefault body");
  let a4=chk.equint(c.meta.len;0;"storedefault meta size");
  <a0&&a1&&a2&&a3&&a4
};

f=testparsefront():bool{
  let src="---\nslug: hello-world\ntype: post\ntitle: Hello World\n---\n# Hello\n\nThis is the body.\n";
  let result=store.storeparsefront(src);
  let ok=mt result {$ok:v true;$err:e false};
  if(ok==false){<false};
  let c=mt result {$ok:v v;$err:e store.storedefault()};
  let a0=chk.eqstr(c.slug;"hello-world";"front matter slug");
  let a1=chk.eqstr(c.type;"post";"front matter type");
  let a2=chk.eqstr(c.title;"Hello World";"front matter title");
  let a3=chk.istrue(str.contains(c.body;"Hello");"body keeps the heading");
  let a4=chk.istrue(str.contains(c.body;"body");"body keeps the prose");
  <a0&&a1&&a2&&a3&&a4
};

f=testparsefrontnofront():bool{
  let src="# Just a heading\n\nNo front matter here.\n";
  let result=store.storeparsefront(src);
  let c=mt result {$ok:v v;$err:e store.storedefault()};
  let a0=chk.eqstr(c.slug;"";"no front matter leaves slug empty");
  let a1=chk.eqstr(c.type;"page";"no front matter defaults type");
  let a2=chk.eqstr(c.body;src;"no front matter keeps the whole source as body");
  <a0&&a1&&a2
};

f=testtryparse():bool{
  let c=store.storetryparse("---\nslug: a\n---\nbody\n");
  let a0=chk.eqstr(c.slug;"a";"tryparse reads the slug");
  let d=store.storetryparse("plain body");
  let a1=chk.eqstr(d.slug;"";"tryparse of plain text leaves slug empty");
  let a2=chk.eqstr(d.body;"plain body";"tryparse of plain text keeps the body");
  <a0&&a1&&a2
};

f=testparsejson():bool{
  let src="{\"slug\":\"news\",\"type\":\"post\",\"title\":\"Big News\"}";
  let result=store.storeparsejson(src);
  let ok=mt result {$ok:v true;$err:e false};
  if(ok==false){<false};
  let c=mt result {$ok:v v;$err:e store.storedefault()};
  let a0=chk.eqstr(c.slug;"news";"json slug");
  let a1=chk.eqstr(c.type;"post";"json type");
  let a2=chk.eqstr(c.title;"Big News";"json title");
  <a0&&a1&&a2
};

f=testparsejsoninvalid():bool{
  let result=store.storeparsejson("not json");
  let iserr=mt result {$ok:v false;$err:e true};
  <iserr
};

f=testtryparsejson():bool{
  let c=store.storetryparsejson("{\"slug\":\"x\",\"type\":\"page\"}");
  <chk.eqstr(c.slug;"x";"tryparsejson slug")
};

f=testsqlcreate():bool{
  let fields=@("author":"str");
  let sql=mt store.storesqlcreate("posts";fields) {$ok:v v;$err:e ""};
  let a0=chk.istrue(str.startswith(sql;"CREATE TABLE IF NOT EXISTS posts");"sqlcreate prologue");
  let a1=chk.istrue(str.contains(sql;"id INTEGER PRIMARY KEY");"sqlcreate id column");
  let a2=chk.istrue(str.contains(sql;"slug TEXT UNIQUE");"sqlcreate slug column");
  let a3=chk.istrue(str.contains(sql;"body TEXT");"sqlcreate body column");
  let a4=chk.istrue(str.endswith(sql;")");"sqlcreate is closed");
  <a0&&a1&&a2&&a3&&a4
};

(* Story 121.25 (audit OOK-04): table and column names are spliced into SQL
   text, so each must be an identifier. On the old code the injected name
   below came back inside the CREATE statement verbatim. *)
f=testident():bool{
  let good=mt store.storeident("posts_2") {$ok:v v;$err:e "ERR"};
  let under=mt store.storeident("_x") {$ok:v v;$err:e "ERR"};
  let a0=chk.eqstr(good;"posts_2";"storeident accepts posts_2");
  let a1=chk.eqstr(under;"_x";"storeident accepts _x");
  let b0=mt store.storeident("") {$ok:v false;$err:e true};
  let b1=mt store.storeident("2posts") {$ok:v false;$err:e true};
  let b2=mt store.storeident("posts;DROP TABLE users") {$ok:v false;$err:e true};
  let b3=mt store.storeident("posts(id)") {$ok:v false;$err:e true};
  let b4=mt store.storeident("po sts") {$ok:v false;$err:e true};
  let b5=mt store.storeident("pösts") {$ok:v false;$err:e true};
  let a2=chk.istrue(b0;"storeident refuses the empty name");
  let a3=chk.istrue(b1;"storeident refuses a leading digit");
  let a4=chk.istrue(b2;"storeident refuses ; and spaces");
  let a5=chk.istrue(b3;"storeident refuses parentheses");
  let a6=chk.istrue(b4;"storeident refuses an inner space");
  let a7=chk.istrue(b5;"storeident refuses a non-ASCII letter");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7
};

f=testsqlcreateinjection():bool{
  let badtable=mt store.storesqlcreate("posts(id);DROP TABLE users;--";@("author":"str")) {$ok:v v;$err:e "REFUSED"};
  let badcol=mt store.storesqlcreate("posts";@("x TEXT);DROP TABLE users;--":"str")) {$ok:v v;$err:e "REFUSED"};
  let a0=chk.eqstr(badtable;"REFUSED";"storesqlcreate refuses an injected table name");
  let a1=chk.eqstr(badcol;"REFUSED";"storesqlcreate refuses an injected column name");
  let badall=mt store.storeallsql("posts;DROP TABLE users") {$ok:v false;$err:e true};
  let a2=chk.istrue(badall;"storeallsql refuses an injected table name");
  <a0&&a1&&a2
};

f=teststoreallempty():bool{
  let mkresult=file.mkdir("/tmp/test_store_empty/posts");
  let mkok=mt mkresult {$ok:v true;$err:e true};
  if(mkok==false){<false};
  let result=store.storeall("/tmp/test_store_empty";"posts";"flat");
  let ok=mt result {$ok:v true;$err:e false};
  if(ok==false){<false};
  let col=mt result {$ok:v v;$err:e @($content)};
  <chk.equint(col.len;0;"storeall of an empty dir")
};

f=teststoreallflat():bool{
  let mkresult=file.mkdir("/tmp/test_store_flat/pages");
  let mkok=mt mkresult {$ok:v true;$err:e true};
  if(mkok==false){<false};
  let wr=mt file.write("/tmp/test_store_flat/pages/about.md";"---\nslug: about\ntitle: About\n---\nAbout body\n") {$ok:v true;$err:e false};
  if(wr==false){<false};
  let result=store.storeall("/tmp/test_store_flat";"pages";"flat");
  let col=mt result {$ok:v v;$err:e @($content)};
  let a0=chk.equint(col.len;1;"storeall flat count");
  if(a0==false){<false};
  <chk.eqstr(col.get(0).slug;"about";"storeall flat slug")
};

f=mkcol():@$content{
  let c1=$content{slug:"about";type:"page";title:"";meta:@("k":"v1");body:"About page body"};
  let c2=$content{slug:"contact";type:"page";title:"";meta:@("k":"v2");body:"Contact page body"};
  <@(c1;c2)
};

f=teststoreslug():bool{
  let result=store.storeslug(mkcol();"contact");
  let ok=mt result {$ok:v true;$err:e false};
  if(ok==false){<false};
  let c=mt result {$ok:v v;$err:e store.storedefault()};
  let a0=chk.eqstr(c.slug;"contact";"storeslug returns the asked-for entry");
  let a1=chk.istrue(str.contains(c.body;"Contact");"storeslug returns its body");
  <a0&&a1
};

f=teststoreslugmissing():bool{
  let result=store.storeslug(mkcol();"nope");
  let iserr=mt result {$ok:v false;$err:e true};
  <iserr
};

f=teststorefindmissing():bool{
  let result=store.storefind(mkcol();"k";"nomatch");
  let iserr=mt result {$ok:v false;$err:e true};
  <iserr
};

(* Story 121.66 (c): a value holding ":" keeps all of it, not the piece
   before its first ":". *)
f=testparsefrontcolons():bool{
  let c=store.storetryparse("---\nslug: s\nurl: https://x.io/a?b=c\ntime: 12:30:45\ntitle: Part 1: Intro\nnote: a::b\n---\nbody\n");
  let a0=chk.eqstr(c.meta.get("url");"https://x.io/a?b=c";"front matter URL value keeps its colon");
  let a1=chk.eqstr(c.meta.get("time");"12:30:45";"front matter time value keeps its colons");
  let a2=chk.eqstr(c.title;"Part 1: Intro";"front matter title keeps its colon");
  let a3=chk.eqstr(c.meta.get("note");"a::b";"front matter value keeps an empty piece between colons");
  (* control: a plain value is unchanged *)
  let a4=chk.eqstr(c.slug;"s";"plain slug value unchanged");
  <a0&&a1&&a2&&a3&&a4
};

(* Story 121.66 (d): a front-matter line with no ":" -- a blank line, or a
   stray word -- is skipped. It read past the end of the split (RT003) and
   killed the process. *)
f=testparsefrontnocolon():bool{
  let c=store.storetryparse("---\nslug: s\n\nstray\ntitle: T\n---\nbody\n");
  let a0=chk.eqstr(c.slug;"s";"slug before a blank front-matter line");
  let a1=chk.eqstr(c.title;"T";"title after a blank front-matter line");
  let a2=chk.equint(c.meta.len;2;"a line with no colon adds no meta key");
  <a0&&a1&&a2
};

f=main():i64{
  let r0=testdefault();
  let r1=testparsefront();
  let r2=testparsefrontnofront();
  let r3=testtryparse();
  let r4=testparsejson();
  let r5=testparsejsoninvalid();
  let r6=testtryparsejson();
  let r7=testsqlcreate();
  let r8=teststoreallempty();
  let r9=teststoreallflat();
  let r10=teststoreslug();
  let r11=teststoreslugmissing();
  let r12=teststorefindmissing();
  let r13=testident();
  let r14=testsqlcreateinjection();
  let r15=testparsefrontcolons();
  let r16=testparsefrontnocolon();
  if(r0&&r1&&r2&&r3&&r4&&r5&&r6&&r7&&r8&&r9&&r10&&r11&&r12&&r13&&r14&&r15&&r16){<0}el{<1}
};
