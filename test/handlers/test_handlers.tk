m=test.handlers;
i=handlers:ooke.handlers;
i=chk:ookeassert;

f=testhapihealthget():bool{
  let res=handlers.hapihealthget(0);
  <chk.nonzero(res;"hapihealthget handle")
};

f=testregisterall():bool{
  let paths=handlers.registerall();
  let a0=chk.equint(paths.len;1;"registerall path count");
  if(a0==false){<false};
  <chk.eqstr(paths.get(0);"/api/health";"registerall path 0")
};

f=main():i64{
  let r0=testhapihealthget();
  let r1=testregisterall();
  if(r0&&r1){
    <0
  }el{
    <1
  }
};
