m=test.run;
i=run:ooke.run;
i=chk:ookeassert;
i=file:std.file;
i=path:std.path;
i=str:std.str;

f=testloadclicfg():bool{
  let dir="/tmp/ooke_run_test_load";
  (mt file.mkdir(dir) {$ok:v v;$err:e false});
  let tomlsrc="[package]\nname = \"mysite\"\nentry = \"src/app.tk\"\n";
  let wrok=mt file.write(path.join(dir;"ooke.toml");tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let result=run.loadclicfg(dir);
  let ok=mt result {$ok:v true;$err:e false};
  if(ok==false){<false};
  let cfg=mt result {$ok:v v;$err:e 0};
  let a0=chk.eqstr(cfg.name;"mysite";"package.name");
  let a1=chk.eqstr(cfg.entry;"src/app.tk";"package.entry");
  <a0&&a1
};

f=testloadclicfgdefaults():bool{
  let dir="/tmp/ooke_run_test_defaults";
  (mt file.mkdir(dir) {$ok:v v;$err:e false});
  let tomlsrc="[other]\nx = 1\n";
  let wrok=mt file.write(path.join(dir;"ooke.toml");tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let result=run.loadclicfg(dir);
  let cfg=mt result {$ok:v v;$err:e 0};
  let a0=chk.eqstr(cfg.name;"app";"package.name default");
  let a1=chk.eqstr(cfg.entry;"src/main.tk";"package.entry default");
  <a0&&a1
};

f=testloadclicfgmissing():bool{
  let result=run.loadclicfg("/nonexistent/ooke/project");
  let iserr=mt result {$ok:v false;$err:e true};
  <iserr
};

f=testruncompilemissingentry():bool{
  let dir="/tmp/ooke_run_test_compile";
  (mt file.mkdir(dir) {$ok:v v;$err:e false});
  let tomlsrc="[package]\nname = \"app\"\nentry = \"src/does_not_exist.tk\"\n";
  let wrok=mt file.write(path.join(dir;"ooke.toml");tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let cfgresult=run.loadclicfg(dir);
  let cfg=mt cfgresult {$ok:v v;$err:e 0};
  let result=run.runcompile(dir;cfg);
  let nobin=mt result {$ok:v str.len(v)==0;$err:e true};
  <nobin
};

f=testrunmissingentry():bool{
  let dir="/tmp/ooke_run_test_run";
  (mt file.mkdir(dir) {$ok:v v;$err:e false});
  let tomlsrc="[package]\nname = \"app\"\nentry = \"src/does_not_exist.tk\"\n";
  let wrok=mt file.write(path.join(dir;"ooke.toml");tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let rc=run.run(dir;@());
  <chk.eqint(rc;1;"run exit code for a missing entry")
};

f=testbuildmissingentry():bool{
  let dir="/tmp/ooke_run_test_build";
  (mt file.mkdir(dir) {$ok:v v;$err:e false});
  let tomlsrc="[package]\nname = \"app\"\nentry = \"src/does_not_exist.tk\"\n";
  let wrok=mt file.write(path.join(dir;"ooke.toml");tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let rc=run.build(dir);
  <chk.eqint(rc;1;"build exit code for a missing entry")
};

(* Story 121.69 (1): without [package], a top-level name/entry is not the
   package's. loadclicfg fell back to the ROOT table, so this project's
   `name = "rootname"` became the binary name and `entry` the entry point.
   A missing [package] is an empty table (config.configsection, 121.67 (4)).
   testloadclicfg is the control: the same keys under [package] are read. *)
f=testloadclicfgrootnotpackage():bool{
  let dir="/tmp/ooke_run_test_rootkeys";
  (mt file.mkdir(dir) {$ok:v v;$err:e false});
  let tomlsrc="name = \"rootname\"\nentry = \"src/root.tk\"\n[site]\nname = \"s\"\n";
  let wrok=mt file.write(path.join(dir;"ooke.toml");tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let result=run.loadclicfg(dir);
  let cfg=mt result {$ok:v v;$err:e 0};
  let a0=chk.eqstr(cfg.name;"app";"root name is not [package] name");
  let a1=chk.eqstr(cfg.entry;"src/main.tk";"root entry is not [package] entry");
  <a0&&a1
};

f=main():i64{
  let r0=testloadclicfg();
  let r1=testloadclicfgdefaults();
  let r2=testloadclicfgmissing();
  let r3=testruncompilemissingentry();
  let r4=testrunmissingentry();
  let r5=testbuildmissingentry();
  let r6=testloadclicfgrootnotpackage();
  if(r0&&r1&&r2&&r3&&r4&&r5&&r6){
    <0
  }el{
    <1
  }
};
