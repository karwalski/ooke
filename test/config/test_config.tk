m=test.config;
i=config:ooke.config;
i=chk:ookeassert;
i=file:std.file;

f=testloadvalid():bool{
  let tomlsrc="[site]\nname = \"ooke-test\"\nurl = \"https://test.example.com\"\nlanguage = \"fr\"\n\n[build]\noutput = \"dist/\"\nminify = false\ninlinecss = false\n\n[server]\nhost = \"0.0.0.0\"\nport = 8080\nworkers = 2\n\n[store]\nbackend = \"sqlite\"\n";
  let wrok=mt file.write("/tmp/test_ooke.toml";tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let result=config.configload("/tmp/test_ooke.toml");
  let cfgok=mt result {$ok:v true;$err:e false};
  if(cfgok==false){<false};
  let cfg=mt result {$ok:v v;$err:e 0};
  let a0=chk.eqstr(cfg.sitename;"ooke-test";"site.name");
  let a1=chk.eqstr(cfg.siteurl;"https://test.example.com";"site.url");
  let a2=chk.eqstr(cfg.sitelanguage;"fr";"site.language");
  let a3=chk.eqstr(cfg.buildoutput;"dist/";"build.output");
  let a4=chk.eqbool(cfg.buildminify;false;"build.minify");
  let a5=chk.eqbool(cfg.buildinlinecss;false;"build.inlinecss");
  let a6=chk.eqint(cfg.serverport;8080;"server.port");
  let a7=chk.eqint(cfg.serverworkers;2;"server.workers");
  let a8=chk.eqstr(cfg.serverhost;"0.0.0.0";"server.host (138.7)");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7&&a8
};

f=testmissingfile():bool{
  let result=config.configload("/nonexistent/path.toml");
  let iserr=mt result {$ok:v false;$err:e true};
  <iserr
};

f=testdefaults():bool{
  let tomlsrc="[site]\nname = \"x\"\n";
  let wrok=mt file.write("/tmp/test_ooke_defaults.toml";tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let result=config.configload("/tmp/test_ooke_defaults.toml");
  let cfgok=mt result {$ok:v true;$err:e false};
  if(cfgok==false){<false};
  let cfg=mt result {$ok:v v;$err:e 0};
  let a0=chk.eqstr(cfg.sitename;"x";"site.name");
  let a1=chk.eqstr(cfg.siteurl;"";"site.url default");
  let a2=chk.eqstr(cfg.sitelanguage;"en";"site.language default");
  let a3=chk.eqstr(cfg.buildoutput;"build/";"build.output default");
  let a4=chk.eqbool(cfg.buildminify;true;"build.minify default");
  let a5=chk.eqbool(cfg.buildinlinecss;true;"build.inlinecss default");
  let a6=chk.eqint(cfg.serverport;3000;"server.port default");
  let a7=chk.eqint(cfg.serverworkers;0;"server.workers default");
  let a8=chk.eqstr(cfg.serverhost;"127.0.0.1";"server.host default is loopback (138.7)");
  let a9=chk.eqstr(cfg.logaccessformat;"combined";"log.accessformat default");
  let a10=chk.eqstr(cfg.logaccess;"-";"log.access default (stderr)");
  let a11=chk.eqstr(cfg.logerror;"";"log.error default (off)");
  let a12=chk.eqstr(cfg.tlscert;"";"tls.cert default");
  let a13=chk.eqstr(cfg.tlskey;"";"tls.key default");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7&&a8&&a9&&a10&&a11&&a12&&a13
};

(* Story 134.40: [log] access/error/accessformat and [tls] cert/key are read. *)
f=testlogtls():bool{
  let tomlsrc="[site]\nname = \"x\"\n\n[log]\naccess = \"logs/access.log\"\nerror = \"-\"\naccessformat = \"json\"\n\n[tls]\ncert = \"certs/c.pem\"\nkey = \"certs/k.pem\"\n";
  let wrok=mt file.write("/tmp/test_ooke_logtls.toml";tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let result=config.configload("/tmp/test_ooke_logtls.toml");
  let cfgok=mt result {$ok:v true;$err:e false};
  if(cfgok==false){<false};
  let cfg=mt result {$ok:v v;$err:e 0};
  let a0=chk.eqstr(cfg.logaccess;"logs/access.log";"log.access");
  let a1=chk.eqstr(cfg.logerror;"-";"log.error");
  let a2=chk.eqstr(cfg.logaccessformat;"json";"log.accessformat");
  let a3=chk.eqstr(cfg.tlscert;"certs/c.pem";"tls.cert");
  let a4=chk.eqstr(cfg.tlskey;"certs/k.pem";"tls.key");
  let a5=chk.eqstr(cfg.apiprefix;"";"paths.apiprefix after tls (field 15)");
  <a0&&a1&&a2&&a3&&a4&&a5
};

(* Story 134.40: maxlines/maxagedays are named as unsupported, not applied. *)
f=testlogunsupported():bool{
  let w0=mt file.write("/tmp/test_ooke_rot.toml";"[log]\nmaxlines = 5\nmaxagedays = 3\n") {$ok:v true;$err:e false};
  let w1=mt file.write("/tmp/test_ooke_norot.toml";"[log]\naccess = \"-\"\n") {$ok:v true;$err:e false};
  if(!(w0&&w1)){<false};
  let both=mt config.configlogunsupported("/tmp/test_ooke_rot.toml") {$ok:v v;$err:e "ERR"};
  let none=mt config.configlogunsupported("/tmp/test_ooke_norot.toml") {$ok:v v;$err:e "ERR"};
  let a0=chk.eqstr(both;"maxlines, maxagedays";"configlogunsupported names both keys");
  let a1=chk.eqstr(none;"";"configlogunsupported is empty when neither is set");
  <a0&&a1
};

f=main():i64{
  let r0=testloadvalid();
  let r1=testmissingfile();
  let r2=testdefaults();
  let r3=testlogtls();
  let r4=testlogunsupported();
  if(r0&&r1&&r2&&r3&&r4){
    <0
  }el{
    <1
  }
};
