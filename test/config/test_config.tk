m=test.config;
i=config:ooke.config;
i=chk:ookeassert;
i=file:std.file;

f=testloadvalid():bool{
  let tomlsrc="[site]\nname = \"ooke-test\"\nurl = \"https://test.example.com\"\nlanguage = \"fr\"\n\n[build]\noutput = \"dist/\"\nminify = false\ninlinecss = false\n\n[server]\nport = 8080\nworkers = 2\n\n[store]\nbackend = \"sqlite\"\n";
  let wrok=mt file.write("/tmp/test_ooke.toml";tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let result=config.configload("/tmp/test_ooke.toml");
  let cfgok=mt result {$ok:v true;$err:e false};
  if(cfgok==false){<false};
  let cfg=mt result {$ok:v v;$err:e 0};
  let a0=chk.eqstr(cfg.sitename;"ooke-test";"site.name");
  let a1=chk.eqstr(cfg.siteurl;"https://test.example.com";"site.url");
  let a2=chk.eqstr(cfg.sitelanguage;"fr";"site.language");
  let a3=chk.eqstr(cfg.buildoutput;"dist/";"build.output");
  let a4=chk.eqbool(cfg.buildminify;false;"build.minify");
  let a5=chk.eqbool(cfg.buildinlinecss;false;"build.inlinecss");
  let a6=chk.eqint(cfg.serverport;8080;"server.port");
  let a7=chk.eqint(cfg.serverworkers;2;"server.workers");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7
};

f=testmissingfile():bool{
  let result=config.configload("/nonexistent/path.toml");
  let iserr=mt result {$ok:v false;$err:e true};
  <iserr
};

f=testdefaults():bool{
  let tomlsrc="[site]\nname = \"x\"\n";
  let wrok=mt file.write("/tmp/test_ooke_defaults.toml";tomlsrc) {$ok:v true;$err:e false};
  if(wrok==false){<false};
  let result=config.configload("/tmp/test_ooke_defaults.toml");
  let cfgok=mt result {$ok:v true;$err:e false};
  if(cfgok==false){<false};
  let cfg=mt result {$ok:v v;$err:e 0};
  let a0=chk.eqstr(cfg.sitename;"x";"site.name");
  let a1=chk.eqstr(cfg.siteurl;"";"site.url default");
  let a2=chk.eqstr(cfg.sitelanguage;"en";"site.language default");
  let a3=chk.eqstr(cfg.buildoutput;"build/";"build.output default");
  let a4=chk.eqbool(cfg.buildminify;true;"build.minify default");
  let a5=chk.eqbool(cfg.buildinlinecss;true;"build.inlinecss default");
  let a6=chk.eqint(cfg.serverport;3000;"server.port default");
  let a7=chk.eqint(cfg.serverworkers;0;"server.workers default");
  let a9=chk.eqstr(cfg.logaccessformat;"combined";"log.accessformat default");
  let a10=chk.eqint(cfg.logmaxlines;10000;"log.maxlines default");
  let a11=chk.eqint(cfg.logmaxagedays;30;"log.maxagedays default");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7&&a9&&a10&&a11
};

f=main():i64{
  let r0=testloadvalid();
  let r1=testmissingfile();
  let r2=testdefaults();
  if(r0&&r1&&r2){
    <0
  }el{
    <1
  }
};
