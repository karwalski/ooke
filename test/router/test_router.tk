m=test.router;
i=router:ooke.router;
i=str:std.str;
i=file:std.file;

f=testderivepattern():bool{
  if(!(router.routederivepattern("pages/index.tk";"pages/")=="/")){<false};
  if(!(router.routederivepattern("pages/about.tk";"pages/")=="/about")){<false};
  if(!(router.routederivepattern("pages/blog/[slug].tk";"pages/")=="/blog/:slug")){<false};
  if(!(router.routederivepattern("pages/blog/index.tk";"pages/")=="/blog")){<false};
  <true
};

f=testderivetemplate():bool{
  if(!(router.routederivetemplate("pages/about.tk";"pages/")=="templates/about.tkt")){<false};
  if(!(router.routederivetemplate("pages/blog/[slug].tk";"pages/")=="templates/blog/[slug].tkt")){<false};
  <true
};

f=testderivedtype():bool{
  if(!(router.routederivedtype("pages/about.tk";"pages/")=="")){<false};
  if(!(router.routederivedtype("pages/blog/post.tk";"pages/")=="blog")){<false};
  if(!(router.routederivedtype("pages/docs/guide/intro.tk";"pages/")=="docs/guide")){<false};
  <true
};

f=testcountdynamic():bool{
  if(!(router.routecountdynamic("/about")==0)){<false};
  if(!(router.routecountdynamic("/blog/:slug")==1)){<false};
  if(!(router.routecountdynamic("/docs/:section/:slug")==2)){<false};
  <true
};

f=testscanbasic():bool{
  let tmp=str.concat(file.tempdir();"/ooke_router_test");
  (file.ensuredir(tmp));
  (file.ensuredir(str.concat(tmp;"/blog")));
  (file.write(str.concat(tmp;"/index.tk");""));
  (file.write(str.concat(tmp;"/about.tk");""));
  (file.write(str.concat(tmp;"/blog/[slug].tk");""));
  let result=router.routerscan(tmp);
  let rok=mt result {$ok:v true;$err:e false};
  if(rok==false){<false};
  let routes=mt result {$ok:v v;$err:e 0};
  let foundroot=mut.false;
  let foundabout=mut.false;
  let foundblog=mut.false;
  let foundblogdynamic=mut.false;
  lp(let i=0;i<routes.len;i=i+1){
    let r=routes.get(i);
    if(r.pattern=="/"){foundroot=true}el{};
    if(r.pattern=="/about"){foundabout=true}el{};
    if(r.pattern=="/blog/:slug"){
      foundblog=true;
      foundblogdynamic=r.isdynamic
    }el{}
  };
  <foundroot&&foundabout&&foundblog&&foundblogdynamic
};

f=testtrymatchmiss():bool{
  let r=$route{
    pattern:"/blog/:slug";
    filepath:"pages/blog/[slug].tk";
    templatepath:"templates/blog.tkt";
    contenttype:"blog";
    isdynamic:true;
    isapi:false;
    params:@()
  };
  let result=router.routertrymatch(r;"/blog/a/b");
  <mt result {$ok:v false;$err:e true}
};

f=testtrymatchok():bool{
  let r=$route{
    pattern:"/blog/:slug";
    filepath:"pages/blog/[slug].tk";
    templatepath:"templates/blog.tkt";
    contenttype:"blog";
    isdynamic:true;
    isapi:false;
    params:@()
  };
  let result=router.routertrymatch(r;"/blog/hello");
  <mt result {$ok:v v.route.pattern=="/blog/:slug";$err:e false}
};

f=testmatchstatic():bool{
  let r=$route{
    pattern:"/about";
    filepath:"pages/about.tk";
    templatepath:"templates/about.tkt";
    contenttype:"";
    isdynamic:false;
    isapi:false;
    params:@()
  };
  let result=router.routermatch(@(r);"/about");
  <mt result {$ok:v v.route.pattern=="/about";$err:e false}
};

f=testmatchdynamic():bool{
  let r=$route{
    pattern:"/blog/:slug";
    filepath:"pages/blog/[slug].tk";
    templatepath:"templates/blog.tkt";
    contenttype:"blog";
    isdynamic:true;
    isapi:false;
    params:@()
  };
  let result=router.routermatch(@(r);"/blog/hello-world");
  <mt result {$ok:v v.route.pattern=="/blog/:slug";$err:e false}
};

f=testmatchnomatch():bool{
  let r=$route{
    pattern:"/about";
    filepath:"pages/about.tk";
    templatepath:"templates/about.tkt";
    contenttype:"";
    isdynamic:false;
    isapi:false;
    params:@()
  };
  let result=router.routermatch(@(r);"/nonexistent");
  <mt result {$ok:v false;$err:e true}
};

f=testmatchroot():bool{
  let r=$route{
    pattern:"/";
    filepath:"pages/index.tk";
    templatepath:"templates/index.tkt";
    contenttype:"";
    isdynamic:false;
    isapi:false;
    params:@()
  };
  let result=router.routermatch(@(r);"/");
  <mt result {$ok:v true;$err:e false}
};

f=testmatchtrailingslash():bool{
  let r=$route{
    pattern:"/about";
    filepath:"pages/about.tk";
    templatepath:"templates/about.tkt";
    contenttype:"";
    isdynamic:false;
    isapi:false;
    params:@()
  };
  let result=router.routermatch(@(r);"/about/");
  <mt result {$ok:v v.route.pattern=="/about";$err:e false}
};

f=testmatchspecificity():bool{
  let generic=$route{
    pattern:"/docs/:section/:slug";
    filepath:"pages/docs/[section]/[slug].tk";
    templatepath:"templates/docs/[section]/[slug].tkt";
    contenttype:"docs";
    isdynamic:true;
    isapi:false;
    params:@()
  };
  let specific=$route{
    pattern:"/docs/about/:slug";
    filepath:"pages/docs/about/[slug].tk";
    templatepath:"templates/docs/about/[slug].tkt";
    contenttype:"docs/about";
    isdynamic:true;
    isapi:false;
    params:@()
  };
  let result=router.routermatch(@(generic;specific);"/docs/about/overview");
  <mt result {$ok:v v.route.pattern=="/docs/about/:slug";$err:e false}
};

f=main():i64{
  let r0=testderivepattern();
  let r1=testderivetemplate();
  let r2=testderivedtype();
  let r3=testcountdynamic();
  let r4=testscanbasic();
  let r5=testtrymatchmiss();
  let r6=testtrymatchok();
  let r7=testmatchstatic();
  let r8=testmatchdynamic();
  let r9=testmatchnomatch();
  let r10=testmatchroot();
  let r11=testmatchtrailingslash();
  let r12=testmatchspecificity();
  if(r0&&r1&&r2&&r3&&r4&&r5&&r6&&r7&&r8&&r9&&r10&&r11&&r12){
    <0
  }el{
    <1
  }
};
