m=test.template;
i=tpl:ooke.template;
i=test:std.test;
i=chk:ookeassert;
i=str:std.str;
i=file:std.file;


f=failret(msg:str):bool{
  (test.fail(msg));
  <false
};


f=testrawpassthrough():bool{
  let src="<p>Hello, world!</p>";
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let ctx=@($str:$str);
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.eqstr(s;src;"raw text passes through unchanged")
};


f=testexprsimple():bool{
  let src="Hello, {= name =}!";
  let ctx=@("name":"World");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"World");"expr substitutes the value");
  let a1=chk.istrue(str.contains(s;"Hello");"expr keeps the surrounding text");
  <a0&&a1
};


f=testexprmissingkey():bool{
  let src="{= missingkey =}";
  let ctx=@($str:$str);
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.eqstr(s;"";"a missing key renders as empty")
};


f=testdottedkey():bool{
  let src="Site: {= site.name =}";
  let ctx=@("site.name":"toke");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.istrue(str.contains(s;"toke");"a dotted key resolves")
};


f=testfiltermd():bool{
  let src="{= body | md =}";
  let ctx=@("body":"# Hello");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.istrue(str.contains(s;"<h1");"the md filter renders markdown")
};


f=testfilterupper():bool{
  let src="{= name | upper =}";
  let ctx=@("name":"toke");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.eqstr(s;"TOKE";"the upper filter uppercases")
};


f=testfilterescape():bool{
  let src="{= text | escape =}";
  let ctx=@("text":"<script>alert(1)</script>");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"&lt;script&gt;");"the escape filter escapes");
  let a1=chk.isfalse(str.contains(s;"<script>");"the escape filter leaves no raw tag");
  <a0&&a1
};


f=testexprescapesbydefault():bool{
  let src="{= text =}";
  let ctx=@("text":"<script>alert(1)</script>");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"&lt;script&gt;");"a bare expr escapes by default");
  let a1=chk.isfalse(str.contains(s;"<script>");"a bare expr leaves no raw tag");
  <a0&&a1
};


f=testfilterraw():bool{
  let src="{= html | raw =}";
  let ctx=@("html":"<b>bold</b>");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.eqstr(s;"<b>bold</b>";"the raw filter does not escape")
};


f=testfilteruppertescapes():bool{
  let src="{= text | upper =}";
  let ctx=@("text":"<x>");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"&lt;X&gt;");"upper escapes as well as uppercasing");
  let a1=chk.isfalse(str.contains(s;"<x>");"upper leaves no raw tag");
  <a0&&a1
};


f=testcommentignored():bool{
  let src="before{# this is a comment #}after";
  let ctx=@($str:$str);
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.isfalse(str.contains(s;"comment");"a comment is not rendered");
  let a1=chk.istrue(str.contains(s;"before");"text before a comment survives");
  let a2=chk.istrue(str.contains(s;"after");"text after a comment survives");
  <a0&&a1&&a2
};


f=testlayoutdetected():bool{
  let src="{! layout(\"base\") !}<p>child content</p>";
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let a0=chk.istrue(!(toks.len<2);"a layout template lexes to at least two tokens");
  if(a0==false){<false};
  let first=toks.get(0);
  let a1=chk.istrue(first.kind.directive;"the layout token is a directive");
  let a2=chk.istrue(str.contains(first.content;"layout");"the directive names layout");
  <a1&&a2
};


f=testblockcollected():bool{
  let src="{! block(\"title\") !}My Title{! end !}";
  let ctx=@($str:$str);
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let a0=chk.equint(toks.len;3;"a block lexes to three tokens");
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let rendered=mt out {$ok:s true;$err:e failret(e.msg)};
  <a0&&rendered
};


f=testescapehelper():bool{
  let result=tpl.tplescape("<b>&");
  let a0=chk.istrue(str.contains(result;"&lt;b&gt;");"tplescape escapes angle brackets");
  let a1=chk.istrue(str.contains(result;"&amp;");"tplescape escapes ampersands");
  let a2=chk.isfalse(str.contains(result;"<b>");"tplescape leaves no raw tag");
  <a0&&a1&&a2
};


f=testlexbasic():bool{
  let src="<p>{= title =}</p>{# ignore #}{! block(\"x\") !}body{! end !}";
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let a0=chk.equint(toks.len;7;"lex token count");
  if(a0==false){<false};
  let a1=chk.istrue(toks.get(0).kind.raw;"token 0 is raw");
  let a2=chk.istrue(toks.get(1).kind.expr;"token 1 is an expr");
  let a3=chk.istrue(toks.get(3).kind.comment;"token 3 is a comment");
  let a4=chk.istrue(toks.get(4).kind.directive;"token 4 is a directive");
  <a1&&a2&&a3&&a4
};


f=testrenderfilesimple():bool{
  let tktsrc="<h1>{= heading =}</h1><p>{= body =}</p>";
  let tktpath="/tmp/test_ooke_simple.tkt";
  let writeresult=file.write(tktpath;tktsrc);
  (mt writeresult {$ok:v 0;$err:e failret("could not write temp template")});
  let ctx=@("heading":"Welcome";"body":"Hello from ooke.");
  let result=tpl.tplrenderfile(tktpath;ctx;"/tmp");
  let s=mt result {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"<h1>Welcome</h1>");"renderfile substitutes the heading");
  let a1=chk.istrue(str.contains(s;"Hello from ooke.");"renderfile substitutes the body");
  <a0&&a1
};


f=testcachehit():bool{
  let tktsrc="<p>{= msg =}</p>";
  let tktpath="/tmp/test_ooke_cache.tkt";
  let writeresult=file.write(tktpath;tktsrc);
  (mt writeresult {$ok:v 0;$err:e failret("could not write temp template")});
  let ctx=@("msg":"cached");
  let cache0=tpl.tplcachenew();
  let r1=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache0);
  let out1=mt r1 {$ok:r r.output;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(out1;"cached");"the first cached render substitutes");
  let cache1=mt r1 {$ok:r r.cache;$err:e cache0};
  let toks=tpl.tplcacheget(cache1;tktpath);
  let hasentry=mt toks {$ok:t true;$err:e false};
  let a1=chk.istrue(hasentry;"the render populated the cache");
  let r2=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache1);
  let out2=mt r2 {$ok:r r.output;$err:e failret(e.msg)};
  let a2=chk.istrue(str.contains(out2;"cached");"the cache-hit render substitutes");
  <a0&&a1&&a2
};


(* 127.226: testcachehit cannot fail on a cache that never stores —
 * tplcacheget falls back to reading the file, so "populated" held either way,
 * and that is how ooke's template cache went its whole life without caching
 * (toke lowered `cache.entries.set` as an ARRAY store, a silent no-op).  Here
 * the file changes between two renders through the same cache: only a stored
 * entry can still produce the first text.  The empty cache is the control
 * that the file really changed. *)
f=testcacheservesstored():bool{
  let tktpath="/tmp/test_ooke_cache_stored.tkt";
  let w1=file.write(tktpath;"<p>first {= msg =}</p>");
  (mt w1 {$ok:v 0;$err:e failret("could not write temp template")});
  let ctx=@("msg":"m");
  let cache0=tpl.tplcachenew();
  let r1=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache0);
  let out1=mt r1 {$ok:r r.output;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(out1;"first");"the first render reads the file");
  let cache1=mt r1 {$ok:r r.cache;$err:e cache0};
  let w2=file.write(tktpath;"<p>second {= msg =}</p>");
  (mt w2 {$ok:v 0;$err:e failret("could not rewrite temp template")});
  let r2=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache1);
  let out2=mt r2 {$ok:r r.output;$err:e failret(e.msg)};
  let a1=chk.istrue(str.contains(out2;"first");"a render through the populated cache serves the stored tokens, not the changed file");
  let r3=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache0);
  let out3=mt r3 {$ok:r r.output;$err:e failret(e.msg)};
  let a2=chk.istrue(str.contains(out3;"second");"a render through the empty cache reads the changed file");
  <a0&&a1&&a2
};


f=testpartial():bool{
  let partialsrc="<header><a href=\"/\">Home</a></header>";
  let partialpath="/tmp/header.tkt";
  let pwrite=file.write(partialpath;partialsrc);
  (mt pwrite {$ok:v 0;$err:e failret("could not write partial")});
  let tktsrc="{! partial(\"header\") !}<main>{= content =}</main>";
  let tktpath="/tmp/test_ooke_partial.tkt";
  let twrite=file.write(tktpath;tktsrc);
  (mt twrite {$ok:v 0;$err:e failret("could not write template")});
  let ctx=@("content":"Hello from partial test.");
  let result=tpl.tplrenderfile(tktpath;ctx;"/tmp");
  let s=mt result {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"<header>");"the partial is included");
  let a1=chk.istrue(str.contains(s;"Home");"the partial keeps its content");
  let a2=chk.istrue(str.contains(s;"Hello from partial test.");"the host template still renders");
  <a0&&a1&&a2
};


(* 121.57: a partial or layout name resolves only inside the templates
 * directory.  The fixture puts secret.tkt one level ABOVE templates/, so a
 * name that escapes can read it; the nested partials/header.tkt is the
 * legitimate control that must keep working. *)
f=trvsetup():bool{
  let root="/tmp/test_ooke_12157";
  (mt file.mkdir(root) {$ok:v 0;$err:e 0});
  (mt file.mkdir("/tmp/test_ooke_12157/templates") {$ok:v 0;$err:e 0});
  (mt file.mkdir("/tmp/test_ooke_12157/templates/partials") {$ok:v 0;$err:e 0});
  let w0=file.write("/tmp/test_ooke_12157/secret.tkt";"TOPSECRET");
  let a0=mt w0 {$ok:v true;$err:e failret("could not write secret.tkt")};
  let w1=file.write("/tmp/test_ooke_12157/templates/partials/header.tkt";"<header>NESTEDOK</header>");
  let a1=mt w1 {$ok:v true;$err:e failret("could not write partials/header.tkt")};
  <a0&&a1
};


f=trvrender(src:$str):$str{
  let toks=mt tpl.tpllex(src) {$ok:t t;$err:e @()};
  let out=tpl.tplrender(toks;@($str:$str);"/tmp/test_ooke_12157/templates";@());
  <mt out {$ok:s s;$err:e "<<REFUSED>>"}
};


f=trvrefused(src:$str;what:$str):bool{
  let r=trvrender(src);
  let refused=r=="<<REFUSED>>";
  let leaked=str.contains(r;"TOPSECRET");
  let a0=chk.istrue(refused;str.concat(what;" is refused with an error"));
  let a1=chk.isfalse(leaked;str.concat(what;" does not read a file outside templates/"));
  <a0&&a1
};


f=testpartialtraversal():bool{
  let a0=trvsetup();
  let a1=trvrefused("a{! partial(\"../secret\") !}b";"partial(\"../secret\")");
  let a2=trvrefused("a{! partial(\"/tmp/test_ooke_12157/secret\") !}b";"partial with an absolute path");
  let a3=trvrefused("a{! partial(\"partials/../../secret\") !}b";"partial with a .. segment mid-name");
  let a4=trvrefused("a{! partial(\"\") !}b";"partial with an empty name");
  <a0&&a1&&a2&&a3&&a4
};


f=testlayouttraversal():bool{
  let a0=trvsetup();
  let a1=trvrefused("{! layout(\"../secret\") !}x";"layout(\"../secret\")");
  let a2=trvrefused("{! layout(\"/tmp/test_ooke_12157/secret\") !}x";"layout with an absolute path");
  <a0&&a1&&a2
};


f=testpartialnestedname():bool{
  let a0=trvsetup();
  let r=trvrender("a{! partial(\"partials/header\") !}b");
  let a1=chk.eqstr(r;"a<header>NESTEDOK</header>b";"a nested partial name inside templates/ still renders");
  <a0&&a1
};


f=main():i64{
  let r0=testrawpassthrough();
  let r1=testexprsimple();
  let r2=testexprmissingkey();
  let r3=testdottedkey();
  let r4=testfiltermd();
  let r5=testfilterupper();
  let r6=testfilterescape();
  let r7=testcommentignored();
  let r8=testlayoutdetected();
  let r9=testblockcollected();
  let r10=testescapehelper();
  let r11=testlexbasic();
  let r12=testrenderfilesimple();
  let r13=testcachehit();
  let r14=testpartial();
  let r15=testexprescapesbydefault();
  let r16=testfilterraw();
  let r17=testfilteruppertescapes();
  let r18=testcacheservesstored();
  let r19=testpartialtraversal();
  let r20=testlayouttraversal();
  let r21=testpartialnestedname();
  if(r0&&r1&&r2&&r3&&r4&&r5&&r6&&r7&&r8&&r9&&r10&&r11&&r12&&r13&&r14&&r15&&r16&&r17&&r18&&r19&&r20&&r21){
    <0
  }el{
    <1
  }
};
