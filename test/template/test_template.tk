m=test.template;
i=tpl:ooke.template;
i=test:std.test;
i=chk:ookeassert;
i=str:std.str;
i=file:std.file;
i=io:std.io;


f=failret(msg:str):bool{
  (test.fail(msg));
  <false
};


f=testrawpassthrough():bool{
  let src="<p>Hello, world!</p>";
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let ctx=@($str:$str);
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.eqstr(s;src;"raw text passes through unchanged")
};


f=testexprsimple():bool{
  let src="Hello, {= name =}!";
  let ctx=@("name":"World");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"World");"expr substitutes the value");
  let a1=chk.istrue(str.contains(s;"Hello");"expr keeps the surrounding text");
  <a0&&a1
};


f=testexprmissingkey():bool{
  let src="{= missingkey =}";
  let ctx=@($str:$str);
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.eqstr(s;"";"a missing key renders as empty")
};


f=testdottedkey():bool{
  let src="Site: {= site.name =}";
  let ctx=@("site.name":"toke");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.istrue(str.contains(s;"toke");"a dotted key resolves")
};


f=testfiltermd():bool{
  let src="{= body | md =}";
  let ctx=@("body":"# Hello");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.istrue(str.contains(s;"<h1");"the md filter renders markdown")
};


f=testfilterupper():bool{
  let src="{= name | upper =}";
  let ctx=@("name":"toke");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.eqstr(s;"TOKE";"the upper filter uppercases")
};


f=testfilterescape():bool{
  let src="{= text | escape =}";
  let ctx=@("text":"<script>alert(1)</script>");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"&lt;script&gt;");"the escape filter escapes");
  let a1=chk.isfalse(str.contains(s;"<script>");"the escape filter leaves no raw tag");
  <a0&&a1
};


f=testexprescapesbydefault():bool{
  let src="{= text =}";
  let ctx=@("text":"<script>alert(1)</script>");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"&lt;script&gt;");"a bare expr escapes by default");
  let a1=chk.isfalse(str.contains(s;"<script>");"a bare expr leaves no raw tag");
  <a0&&a1
};


f=testfilterraw():bool{
  let src="{= html | raw =}";
  let ctx=@("html":"<b>bold</b>");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  <chk.eqstr(s;"<b>bold</b>";"the raw filter does not escape")
};


f=testfilteruppertescapes():bool{
  let src="{= text | upper =}";
  let ctx=@("text":"<x>");
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"&lt;X&gt;");"upper escapes as well as uppercasing");
  let a1=chk.isfalse(str.contains(s;"<x>");"upper leaves no raw tag");
  <a0&&a1
};


f=testcommentignored():bool{
  let src="before{# this is a comment #}after";
  let ctx=@($str:$str);
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let s=mt out {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.isfalse(str.contains(s;"comment");"a comment is not rendered");
  let a1=chk.istrue(str.contains(s;"before");"text before a comment survives");
  let a2=chk.istrue(str.contains(s;"after");"text after a comment survives");
  <a0&&a1&&a2
};


f=testlayoutdetected():bool{
  let src="{! layout(\"base\") !}<p>child content</p>";
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let a0=chk.istrue(!(toks.len<2);"a layout template lexes to at least two tokens");
  if(a0==false){<false};
  let first=toks.get(0);
  let a1=chk.istrue(first.kind.directive;"the layout token is a directive");
  let a2=chk.istrue(str.contains(first.content;"layout");"the directive names layout");
  <a1&&a2
};


f=testblockcollected():bool{
  let src="{! block(\"title\") !}My Title{! end !}";
  let ctx=@($str:$str);
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let a0=chk.equint(toks.len;3;"a block lexes to three tokens");
  let out=tpl.tplrender(toks;ctx;"/tmp";@());
  let rendered=mt out {$ok:s true;$err:e failret(e.msg)};
  <a0&&rendered
};


f=testescapehelper():bool{
  let result=tpl.tplescape("<b>&");
  let a0=chk.istrue(str.contains(result;"&lt;b&gt;");"tplescape escapes angle brackets");
  let a1=chk.istrue(str.contains(result;"&amp;");"tplescape escapes ampersands");
  let a2=chk.isfalse(str.contains(result;"<b>");"tplescape leaves no raw tag");
  <a0&&a1&&a2
};


f=testlexbasic():bool{
  let src="<p>{= title =}</p>{# ignore #}{! block(\"x\") !}body{! end !}";
  let tokens=tpl.tpllex(src);
  let toks=mt tokens {$ok:t t;$err:e failret(e.msg)};
  let a0=chk.equint(toks.len;7;"lex token count");
  if(a0==false){<false};
  let a1=chk.istrue(toks.get(0).kind.raw;"token 0 is raw");
  let a2=chk.istrue(toks.get(1).kind.expr;"token 1 is an expr");
  let a3=chk.istrue(toks.get(3).kind.comment;"token 3 is a comment");
  let a4=chk.istrue(toks.get(4).kind.directive;"token 4 is a directive");
  <a1&&a2&&a3&&a4
};


f=testrenderfilesimple():bool{
  let tktsrc="<h1>{= heading =}</h1><p>{= body =}</p>";
  let tktpath="/tmp/test_ooke_simple.tkt";
  let writeresult=file.write(tktpath;tktsrc);
  (mt writeresult {$ok:v 0;$err:e failret("could not write temp template")});
  let ctx=@("heading":"Welcome";"body":"Hello from ooke.");
  let result=tpl.tplrenderfile(tktpath;ctx;"/tmp");
  let s=mt result {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"<h1>Welcome</h1>");"renderfile substitutes the heading");
  let a1=chk.istrue(str.contains(s;"Hello from ooke.");"renderfile substitutes the body");
  <a0&&a1
};


f=testcachehit():bool{
  let tktsrc="<p>{= msg =}</p>";
  let tktpath="/tmp/test_ooke_cache.tkt";
  let writeresult=file.write(tktpath;tktsrc);
  (mt writeresult {$ok:v 0;$err:e failret("could not write temp template")});
  let ctx=@("msg":"cached");
  let cache0=tpl.tplcachenew();
  let r1=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache0);
  let out1=mt r1 {$ok:r r.output;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(out1;"cached");"the first cached render substitutes");
  let cache1=mt r1 {$ok:r r.cache;$err:e cache0};
  let toks=tpl.tplcacheget(cache1;tktpath);
  let hasentry=mt toks {$ok:t true;$err:e false};
  let a1=chk.istrue(hasentry;"the render populated the cache");
  let r2=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache1);
  let out2=mt r2 {$ok:r r.output;$err:e failret(e.msg)};
  let a2=chk.istrue(str.contains(out2;"cached");"the cache-hit render substitutes");
  <a0&&a1&&a2
};


(* 127.226: testcachehit cannot fail on a cache that never stores —
 * tplcacheget falls back to reading the file, so "populated" held either way,
 * and that is how ooke's template cache went its whole life without caching
 * (toke lowered `cache.entries.set` as an ARRAY store, a silent no-op).  Here
 * the file changes between two renders through the same cache: only a stored
 * entry can still produce the first text.  The empty cache is the control
 * that the file really changed. *)
f=testcacheservesstored():bool{
  let tktpath="/tmp/test_ooke_cache_stored.tkt";
  let w1=file.write(tktpath;"<p>first {= msg =}</p>");
  (mt w1 {$ok:v 0;$err:e failret("could not write temp template")});
  let ctx=@("msg":"m");
  let cache0=tpl.tplcachenew();
  let r1=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache0);
  let out1=mt r1 {$ok:r r.output;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(out1;"first");"the first render reads the file");
  let cache1=mt r1 {$ok:r r.cache;$err:e cache0};
  let w2=file.write(tktpath;"<p>second {= msg =}</p>");
  (mt w2 {$ok:v 0;$err:e failret("could not rewrite temp template")});
  let r2=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache1);
  let out2=mt r2 {$ok:r r.output;$err:e failret(e.msg)};
  let a1=chk.istrue(str.contains(out2;"first");"a render through the populated cache serves the stored tokens, not the changed file");
  let r3=tpl.tplrenderfilecached(tktpath;ctx;"/tmp";cache0);
  let out3=mt r3 {$ok:r r.output;$err:e failret(e.msg)};
  let a2=chk.istrue(str.contains(out3;"second");"a render through the empty cache reads the changed file");
  <a0&&a1&&a2
};


f=testpartial():bool{
  let partialsrc="<header><a href=\"/\">Home</a></header>";
  let partialpath="/tmp/header.tkt";
  let pwrite=file.write(partialpath;partialsrc);
  (mt pwrite {$ok:v 0;$err:e failret("could not write partial")});
  let tktsrc="{! partial(\"header\") !}<main>{= content =}</main>";
  let tktpath="/tmp/test_ooke_partial.tkt";
  let twrite=file.write(tktpath;tktsrc);
  (mt twrite {$ok:v 0;$err:e failret("could not write template")});
  let ctx=@("content":"Hello from partial test.");
  let result=tpl.tplrenderfile(tktpath;ctx;"/tmp");
  let s=mt result {$ok:s s;$err:e failret(e.msg)};
  let a0=chk.istrue(str.contains(s;"<header>");"the partial is included");
  let a1=chk.istrue(str.contains(s;"Home");"the partial keeps its content");
  let a2=chk.istrue(str.contains(s;"Hello from partial test.");"the host template still renders");
  <a0&&a1&&a2
};


(* 121.57: a partial or layout name resolves only inside the templates
 * directory.  The fixture puts secret.tkt one level ABOVE templates/, so a
 * name that escapes can read it; the nested partials/header.tkt is the
 * legitimate control that must keep working. *)
f=trvsetup():bool{
  let root="/tmp/test_ooke_12157";
  (mt file.mkdir(root) {$ok:v 0;$err:e 0});
  (mt file.mkdir("/tmp/test_ooke_12157/templates") {$ok:v 0;$err:e 0});
  (mt file.mkdir("/tmp/test_ooke_12157/templates/partials") {$ok:v 0;$err:e 0});
  let w0=file.write("/tmp/test_ooke_12157/secret.tkt";"TOPSECRET");
  let a0=mt w0 {$ok:v true;$err:e failret("could not write secret.tkt")};
  let w1=file.write("/tmp/test_ooke_12157/templates/partials/header.tkt";"<header>NESTEDOK</header>");
  let a1=mt w1 {$ok:v true;$err:e failret("could not write partials/header.tkt")};
  <a0&&a1
};


f=trvrender(src:$str):$str{
  let toks=mt tpl.tpllex(src) {$ok:t t;$err:e @()};
  let out=tpl.tplrender(toks;@($str:$str);"/tmp/test_ooke_12157/templates";@());
  <mt out {$ok:s s;$err:e "<<REFUSED>>"}
};


f=trvrefused(src:$str;what:$str):bool{
  let r=trvrender(src);
  let refused=r=="<<REFUSED>>";
  let leaked=str.contains(r;"TOPSECRET");
  let a0=chk.istrue(refused;str.concat(what;" is refused with an error"));
  let a1=chk.isfalse(leaked;str.concat(what;" does not read a file outside templates/"));
  <a0&&a1
};


f=testpartialtraversal():bool{
  let a0=trvsetup();
  let a1=trvrefused("a{! partial(\"../secret\") !}b";"partial(\"../secret\")");
  let a2=trvrefused("a{! partial(\"/tmp/test_ooke_12157/secret\") !}b";"partial with an absolute path");
  let a3=trvrefused("a{! partial(\"partials/../../secret\") !}b";"partial with a .. segment mid-name");
  let a4=trvrefused("a{! partial(\"\") !}b";"partial with an empty name");
  <a0&&a1&&a2&&a3&&a4
};


f=testlayouttraversal():bool{
  let a0=trvsetup();
  let a1=trvrefused("{! layout(\"../secret\") !}x";"layout(\"../secret\")");
  let a2=trvrefused("{! layout(\"/tmp/test_ooke_12157/secret\") !}x";"layout with an absolute path");
  <a0&&a1&&a2
};


f=testpartialnestedname():bool{
  let a0=trvsetup();
  let r=trvrender("a{! partial(\"partials/header\") !}b");
  let a1=chk.eqstr(r;"a<header>NESTEDOK</header>b";"a nested partial name inside templates/ still renders");
  <a0&&a1
};


(* 121.58: {= x =} is escaped for the HTML context it lands in (toke's
 * template.c context tracker, 121.37, ported to ooke).  Before this, every
 * value went through one HTML-body escaper, so href took javascript:,
 * an on* handler decoded &#39; back into a quote before running, and a
 * value inside <script> became code. *)
f=cxr(src:$str;val:$str):$str{
  let toks=mt tpl.tpllex(src) {$ok:t t;$err:e @()};
  let out=tpl.tplrender(toks;@("x":val);"/tmp";@());
  <mt out {$ok:s s;$err:e "<<ERR>>"}
};


f=cxeq(src:$str;val:$str;want:$str;what:$str):bool{
  <chk.eqstr(cxr(src;val);want;what)
};


f=testctxurl():bool{
  let a0=cxeq("<a href=\"{= x =}\">l</a>";"javascript:alert(1)";"<a href=\"#ZtokeZ\">l</a>";"href refuses a javascript: URL");
  let a1=cxeq("<a href=\"{= x =}\">l</a>";" JavaScript:alert(1)";"<a href=\"#ZtokeZ\">l</a>";"href refuses a javascript: URL behind space and mixed case");
  let a2=cxeq("<img src={= x =}>";"data:text/html,x";"<img src=&#35;ZtokeZ>";"unquoted src refuses a data: URL");
  let a3=cxeq("<a href=\"{= x =}\">l</a>";"https://example.com/a?b=c&d=e";"<a href=\"https://example.com/a?b=c&amp;d=e\">l</a>";"href keeps an https URL");
  let a4=cxeq("<a href=\"{= x =}\">l</a>";"mailto:a@example.com";"<a href=\"mailto:a@example.com\">l</a>";"href keeps a mailto URL");
  let a5=cxeq("<a href=\"{= x =}\">l</a>";"/blog/post one";"<a href=\"/blog/post%20one\">l</a>";"href keeps a relative path and percent-encodes a space");
  let a6=cxeq("<a href=\"/s?q={= x =}\">l</a>";"a&b=c#d";"<a href=\"/s?q=a%26b%3Dc%23d\">l</a>";"after ? the value is a query component");
  let a7=cxeq("<a href=\"/p/{= x =}\">l</a>";"javascript:x";"<a href=\"/p/javascript:x\">l</a>";"mid-URL the scheme rule does not apply");
  let a8=cxeq("<form action=\"{= x =}\">";"vbscript:x";"<form action=\"#ZtokeZ\">";"action is a URL attribute too");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7&&a8
};


f=testctxjs():bool{
  let a0=cxeq("<script>var s={= x =};</script>";"1;alert(1)";"<script>var s=\"1\\u003Balert\\u00281\\u0029\";</script>";"in script code the value is a quoted string literal");
  let a1=cxeq("<script>var s='{= x =}';</script>";"';alert(1)//";"<script>var s='\\u0027\\u003Balert\\u00281\\u0029\\u002F\\u002F';</script>";"in a script string the value cannot close the string");
  let a2=cxeq("<script>var s=\"{= x =}\";</script>";"</script><b>";"<script>var s=\"\\u003C\\u002Fscript\\u003E\\u003Cb\\u003E\";</script>";"a value cannot close the script element");
  let a3=cxeq("<button onclick=\"f('{= x =}')\">b</button>";"');alert(1)//";"<button onclick=\"f('\\u0027\\u0029\\u003Balert\\u00281\\u0029\\u002F\\u002F')\">b</button>";"in an on* string the value is JS-escaped, not entity-escaped");
  let a4=cxeq("<button onclick=\"f({= x =})\">b</button>";"a";"<button onclick=\"f(&quot;a&quot;)\">b</button>";"in on* code the value is a quoted literal, then attribute-escaped");
  let a5=cxeq("<script>// {= x =}\n</script>";"a\nalert(1)";"<script>// a\\u000Aalert\\u00281\\u0029\n</script>";"in a JS line comment a newline cannot escape the comment");
  let a6=cxeq("<script>var s=\"{= x =}\";</script>";"a\xE2\x80\xA8b";"<script>var s=\"a\\u2028b\";</script>";"U+2028 is escaped in a JS string");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6
};


f=testctxcss():bool{
  let a0=cxeq("<div style=\"color:{= x =}\">d</div>";"red;background:url(x)";"<div style=\"color:ZtokeZ\">d</div>";"style code refuses a value that is not a plain value");
  let a1=cxeq("<div style=\"color:{= x =}\">d</div>";"#ff0000";"<div style=\"color:#ff0000\">d</div>";"style code keeps a plain value");
  let a2=cxeq("<style>p{font-family:\"{= x =}\"}</style>";"a\"}*{x:y";"<style>p{font-family:\"a\\22 \\7D \\2A \\7B x\\3A y\"}</style>";"a CSS string value is \\HH-escaped");
  <a0&&a1&&a2
};


f=testctxattr():bool{
  let a0=cxeq("<div class={= x =}>d</div>";"a onmouseover=alert(1)";"<div class=a&#32;onmouseover&#61;alert&#40;1&#41;>d</div>";"an unquoted attribute value cannot add an attribute");
  let a1=cxeq("<div title=\"{= x =}\">d</div>";"\"><script>";"<div title=\"&quot;&gt;&lt;script&gt;\">d</div>";"a quoted attribute value is entity-escaped");
  let a2=cxeq("<div {= x =}=\"1\">d</div>";"onclick";"<div ZtokeZ=\"1\">d</div>";"an attribute-name value cannot name an event handler");
  let a3=cxeq("<div {= x =}=\"1\">d</div>";"data-id";"<div data-id=\"1\">d</div>";"an attribute-name value can name a plain attribute");
  let a4=cxeq("<title>{= x =}</title>";"</title><script>";"<title>&lt;/title&gt;&lt;script&gt;</title>";"title content is entity-escaped");
  let a5=cxeq("<!-- {= x =} --><p>{= x =}</p>";"-->";"<!-- --&gt; --><p>--&gt;</p>";"a comment value cannot close the comment");
  let a6=cxeq("<script>{= x | raw =}</script>";"alert(1)";"<script>alert(1)</script>";"|raw still writes the value unchanged");
  let a7=cxeq("<p>{= x | upper =}</p><a href=\"{= x | upper =}\">l</a>";"javascript:x";"<p>JAVASCRIPT:X</p><a href=\"#ZtokeZ\">l</a>";"filters are context-escaped too");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7
};


(* A value reached through a partial or a layout's yield is escaped for the
 * place it lands in the final page, not for where its template began. *)
f=testctxcomposed():bool{
  let w0=file.write("/tmp/test_ooke_12158_p.tkt";"{= x =}");
  let a0=mt w0 {$ok:v true;$err:e failret("could not write partial")};
  let w1=file.write("/tmp/test_ooke_12158_l.tkt";"<script>var t={! yield(\"v\") !};</script>");
  let a1=mt w1 {$ok:v true;$err:e failret("could not write layout")};
  let a2=cxeq("<script>var p={! partial(\"test_ooke_12158_p\") !};</script>";"1;alert(1)";"<script>var p=\"1\\u003Balert\\u00281\\u0029\";</script>";"a value in a partial is escaped for the script it lands in");
  let a3=cxeq("{! layout(\"test_ooke_12158_l\") !}{! block(\"v\") !}{= x =}{! end !}";"1;alert(1)";"<script>var t=\"1\\u003Balert\\u00281\\u0029\";</script>";"a value in a block is escaped for where the layout yields it");
  <a0&&a1&&a2&&a3
};


(* A partial that includes itself is refused with an error once nesting
 * passes 32 levels; before 121.58 it recursed until the stack ran out. *)
f=testpartialselfinclude():bool{
  let w0=file.write("/tmp/test_ooke_12158_self.tkt";"x{! partial(\"test_ooke_12158_self\") !}");
  let a0=mt w0 {$ok:v true;$err:e failret("could not write partial")};
  let a1=chk.eqstr(cxr("{! partial(\"test_ooke_12158_self\") !}";"");"<<ERR>>";"a self-including partial is refused with an error");
  <a0&&a1
};


(* 121.59: a missing partial is an error, as a missing layout already was.
 * It used to render as nothing, with no error and no log.  An EMPTY partial
 * file is not missing and still renders as nothing (the negative control). *)
f=testpartialmissing():bool{
  let a0=trvsetup();
  let w0=file.write("/tmp/test_ooke_12157/templates/partials/empty.tkt";"");
  let a1=mt w0 {$ok:v true;$err:e failret("could not write partials/empty.tkt")};
  let a2=chk.eqstr(trvrender("a{! partial(\"nosuch\") !}b");"<<REFUSED>>";"a missing partial is an error, not an empty string");
  let a3=chk.eqstr(trvrender("a{! partial(\"partials/nosuch\") !}b");"<<REFUSED>>";"a missing nested partial is an error");
  let a4=chk.eqstr(trvrender("a{! partial(\"partials/empty\") !}b");"ab";"an empty partial file still renders as nothing");
  let a5=chk.eqstr(trvrender("{! layout(\"nosuch\") !}x");"<<REFUSED>>";"a missing layout is an error (unchanged)");
  <a0&&a1&&a2&&a3&&a4&&a5
};


(* 121.63: the cached render path fails -- and logs -- exactly as
 * tplrenderfile does since 121.59, for a missing file and for one that exists
 * but cannot be read. The log lines are checked from this binary's stderr by
 * test/template/cached_log.sh, which also makes the unreadable fixtures:
 * linkrender.tkt and linkget.tkt, symlinks (std.file does not follow a final
 * symlink, AMB-07). toke has no symlink call, so without them (a plain
 * test/run_tests.sh run) those two cases are skipped, and say so. A directory
 * is not used: std.file reads one as an empty string. Each case has its own
 * path, so a log line names the function that wrote it. Negative control: a
 * readable template renders through both, and a cache hit serves the cached
 * tokens without the file. *)
f=testcachedmissing():bool{
  let root="/tmp/test_ooke_12163";
  (mt file.mkdir(root) {$ok:v 0;$err:e 0});
  let w0=file.write("/tmp/test_ooke_12163/good.tkt";"<p>CACHEDGOOD</p>");
  let a0=mt w0 {$ok:v true;$err:e failret("could not write good.tkt")};
  let c0=tpl.tplcachenew();
  let e1=tpl.tplrenderfilecached("/tmp/test_ooke_12163/nosuchrender.tkt";@($str:$str);root;c0);
  let a1=chk.istrue(mt e1 {$ok:v false;$err:e true};"tplrenderfilecached: a missing file is an error");
  let e3=tpl.tplcacheget(c0;"/tmp/test_ooke_12163/nosuchget.tkt");
  let a3=chk.istrue(mt e3 {$ok:t false;$err:e true};"tplcacheget: a missing file is an error");
  let haslinks=file.exists("/tmp/test_ooke_12163/linkrender.tkt")&&file.exists("/tmp/test_ooke_12163/linkget.tkt");
  let a2=mut.true;
  let a4=mut.true;
  if(haslinks){
    let e2=tpl.tplrenderfilecached("/tmp/test_ooke_12163/linkrender.tkt";@($str:$str);root;c0);
    a2=chk.istrue(mt e2 {$ok:v false;$err:e true};"tplrenderfilecached: an unreadable file is an error");
    let e4=tpl.tplcacheget(c0;"/tmp/test_ooke_12163/linkget.tkt");
    a4=chk.istrue(mt e4 {$ok:t false;$err:e true};"tplcacheget: an unreadable file is an error")
  }el{
    (io.println("SKIP 121.63 unreadable-file cases: no symlink fixtures (test/template/cached_log.sh makes them)"))
  };
  let r1=tpl.tplrenderfilecached("/tmp/test_ooke_12163/good.tkt";@($str:$str);root;c0);
  let a5=chk.eqstr(mt r1 {$ok:v v.output;$err:e "<<ERR>>"};"<p>CACHEDGOOD</p>";"control: a readable template renders through the cache");
  let c1=mt r1 {$ok:v v.cache;$err:e c0};
  (* delete the file: a hit must come from the cache, not the disk *)
  (mt file.delete("/tmp/test_ooke_12163/good.tkt") {$ok:v 0;$err:e 0});
  let r2=tpl.tplrenderfilecached("/tmp/test_ooke_12163/good.tkt";@($str:$str);root;c1);
  let a6=chk.eqstr(mt r2 {$ok:v v.output;$err:e "<<ERR>>"};"<p>CACHEDGOOD</p>";"control: a cache hit renders without the file");
  let r3=tpl.tplcacheget(c1;"/tmp/test_ooke_12163/good.tkt");
  let a7=chk.istrue(mt r3 {$ok:t true;$err:e false};"control: tplcacheget serves a cached entry");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7
};


(* 138.29 (loke O-4): an unknown directive, a stray `end` and a block still
 * open at the end of the template each rendered as $ok -- the directive or the
 * block's content silently dropped, nothing logged. Each is now a $tplerr,
 * logged where it is raised (the log lines are checked by
 * test/template/directive_log.sh). The fixtures live in the 121.57 directory;
 * z112base.tkt is a two-block layout. Controls: closed blocks under a layout,
 * and every known directive, still render. *)
f=dirsetup():bool{
  let a0=trvsetup();
  let w0=file.write("/tmp/test_ooke_12157/templates/z112base.tkt";"<title>{! yield(\"title\") !}</title><main>{! yield(\"body\") !}</main>");
  let a1=mt w0 {$ok:v true;$err:e failret("could not write z112base.tkt")};
  <a0&&a1
};


f=dirrender(src:$str):$str{
  let toks=mt tpl.tpllex(src) {$ok:t t;$err:e @()};
  let out=tpl.tplrender(toks;@("k":"v");"/tmp/test_ooke_12157/templates";@());
  <mt out {$ok:s s;$err:e "<<ERR>>"}
};


f=testdirectiveunknown():bool{
  let a0=dirsetup();
  let a1=chk.eqstr(dirrender("A{! frobnicate(\"x\") !}B");"<<ERR>>";"an unknown directive with an argument is an error (O-4 unknown.tkt)");
  let a2=chk.eqstr(dirrender("A{! z112nosuchdir !}B");"<<ERR>>";"a bare unknown directive is an error");
  let a3=chk.eqstr(dirrender("{! layout(\"z112base\") !}{! block(\"body\") !}X{! end !}{! z112afterblock !}");"<<ERR>>";"an unknown directive after a closed block, under a layout, is an error (Z108 unknownbare.tkt)");
  let a4=chk.eqstr(dirrender("{! block(\"unyielded\") !}x{! z112inblock !}{! end !}y");"<<ERR>>";"an unknown directive inside a block no layout yields is an error");
  let a5=chk.eqstr(dirrender("{! layout(\"z112base\") !}{! block(\"title\") !}T1{! end !}{! block(\"body\") !}BODY{! endblock !}");"<<ERR>>";"{! endblock !} is an unknown directive, an error (O-4 endblock.tkt)");
  <a0&&a1&&a2&&a3&&a4&&a5
};


f=testdirectivestrayend():bool{
