  let a1=chk.eqstr(dirrender("A{! end !}B");"<<ERR>>";"an end with no open block is an error (Z108 strayend.tkt)");
  let a2=chk.eqstr(dirrender("{! block(\"t\") !}x{! end !}{! end !}");"<<ERR>>";"a doubled end is an error");
  <a0&&a1&&a2
};


f=testdirectiveunclosed():bool{
  let a0=dirsetup();
  let a1=chk.eqstr(dirrender("{! layout(\"z112base\") !}{! block(\"title\") !}T1{! end !}{! block(\"body\") !}BODY");"<<ERR>>";"a block open at the end of a template is an error (O-4 unclosed.tkt)");
  let a2=chk.eqstr(dirrender("A{! block(\"t\") !}B");"<<ERR>>";"a block open at the end of a template with no layout is an error");
  <a0&&a1&&a2
};


f=testdirectivecontrols():bool{
  let a0=dirsetup();
  let w0=file.write("/tmp/test_ooke_12157/templates/z112part.tkt";"[P]");
  let a1=mt w0 {$ok:v true;$err:e failret("could not write z112part.tkt")};
  let a2=chk.eqstr(dirrender("{! layout(\"z112base\") !}{! block(\"title\") !}T1{! end !}{! block(\"body\") !}BODY{! end !}");"<title>T1</title><main>BODY</main>";"control: closed blocks under a layout render (O-4 control.tkt)");
  let a3=chk.eqstr(dirrender("A{! var(\"k\") !}B");"AvB";"control: var renders");
  let a4=chk.eqstr(dirrender("A{! partial(\"z112part\") !}B");"A[P]B";"control: partial renders");
  let a5=chk.eqstr(dirrender("A{! island(\"w\") !}B");"A<div data-island=\"w\" data-hydrate=\"load\"></div>B<script src=\"/static/ooke-islands.js\" defer></script>";"control: island renders");
  let a6=chk.eqstr(dirrender("A{! block(\"t\") !}x{! end !}B");"AB";"control: a closed block with no layout renders as before");
  let a7=chk.eqstr(dirrender("A{! yield(\"none\") !}B");"AB";"control: yield of a block nobody defined renders nothing, as before");
  let a8=chk.eqstr(dirrender("A{= k =}B{# c #}C");"AvBC";"control: expressions and comments are unaffected");
  <a0&&a1&&a2&&a3&&a4&&a5&&a6&&a7&&a8
};


