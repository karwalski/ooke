m=test.validate;
i=validate:ooke.validate;
i=chk:ookeassert;
i=file:std.file;

f=writemodel():bool{
  let src="name = \"post\"\n\n[fields]\nlist = \"title, views, published\"\n\n[fields.title]\ntype = \"str\"\nrequired = true\n\n[fields.views]\ntype = \"int\"\nrequired = false\n\n[fields.published]\ntype = \"bool\"\nrequired = false\n";
  let ok=mt file.write("/tmp/test_validate_post.toml";src) {$ok:v true;$err:e false};
  <ok
};

f=testloadmodel():bool{
  if(writemodel()==false){<false};
  let r=validate.validateloadmodel("/tmp/";"test_validate_post");
  let ok=mt r {$ok:v true;$err:e false};
  if(ok==false){<false};
  let m=mt r {$ok:v v;$err:e validate.validateempty() as $modeldef};
  let a0=chk.eqstr(m.name;"post";"model name");
  let a1=chk.equint(m.fields.len;3;"model field count");
  if(a1==false){<false};
  let a2=chk.eqstr(m.fields.get(0).name;"title";"field 0 name");
  let a3=chk.eqstr(m.fields.get(0).fieldtype;"str";"field 0 type");
  let a4=chk.istrue(m.fields.get(0).required;"field 0 required");
  let a5=chk.eqstr(m.fields.get(1).name;"views";"field 1 name");
  let a6=chk.eqstr(m.fields.get(1).fieldtype;"int";"field 1 type");
  let a7=chk.isfalse(m.fields.get(1).required;"field 1 required");
  let a8=chk.eqstr(m.fields.get(2).fieldtype;"bool";"field 2 type");
  <a0&&a2&&a3&&a4&&a5&&a6&&a7&&a8
};

f=testloadmodelmissing():bool{
  let r=validate.validateloadmodel("/nonexistent/";"nope");
  let iserr=mt r {$ok:v false;$err:e true};
  <iserr
};

f=testcontentvalid():bool{
  if(writemodel()==false){<false};
  let r=validate.validateloadmodel("/tmp/";"test_validate_post");
  let model=mt r {$ok:v v;$err:e validate.validateempty() as $modeldef};
  let meta=mut.@($str:$str);
  meta=meta.set("title";"Hello");
  meta=meta.set("views";"42");
  meta=meta.set("published";"true");
  let res=validate.validatecontent(model;meta;"posts/hello.md");
  let a0=chk.equint(res.errors.len;0;"valid content has no errors");
  let a1=chk.equint(res.warnings.len;0;"valid content has no warnings");
  <a0&&a1
};

f=testcontentmissingrequired():bool{
  if(writemodel()==false){<false};
  let r=validate.validateloadmodel("/tmp/";"test_validate_post");
  let model=mt r {$ok:v v;$err:e validate.validateempty() as $modeldef};
  let meta=mut.@($str:$str);
  meta=meta.set("views";"7");
  let res=validate.validatecontent(model;meta;"posts/bad.md");
  let a0=chk.equint(res.errors.len;1;"missing required field error count");
  if(a0==false){<false};
  <chk.eqstr(res.errors.get(0).field;"title";"missing required field name")
};

f=testcontentbadint():bool{
  if(writemodel()==false){<false};
  let r=validate.validateloadmodel("/tmp/";"test_validate_post");
  let model=mt r {$ok:v v;$err:e validate.validateempty() as $modeldef};
  let meta=mut.@($str:$str);
  meta=meta.set("title";"Hi");
  meta=meta.set("views";"notanumber");
  let res=validate.validatecontent(model;meta;"posts/badint.md");
  let a0=chk.equint(res.errors.len;1;"bad int error count");
  if(a0==false){<false};
  <chk.eqstr(res.errors.get(0).field;"views";"bad int field name")
};

f=testcontentbadbool():bool{
  if(writemodel()==false){<false};
  let r=validate.validateloadmodel("/tmp/";"test_validate_post");
  let model=mt r {$ok:v v;$err:e validate.validateempty() as $modeldef};
  let meta=mut.@($str:$str);
  meta=meta.set("title";"Hi");
  meta=meta.set("published";"maybe");
  let res=validate.validatecontent(model;meta;"posts/badbool.md");
  let a0=chk.equint(res.errors.len;1;"bad bool error count");
  if(a0==false){<false};
  <chk.eqstr(res.errors.get(0).field;"published";"bad bool field name")
};

f=testempty():bool{
  let res=validate.validateempty();
  let a0=chk.equint(res.errors.len;0;"empty result has no errors");
  let a1=chk.equint(res.warnings.len;0;"empty result has no warnings");
  <a0&&a1
};

f=testmerge():bool{
  let a=mut.validate.validateempty();
  let ae=mut.a.errors;
  ae=ae.append($valerror{filepath:"a.md";field:"x";msg:"err a"});
  a=$valresult{errors:ae;warnings:a.warnings};
  let b=mut.validate.validateempty();
  let be=mut.b.errors;
  be=be.append($valerror{filepath:"b.md";field:"y";msg:"err b"});
  b=$valresult{errors:be;warnings:b.warnings};
  let merged=validate.validatemerge(a;b);
  let a0=chk.equint(merged.errors.len;2;"merge error count");
  if(a0==false){<false};
  let a1=chk.eqstr(merged.errors.get(0).field;"x";"merge keeps the left error first");
  let a2=chk.eqstr(merged.errors.get(1).field;"y";"merge appends the right error");
  <a1&&a2
};

f=testlogresult():bool{
  let res=validate.validateempty();
  <chk.eqint(validate.validatelogresult(res);0;"validatelogresult on an empty result")
};

f=main():i64{
  let r0=testloadmodel();
  let r1=testloadmodelmissing();
  let r2=testcontentvalid();
  let r3=testcontentmissingrequired();
  let r4=testcontentbadint();
  let r5=testcontentbadbool();
  let r6=testempty();
  let r7=testmerge();
  let r8=testlogresult();
  if(r0&&r1&&r2&&r3&&r4&&r5&&r6&&r7&&r8){
    <0
  }el{
    <1
  }
};
